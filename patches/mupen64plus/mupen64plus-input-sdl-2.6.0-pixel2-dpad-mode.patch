diff --git a/src/plugin.c b/src/plugin.c
index 974b1db..cad1fa2 100644
--- a/src/plugin.c
+++ b/src/plugin.c
@@ -88,6 +88,20 @@ static int l_PluginInit = 0;
 static int l_joyWasInit = 0;
 static int l_hapticWasInit = 0;
 
+#if SDL_VERSION_ATLEAST(2,0,0)
+static int pixel2_function_raw_down[4] = {0, 0, 0, 0};
+static int pixel2_function_gesture[4] = {0, 0, 0, 0};
+static int pixel2_toggle_pending[4] = {0, 0, 0, 0};
+static Uint32 pixel2_function_released_at[4] = {0, 0, 0, 0};
+static int pixel2_dpad_mode[4] = {0, 0, 0, 0};
+
+static int is_pixel2_joypad(SDL_Joystick *joystick)
+{
+    const char *name = joystick ? SDL_JoystickName(joystick) : NULL;
+    return name != NULL && strcmp(name, "pixel2_joypad") == 0;
+}
+#endif
+
 static unsigned short button_bits[] = {
     0x0001,  // R_DPAD
     0x0002,  // L_DPAD
@@ -612,6 +626,58 @@ EXPORT void CALL GetKeys( int Control, BUTTONS *Keys )
         if (iY >  80) iY =  80;
         controller[Control].buttons.X_AXIS = iX;
         controller[Control].buttons.Y_AXIS = iY;
+
+#if SDL_VERSION_ATLEAST(2,0,0)
+        /*
+         * Pixel2 has a digital D-pad but no analog stick.  The normal mapping
+         * exposes that D-pad as the N64 analog stick.  A short Function press
+         * toggles a reversible N64 D-pad layer; the external hotkey helper
+         * reserves a long Function press for safe exit.
+         */
+        if (is_pixel2_joypad(controller[Control].joystick))
+        {
+            int function_down = SDL_JoystickGetButton(
+                controller[Control].joystick, 14);
+            Uint32 now = SDL_GetTicks();
+
+            if (function_down)
+            {
+                pixel2_function_gesture[Control] = 1;
+                pixel2_toggle_pending[Control] = 0;
+            }
+            else if (pixel2_function_raw_down[Control] &&
+                     pixel2_function_gesture[Control])
+            {
+                pixel2_toggle_pending[Control] = 1;
+                pixel2_function_released_at[Control] = now;
+            }
+            if (!function_down && pixel2_toggle_pending[Control] &&
+                now - pixel2_function_released_at[Control] >= 200)
+            {
+                pixel2_toggle_pending[Control] = 0;
+                pixel2_function_gesture[Control] = 0;
+                pixel2_dpad_mode[Control] = !pixel2_dpad_mode[Control];
+                DebugMessage(M64MSG_INFO,
+                    "Pixel2 D-pad mode: %s",
+                    pixel2_dpad_mode[Control] ? "N64 D-pad" : "analog stick");
+            }
+            pixel2_function_raw_down[Control] = function_down;
+
+            if (pixel2_dpad_mode[Control])
+            {
+                controller[Control].buttons.X_AXIS = 0;
+                controller[Control].buttons.Y_AXIS = 0;
+                if (SDL_JoystickGetButton(controller[Control].joystick, 13))
+                    controller[Control].buttons.Value |= button_bits[R_DPAD];
+                if (SDL_JoystickGetButton(controller[Control].joystick, 12))
+                    controller[Control].buttons.Value |= button_bits[L_DPAD];
+                if (SDL_JoystickGetButton(controller[Control].joystick, 11))
+                    controller[Control].buttons.Value |= button_bits[D_DPAD];
+                if (SDL_JoystickGetButton(controller[Control].joystick, 10))
+                    controller[Control].buttons.Value |= button_bits[U_DPAD];
+            }
+        }
+#endif
     }
 
     // process mouse events
