diff --git a/sdl2/src/video/nds/nds_debug_compat.c b/sdl2/src/video/nds/nds_debug_compat.c
new file mode 100644
index 0000000..ab550ec
--- /dev/null
+++ b/sdl2/src/video/nds/nds_debug_compat.c
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: LGPL-2.1
+// Minimal plumOS Pixel2 shim for DraStic's SDL2 NDS video backend.
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "common.h"
+
+int nds_debug_level = FATAL_LEVEL;
+
+int update_debug_level(int new_level)
+{
+    const char *level;
+
+    if (new_level >= FATAL_LEVEL && new_level <= TRACE_LEVEL) {
+        nds_debug_level = new_level;
+        return 0;
+    }
+
+    level = getenv("NDS_DEBUG_LEVEL");
+    if (!level) {
+        nds_debug_level = FATAL_LEVEL;
+        return 0;
+    }
+
+    if (!strcmp(level, "TRACE")) {
+        nds_debug_level = TRACE_LEVEL;
+    }
+    else if (!strcmp(level, "DEBUG")) {
+        nds_debug_level = DEBUG_LEVEL;
+    }
+    else if (!strcmp(level, "FATAL")) {
+        nds_debug_level = FATAL_LEVEL;
+    }
+    else {
+        nds_debug_level = ERROR_LEVEL;
+    }
+
+    return 0;
+}
