+		if (deviceName && !strcmp(deviceName, "pixel2_joypad")) {
+			const std::string mapping = std::string(pszGUID) +
+				",pixel2_joypad,a:b1,b:b0,x:b2,y:b3,back:b8,guide:b14,start:b9,"
