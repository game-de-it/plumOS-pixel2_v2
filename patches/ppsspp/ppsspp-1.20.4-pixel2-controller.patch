 void SDLJoystick::setUpController(int deviceIndex) {
 	static constexpr int cbGUID = 33;
-	char pszGUID[cbGUID];
+	char pszGUID[cbGUID] = {};
+
+	// Pixel2 exposes a compact 15-button joystick without an SDL database
