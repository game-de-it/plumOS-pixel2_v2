+				"leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,platform:Linux,";
+			const int result = SDL_GameControllerAddMapping(mapping.c_str());
+			if (result >= 0) {
+				INFO_LOG(Log::System, "Installed Pixel2 controller mapping: %s", mapping.c_str());
+			} else {
+				ERROR_LOG(Log::System, "Failed to install Pixel2 controller mapping: %s", SDL_GetError());
+			}
+		}
+		SDL_JoystickClose(pixel2Joystick);
+	}
 
