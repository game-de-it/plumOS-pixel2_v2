+static void drm_surface_map_rotated_pixel(const struct drm_surface *surface,
+      unsigned int dst_x, unsigned int dst_y,
+      unsigned int *logical_x, unsigned int *logical_y)
+{
+   unsigned int lw = (unsigned int)surface->logical_width;
+   unsigned int lh = (unsigned int)surface->logical_height;
+
+   if (!lw)
+      lw = 1;
+   if (!lh)
+      lh = 1;
+
+   switch (surface->rotation & 3)
+   {
+      case 1:
+         *logical_x = dst_y;
+         *logical_y = lh - 1 - dst_x;
+         break;
+      case 2:
+         *logical_x = lw - 1 - dst_x;
+         *logical_y = lh - 1 - dst_y;
+         break;
+      case 3:
+         *logical_x = lw - 1 - dst_y;
+         *logical_y = dst_x;
+         break;
+      default:
+         *logical_x = dst_x;
+         *logical_y = dst_y;
+         break;
+   }
+
+   if (*logical_x >= lw)
+      *logical_x = lw - 1;
+   if (*logical_y >= lh)
+      *logical_y = lh - 1;
+}
