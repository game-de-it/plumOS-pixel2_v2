+static float drm_pixel2_core_aspect(float aspect,
+      unsigned aspect_ratio_idx, unsigned rotation)
+{
+   /* RetroArch converts core-provided aspect into final display coordinates
+    * using the configured video rotation. Pixel2's plain DRM path already
+    * performs that fixed panel rotation after it calculates the logical
+    * landscape viewport, so applying both conversions inverts dynamic core
+    * geometry (notably WonderSwan 224x144 -> 144x224). */
+   if (aspect_ratio_idx == ASPECT_RATIO_CORE && (rotation & 1) && aspect > 0.0f)
+      return 1.0f / aspect;
+   return aspect;
+}
