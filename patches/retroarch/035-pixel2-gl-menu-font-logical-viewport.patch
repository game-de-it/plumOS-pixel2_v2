diff --git a/gfx/drivers/gl2.c b/gfx/drivers/gl2.c
--- a/gfx/drivers/gl2.c
+++ b/gfx/drivers/gl2.c
@@ -397,12 +397,18 @@ static void gl2_rotate_menu_rect(float logical_height,
 
 static unsigned gl2_menu_font_width(gl2_t *gl)
 {
-   return gl2_menu_display_rotation() ? gl->vp.height : gl->vp.width;
+   /* gl->vp is already the graphical menu's logical 640x480 viewport.
