+static void drm_set_osd_msg(void *data, const char *msg,
+      const struct font_params *params, void *font)
+{
+   struct drm_video *vid = data;
+
+   if (!vid || !msg || !*msg)
+      return;
+
+   strlcpy(vid->pending_osd_msg, msg, sizeof(vid->pending_osd_msg));
+   if (params)
+      vid->pending_osd_params = *params;
+   else
+      memset(&vid->pending_osd_params, 0, sizeof(vid->pending_osd_params));
+   vid->pending_osd_msg_valid = params != NULL;
+}
