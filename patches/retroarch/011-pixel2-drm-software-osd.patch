+static void drm_blend_osd_pixel(struct drm_surface *surface,
+      uint8_t *dst_base, int x, int y,
+      unsigned red, unsigned green, unsigned blue, unsigned alpha)
+{
+   if (x < 0 || y < 0 || x >= surface->src_width || y >= surface->src_height)
+      return;
+
+   if (surface->bpp == 2)
+   {
+      uint16_t *dst = (uint16_t *)(dst_base +
+            y * surface->pages[surface->flip_page].buf.stride) + x;
+      unsigned dst_red   = ((*dst >> 11) & 0x1f) * 255 / 31;
+      unsigned dst_green = ((*dst >>  5) & 0x3f) * 255 / 63;
+      unsigned dst_blue  = ( *dst        & 0x1f) * 255 / 31;
+
+      red   = (red   * alpha + dst_red   * (255 - alpha)) / 255;
+      green = (green * alpha + dst_green * (255 - alpha)) / 255;
+      blue  = (blue  * alpha + dst_blue  * (255 - alpha)) / 255;
+      *dst  = (uint16_t)(((red * 31 / 255) << 11) |
+            ((green * 63 / 255) << 5) | (blue * 31 / 255));
+   }
+   else
+   {
+      uint32_t *dst = (uint32_t *)(dst_base +
+            y * surface->pages[surface->flip_page].buf.stride) + x;
+      unsigned dst_red   = (*dst >> 16) & 0xff;
+      unsigned dst_green = (*dst >>  8) & 0xff;
+      unsigned dst_blue  =  *dst        & 0xff;
+
+      red   = (red   * alpha + dst_red   * (255 - alpha)) / 255;
+      green = (green * alpha + dst_green * (255 - alpha)) / 255;
+      blue  = (blue  * alpha + dst_blue  * (255 - alpha)) / 255;
+      *dst  = (red << 16) | (green << 8) | blue;
+   }
+}
