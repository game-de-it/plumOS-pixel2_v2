+static void drm_render_osd_msg(struct drm_video *vid,
+      struct drm_surface *surface, uint8_t *dst_base,
+      const char *msg, const struct font_params *params)
+{
+   const struct font_atlas *atlas;
+   settings_t *settings = config_get_ptr();
+   float scale = 1.0f;
+   int start_x;
+   int pen_x;
+   int pen_y;
+   unsigned red;
+   unsigned green;
+   unsigned blue;
+   unsigned color_alpha = 255;
+
+   if (!vid->font_driver || !vid->font_data || !msg || !*msg)
+      return;
+
+   atlas = vid->font_driver->get_atlas(vid->font_data);
+   if (!atlas || !atlas->buffer)
+      return;
+
+   if (params)
+   {
+      start_x     = (int)(params->x * surface->src_width);
+      pen_y       = (int)((1.0f - params->y) * surface->src_height);
+      scale       = params->scale > 0.0f ? params->scale : 1.0f;
+      red         = FONT_COLOR_GET_RED(params->color);
+      green       = FONT_COLOR_GET_GREEN(params->color);
+      blue        = FONT_COLOR_GET_BLUE(params->color);
+      color_alpha = FONT_COLOR_GET_ALPHA(params->color);
+   }
+   else
+   {
+      start_x = settings
+         ? (int)(settings->floats.video_msg_pos_x * surface->src_width) : 12;
+      pen_y = settings
+         ? (int)((1.0f - settings->floats.video_msg_pos_y) *
+               surface->src_height) : surface->src_height - 12;
+      red   = settings ? (unsigned)(settings->floats.video_msg_color_r * 255.0f) : 255;
+      green = settings ? (unsigned)(settings->floats.video_msg_color_g * 255.0f) : 255;
+      blue  = settings ? (unsigned)(settings->floats.video_msg_color_b * 255.0f) : 255;
+   }
+
+   pen_x = start_x;
+   while (*msg)
+   {
+      const struct font_glyph *glyph;
+      const uint8_t *src;
+      unsigned x;
+      unsigned y;
+      unsigned code = (uint8_t)*msg++;
+
+      if (code == '\n')
+      {
+         pen_x  = start_x;
+         pen_y += (int)(vid->font_driver->get_glyph(vid->font_data, 'M')->height * scale);
+         continue;
+      }
+
+      glyph = vid->font_driver->get_glyph(vid->font_data, code);
+      if (!glyph)
+         glyph = vid->font_driver->get_glyph(vid->font_data, '?');
+      if (!glyph)
+         continue;
+
+      src = atlas->buffer + glyph->atlas_offset_x +
+         glyph->atlas_offset_y * atlas->width;
+
+      for (y = 0; y < (unsigned)(glyph->height * scale); y++)
+      {
+         unsigned src_y = (unsigned)(y / scale);
+         for (x = 0; x < (unsigned)(glyph->width * scale); x++)
+         {
+            unsigned src_x = (unsigned)(x / scale);
+            unsigned alpha = src[src_y * atlas->width + src_x] *
+               color_alpha / 255;
+
+            if (alpha)
+               drm_blend_osd_pixel(surface, dst_base,
+                     pen_x + (int)(glyph->draw_offset_x * scale) + (int)x,
+                     pen_y + (int)(glyph->draw_offset_y * scale) + (int)y,
+                     red, green, blue, alpha);
+         }
+      }
+
+      pen_x += (int)(glyph->advance_x * scale);
+      pen_y -= (int)(glyph->advance_y * scale);
+   }
+}
