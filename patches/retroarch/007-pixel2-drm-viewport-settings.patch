diff --git a/gfx/drivers/drm_gfx.c b/gfx/drivers/drm_gfx.c
--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -109,6 +109,7 @@ struct drm_surface
    int total_pitch;
 
    float aspect;
+   struct video_viewport viewport;
    bool flip_page;
 };
 
@@ -522,34 +523,26 @@ static void drm_plane_setup(struct drm_surface *surface)
     * crtc_x and crtc_y are the position of the plane
     * pw and ph are the input size: the size of the area we read from the fb. */
    uint32_t plane_flags = 0;
+   settings_t *settings = config_get_ptr();
+   struct video_viewport *vp = &surface->viewport;
+   int32_t plane_x;
+   int32_t plane_y;
    uint32_t plane_w;
    uint32_t plane_h;
-   float display_aspect = (float)drm.current_mode->hdisplay /
-      (float)drm.current_mode->vdisplay;
-   float surface_aspect = surface->aspect;
 
-   if (surface_aspect <= 0.0f)
-      surface_aspect = display_aspect;
+   vp->full_width  = drm.current_mode->hdisplay;
+   vp->full_height = drm.current_mode->vdisplay;
+   video_driver_update_viewport(vp, false,
+         settings ? settings->bools.video_force_aspect : true);
+   plane_x = vp->x;
+   plane_y = vp->y;
+   plane_w = vp->width;
+   plane_h = vp->height;
 
-   /* Fit the core aspect inside the display in both directions. Clamping
-    * width alone stretches wide content vertically to the full panel. */
-   if (surface_aspect > display_aspect)
-   {
-      plane_w = drm.current_mode->hdisplay;
-      plane_h = (uint32_t)((float)plane_w / surface_aspect);
-   }
-   else
-   {
-      plane_h = drm.current_mode->vdisplay;
-      plane_w = (uint32_t)((float)plane_h * surface_aspect);
-   }
    if (!plane_w)
       plane_w = 1;
    if (!plane_h)
       plane_h = 1;
-
-   uint32_t plane_x = (drm.current_mode->hdisplay - plane_w) / 2;
-   uint32_t plane_y = (drm.current_mode->vdisplay - plane_h) / 2;
 
    uint32_t src_w = surface->src_width;
    uint32_t src_h = surface->src_height;
@@ -919,20 +912,41 @@ static void drm_viewport_info(void *data, struct video_viewport *vp)
 static void drm_viewport_info(void *data, struct video_viewport *vp)
 {
    struct drm_video *vid = data;
+   struct drm_surface *surface;
 
    if (!vid)
       return;
 
-   vp->x = vp->y = 0;
+   surface = (vid->menu_active && vid->menu_surface)
+      ? vid->menu_surface : vid->main_surface;
 
-   vp->width  = vp->full_width  = vid->core_width;
-   vp->height = vp->full_height = vid->core_height;
+   if (surface)
+      *vp = surface->viewport;
+   else
+   {
+      vp->x = vp->y = 0;
+      vp->width      = vp->full_width  = vid->kms_width;
+      vp->height     = vp->full_height = vid->kms_height;
+   }
 }
 
 static bool drm_suppress_screensaver(void *a, bool b) { return false; }
 static bool drm_set_shader(void *data,
       enum rarch_shader_type type, const char *path) { return false; }
 
+static void drm_apply_state_changes(void *data)
+{
+   struct drm_video *_drmvars = data;
+
+   if (!_drmvars)
+      return;
+
+   if (_drmvars->menu_active && _drmvars->menu_surface)
+      drm_plane_setup(_drmvars->menu_surface);
+   else if (_drmvars->main_surface)
+      drm_plane_setup(_drmvars->main_surface);
+}
+
 static void drm_set_aspect_ratio (void *data, unsigned aspect_ratio_idx)
 {
    struct drm_video *_drmvars = data;
@@ -969,7 +983,7 @@ static const video_poke_interface_t drm_poke_interface = {
    NULL, /* get_current_framebuffer */
    NULL, /* get_proc_address */
    drm_set_aspect_ratio,
-   NULL, /* drm_apply_state_changes */
+   drm_apply_state_changes,
    drm_set_texture_frame,
    drm_set_texture_enable,
    NULL, /* drm_set_osd_msg */
