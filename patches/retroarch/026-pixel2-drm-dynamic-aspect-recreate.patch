diff --git a/gfx/drivers/drm_gfx.c b/gfx/drivers/drm_gfx.c
--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -253,13 +253,6 @@ static void drm_surface_free(void *data, struct drm_surface **sp)
    *sp = NULL;
 }
 
-/* Changes surface ratio only without recreating the buffers etc. */
-static void drm_surface_set_aspect(struct drm_surface *surface, float aspect)
-{
-   if (surface)
-      surface->aspect = aspect;
-}
-
 /* The Pixel2 display plane applies a filtered scale when its source and CRTC
  * rectangles differ. Keep those rectangles equal and scale into a viewport
  * sized dumb buffer here, where nearest-neighbour is explicit. */
@@ -1536,17 +1536,23 @@ static void drm_set_aspect_ratio (void *data, unsigned aspect_ratio_idx)
    if (_drmvars && _drmvars->current_aspect != new_aspect)
    {
       _drmvars->current_aspect = new_aspect;
-      drm_surface_set_aspect(_drmvars->main_surface, new_aspect);
-      if (_drmvars->menu_active)
+
+      /* Pixel2 scales into viewport-sized dumb buffers. Updating only the
+       * cached aspect leaves their old dimensions in place, so a runtime
+       * aspect selection neither changes the game plane nor matches the menu
+       * renderer's new layout. Invalidate both surfaces on the video thread;
+       * the next game/menu frame recreates them with the new viewport. Keep
+       * menu_active unchanged so an open RGUI is rebuilt instead of closed. */
+      if (_drmvars->main_surface)
       {
-         drm_surface_set_aspect(_drmvars->menu_surface, new_aspect);
-         drm_plane_setup(_drmvars->menu_surface);
+         drm_surface_free(_drmvars, &_drmvars->main_surface);
+         _drmvars->core_width  = 0;
+         _drmvars->core_height = 0;
       }
-      else if (_drmvars->main_surface)
-      {
-         /* The plane geometry is not changed by updating the cached aspect. */
-         drm_plane_setup(_drmvars->main_surface);
-      }
+      if (_drmvars->menu_surface)
+         drm_surface_free(_drmvars, &_drmvars->menu_surface);
+
+      RARCH_LOG("[DRM] Surfaces invalidated for runtime aspect change.\n");
    }
 }
 
