+
+static void drm_surface_map_logical_pixel(const struct drm_surface *surface,
+      unsigned int logical_x, unsigned int logical_y,
+      unsigned int *dst_x, unsigned int *dst_y)
+{
+   unsigned int lw = (unsigned int)surface->logical_width;
+   unsigned int lh = (unsigned int)surface->logical_height;
+
+   switch (surface->rotation & 3)
+   {
+      case 1:
+         *dst_x = lh - 1 - logical_y;
+         *dst_y = logical_x;
+         break;
+      case 2:
+         *dst_x = lw - 1 - logical_x;
+         *dst_y = lh - 1 - logical_y;
+         break;
+      case 3:
+         *dst_x = logical_y;
+         *dst_y = lw - 1 - logical_x;
+         break;
+      default:
+         *dst_x = logical_x;
+         *dst_y = logical_y;
+         break;
+   }
 }
 
