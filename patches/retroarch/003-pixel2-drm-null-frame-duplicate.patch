diff --git a/gfx/drivers/drm_gfx.c b/gfx/drivers/drm_gfx.c
index 6b2166af90..c96c5fe9c7 100644
--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -801,7 +801,12 @@ static bool drm_frame(void *data, const void *frame, unsigned width,
 #endif
 
    /* Update main surface: locate free page, blit and flip. */
-   drm_surface_update(_drmvars, frame, _drmvars->main_surface);
+   /* A NULL frame is the libretro duplicate-frame contract. Keep the
