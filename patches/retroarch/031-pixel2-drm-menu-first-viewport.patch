--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -1530,6 +1530,22 @@ static void drm_viewport_info(void *data, struct video_viewport *vp)
    if (!vid)
       return;
 
+   /* Report the fixed display-menu viewport before its first surface exists.
+    * Otherwise RGUI renders frame zero against the rotated game viewport,
+    * then changes dimensions after menu_surface becomes active. Although the
+    * geometry guard can recover, replacing that first surface produces a
+    * visible one-frame blink. */
+   if (vid->menu_active && !vid->menu_surface)
+   {
+      struct drm_surface menu_view;
+      memset(&menu_view, 0, sizeof(menu_view));
+      menu_view.rotation = vid->panel_rotation & 3;
+      menu_view.aspect   = 4.0f / 3.0f;
+      drm_surface_update_viewport(&menu_view);
+      *vp = menu_view.viewport;
+      return;
+   }
+
    surface = (vid->menu_active && vid->menu_surface)
       ? vid->menu_surface : vid->main_surface;
 
