diff --git a/gfx/drivers/drm_gfx.c b/gfx/drivers/drm_gfx.c
index 9195d7735d..6b2166af90 100644
--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -434,6 +434,7 @@ static void drm_plane_setup(struct drm_surface *surface)
       RARCH_ERR("[DRM] No scaling planes available.\n");
    }

+   drm.plane_id = 0;
    RARCH_LOG("[DRM] Number of planes on FD %d is %d.\n",
          drm.fd, plane_resources->count_planes);

@@ -489,6 +490,7 @@ static void drm_plane_setup(struct drm_surface *surface)

       drm.plane_id = plane->plane_id;
       drmModeFreePlane(plane);
+      break;
    }

    if (!drm.plane_id)
@@ -563,7 +565,11 @@ static int modeset_create_dumbfb(int fd, struct modeset_buf *buf,
    create_dumb.pitch  = 0;
    create_dumb.size   = 0;
    create_dumb.handle = 0;
-   drmIoctl(drm.fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_dumb);
+   if (drmIoctl(drm.fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_dumb) < 0)
+   {
+      RARCH_ERR("[DRM] Cannot create dumb buffer.\n");
+      return -1;
+   }

    /* Create the buffer. We just copy values here... */
    cmd_dumb.width        = create_dumb.width;
@@ -571,12 +577,21 @@ static int modeset_create_dumbfb(int fd, struct modeset_buf *buf,
    cmd_dumb.bpp          = create_dumb.bpp;
    cmd_dumb.pitch        = create_dumb.pitch;
    cmd_dumb.handle       = create_dumb.handle;
-   cmd_dumb.depth        = 24;
+   cmd_dumb.depth        = pixformat == DRM_FORMAT_RGB565 ? 16 : 24;

    /* Map the buffer */
-   drmIoctl(drm.fd,DRM_IOCTL_MODE_ADDFB,&cmd_dumb);
+   if (drmIoctl(drm.fd, DRM_IOCTL_MODE_ADDFB, &cmd_dumb) < 0)
+   {
+      RARCH_ERR("[DRM] Cannot register dumb framebuffer (bpp=%u depth=%u).\n",
+            cmd_dumb.bpp, cmd_dumb.depth);
+      return -1;
+   }
    map_dumb.handle=create_dumb.handle;
-   drmIoctl(drm.fd,DRM_IOCTL_MODE_MAP_DUMB,&map_dumb);
+   if (drmIoctl(drm.fd, DRM_IOCTL_MODE_MAP_DUMB, &map_dumb) < 0)
+   {
+      RARCH_ERR("[DRM] Cannot map dumb framebuffer handle.\n");
+      return -1;
+   }

    buf->pixel_format = pixformat;
    buf->fb_id = cmd_dumb.fb_id;
@@ -590,7 +605,7 @@ static int modeset_create_dumbfb(int fd, struct modeset_buf *buf,
    if (buf->map == MAP_FAILED)
    {
       RARCH_ERR("[DRM] Cannot mmap dumb buffer.\n");
-      return 0;
+      return -1;
    }

    return 0;
