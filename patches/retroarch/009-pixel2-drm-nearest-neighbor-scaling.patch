+/* The Pixel2 display plane applies a filtered scale when its source and CRTC
+ * rectangles differ. Keep those rectangles equal and scale into a viewport
+ * sized dumb buffer here, where nearest-neighbour is explicit. */
+static void drm_surface_update_viewport(struct drm_surface *surface)
+{
+   settings_t *settings              = config_get_ptr();
+   struct video_viewport *vp         = &surface->viewport;
+
+   vp->full_width  = drm.current_mode->hdisplay;
+   vp->full_height = drm.current_mode->vdisplay;
+   video_driver_update_viewport(vp, false,
+         settings ? settings->bools.video_force_aspect : true);
+
+   if (!vp->width)
+      vp->width = 1;
+   if (!vp->height)
+      vp->height = 1;
+}
