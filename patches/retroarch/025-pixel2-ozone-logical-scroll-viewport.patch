+static void ozone_get_layout_size(unsigned *width, unsigned *height)
+{
+   unsigned layout_width  = 0;
+   unsigned layout_height = 0;
+   const char *rotation   = getenv("PLUMOS_GL_MENU_ROTATION");
+
+   video_driver_get_size(&layout_width, &layout_height);
+
+   /* Pixel2's GL driver scans out to a native portrait surface, while Ozone
+    * is rendered as logical landscape. The frame callback already receives
+    * the swapped dimensions, but navigation and clipping query the video
+    * driver directly. Keep those off-frame calculations in the same logical
+    * coordinate system so scrolling never moves the selected row outside the
+    * visible menu viewport. */
+   if (   rotation
+       && string_is_equal(rotation, "display")
+       && (layout_height > layout_width))
+   {
+      unsigned tmp  = layout_width;
+      layout_width  = layout_height;
+      layout_height = tmp;
+   }
+
+   if (width)
+      *width = layout_width;
+   if (height)
+      *height = layout_height;
+}
