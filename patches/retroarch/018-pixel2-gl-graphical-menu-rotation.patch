diff --git a/gfx/drivers/gl2.c b/gfx/drivers/gl2.c
--- a/gfx/drivers/gl2.c
+++ b/gfx/drivers/gl2.c
@@ -374,6 +374,30 @@ static const float *gfx_display_gl2_get_default_tex_coords(void)
    return &gl2_tex_coords[0];
 }
 
+static bool gl2_menu_display_rotation(void)
+{
+   const char *menu_rotation = getenv("PLUMOS_GL_MENU_ROTATION");
+   return menu_rotation && strcmp(menu_rotation, "display") == 0;
+}
+
+static void gl2_rotate_menu_rect(float logical_height,
+      float *x, float *y, unsigned *width, unsigned *height)
+{
+   float old_x         = *x;
+   float old_y         = *y;
+   unsigned old_width  = *width;
+   unsigned old_height = *height;
+
+   /* Pixel2's physical scanout is 480x640 while graphical menus lay out a
+    * logical 640x480 surface. Rotate the lower-left GL viewport rectangle
+    * counter-clockwise into the native scanout. The user then sees the same
+    * landscape orientation as the plumOS frontend and plain-DRM RGUI. */
+   *x      = logical_height - old_y - (float)old_height;
+   *y      = old_x;
+   *width  = old_height;
+   *height = old_width;
+}
+
 static void *gfx_display_gl2_get_default_mvp(void *data)
 {
    gl2_t *gl = (gl2_t*)data;
@@ -381,7 +405,8 @@ static void *gfx_display_gl2_get_default_mvp(void *data)
    if (!gl)
       return NULL;
 
-   return &gl->mvp_no_rot;
+   return gl2_menu_display_rotation()
+      ? &gl->mvp : &gl->mvp_no_rot;
 }
 
 static GLenum gfx_display_prim_to_gl_enum(
@@ -434,11 +459,23 @@ static void gfx_display_gl2_draw(gfx_display_ctx_draw_t *draw,
       void *data, unsigned video_width, unsigned video_height)
 {
