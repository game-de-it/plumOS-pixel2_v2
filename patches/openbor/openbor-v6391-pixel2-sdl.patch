diff --git a/engine/sdl/control.h b/engine/sdl/control.h
index 9450fdb..be4d790 100644
--- a/engine/sdl/control.h
+++ b/engine/sdl/control.h
@@ -17,7 +17,23 @@
 #endif
 #include "joysticks.h"
 
-#ifdef OPENDINGUX
+#ifdef PLUMOS_PIXEL2
+	/* pixel2_joypad SDL joystick order follows the shared plumOS input map. */
+	#define CONTROL_ESC                 (JOY_LIST_FIRST + 8)
+	#define CONTROL_DEFAULT1_UP         (JOY_LIST_FIRST + 10)
+	#define CONTROL_DEFAULT1_RIGHT      (JOY_LIST_FIRST + 13)
+	#define CONTROL_DEFAULT1_DOWN       (JOY_LIST_FIRST + 11)
+	#define CONTROL_DEFAULT1_LEFT       (JOY_LIST_FIRST + 12)
+	#define CONTROL_DEFAULT1_FIRE1      (JOY_LIST_FIRST + 0)
+	#define CONTROL_DEFAULT1_FIRE2      (JOY_LIST_FIRST + 1)
+	#define CONTROL_DEFAULT1_FIRE3      (JOY_LIST_FIRST + 2)
+	#define CONTROL_DEFAULT1_FIRE4      (JOY_LIST_FIRST + 3)
+	#define CONTROL_DEFAULT1_FIRE5      (JOY_LIST_FIRST + 4)
+	#define CONTROL_DEFAULT1_FIRE6      (JOY_LIST_FIRST + 5)
+	#define CONTROL_DEFAULT1_START      (JOY_LIST_FIRST + 9)
+	#define CONTROL_DEFAULT1_SCREENSHOT (JOY_LIST_FIRST + 14)
+	#define CONTROL_DEFAULT1_ESC        (JOY_LIST_FIRST + 8)
+#elif defined(OPENDINGUX)
 	#define	CONTROL_ESC                 OPENDINGUX_BUTTON_SELECT
 	#define	CONTROL_DEFAULT1_START		OPENDINGUX_BUTTON_START
