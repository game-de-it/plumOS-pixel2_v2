diff --git a/engine/sdl/video.c b/engine/sdl/video.c
index ff4b37e..68891ea 100644
--- a/engine/sdl/video.c
+++ b/engine/sdl/video.c
@@ -159,6 +159,11 @@ int video_set_mode(s_videomodes videomodes)
 	stored_videomodes = videomodes;
 	yuv_mode = 0;
 
+#ifdef PLUMOS_PIXEL2
+	savedata.fullscreen = 1;
+	savedata.stretch = 1;
+#endif
+
 	if(videomodes.hRes==0 && videomodes.vRes==0)
 	{
 		Term_Gfx();
@@ -193,6 +198,7 @@ int video_set_mode(s_videomodes videomodes)
 	                            videomodes.hRes, videomodes.vRes);
 
 	SDL_ShowCursor(SDL_DISABLE);
+	SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_NONE);
 	SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
 	video_stretch(savedata.stretch);
 
@@ -209,15 +215,20 @@ void video_fullscreen_flip()
 
 void blit()
 {
-	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 0);
+	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
 	SDL_RenderClear(renderer);
 	SDL_RenderCopy(renderer, texture, NULL, NULL);
 
 	if (brightness > 0)
+	{
 		SDL_SetRenderDrawColor(renderer, 255, 255, 255, brightness-1);
+		SDL_RenderFillRect(renderer, NULL);
+	}
 	else if (brightness < 0)
+	{
 		SDL_SetRenderDrawColor(renderer, 0, 0, 0, (-brightness)-1);
-	SDL_RenderFillRect(renderer, NULL);
+		SDL_RenderFillRect(renderer, NULL);
+	}
 
 	SDL_RenderPresent(renderer);
 }
@@ -243,7 +254,7 @@ void video_clearscreen()
 {
 	if(opengl) { video_gl_clearscreen(); return; }
 
-	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 0);
+	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
 	SDL_RenderClear(renderer);
 	SDL_RenderPresent(renderer);
 }
diff --git a/engine/openbor.c b/engine/openbor.c
