# Pixel2 PicoArch defaults. Users may override this file on the plumOS runtime.
PLUMOS_PICOARCH_EFFECT=NONE
PLUMOS_PICOARCH_SDL_VIDEODRIVER=dummy
PLUMOS_PICOARCH_SDL_RENDER_DRIVER=software
PLUMOS_PICOARCH_SDL_AUDIODRIVER=alsa
PLUMOS_PICOARCH_AUDIODEV=plumos_output
PLUMOS_PICOARCH_SYNC_TO_VBLANK=0
PLUMOS_PICOARCH_AUDIO_TARGET_FPS=0
