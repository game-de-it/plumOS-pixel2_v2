#!/bin/sh
set -eu

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
PLUMOS_RUNTIME_ROOT="${PLUMOS_RUNTIME_ROOT:-/run/plumos}"
PICOARCH_BIN="${PLUMOS_PICOARCH_BIN:-$PLUMOS_ROOT/picoarch/bin/picoarch}"
PID_FILE="$PLUMOS_RUNTIME_ROOT/picoarch/runtime.pid"

[ -r "$PID_FILE" ] || exit 0
pid="$(cat "$PID_FILE")"
case "$pid" in *[!0-9]*|'') exit 1 ;; esac
[ -r "/proc/$pid/exe" ] || { rm -f "$PID_FILE"; exit 0; }
[ "$(readlink "/proc/$pid/exe")" = "$PICOARCH_BIN" ] || {
  echo "plumos-picoarch-stop: refusing unexpected PID $pid" >&2
  exit 1
}

kill -INT "$pid" 2>/dev/null || true
i=0
while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
  sleep 0.1
  i=$((i + 1))
done
kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
rm -f "$PID_FILE"
