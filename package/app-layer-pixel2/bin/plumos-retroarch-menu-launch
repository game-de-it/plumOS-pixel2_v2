#!/bin/sh
set -eu

root="${PLUMOS_ROOT:-/mnt/plumos}"
runtime_root="${PLUMOS_RUNTIME_ROOT:-/run/plumos}"
sdcard_root="${PLUMOS_SDCARD_ROOT:-/mnt/plumos-user}"
config="$root/config/retroarch/retroarch.cfg"
factory="$root/factory-defaults/retroarch/retroarch.cfg"
append="$runtime_root/retroarch/menu-append.cfg"

mkdir -p "$root/config/retroarch/config" "$root/config/retroarch/remaps" \
    "$root/config/retroarch/playlists/builtin" "$root/config/retroarch/filters/audio" \
    "$root/config/retroarch/filters/video" "$root/config/retroarch/overlays/keyboards" \
    "$root/config/retroarch/records_config" "$root/state/retroarch/home" \
    "$root/state/retroarch/cache" "$root/logs/retroarch/runtime" \
    "$runtime_root/retroarch" "$runtime_root/cache/retroarch" \
    "$sdcard_root/Screenshots" "$sdcard_root/Recordings" \
    "$sdcard_root/Images/retroarch"
if [ -x "$root/bin/plumos-retroarch-config-merge" ]; then
    "$root/bin/plumos-retroarch-config-merge" >>"$root/logs/retroarch-menu.log" 2>&1
elif [ ! -s "$config" ]; then
    cp "$factory" "$config.next"
    sync
    mv "$config.next" "$config"
fi

# The stock boot substrate does not populate /run/udev for the Pixel2 pad.
# Games already prepare the synthetic joystick classification in the normal
# RetroArch launcher; the contentless menu needs the same contract or udev
# falls back to linuxraw and RetroArch exits before the first frame.
if [ -x "$root/bin/plumos-ensure-udev-input-db" ]; then
    "$root/bin/plumos-ensure-udev-input-db" \
        >>"$root/logs/retroarch-menu.log" 2>&1 || true
fi

if [ -x "$root/bin/plumos-audio-output" ]; then
    "$root/bin/plumos-audio-output" prepare >>"$root/logs/retroarch-menu.log" 2>&1
    export ALSA_CONFIG_PATH="${ALSA_CONFIG_PATH:-$runtime_root/audio/asound.conf}"
    export ALSA_PLUGIN_DIR="${ALSA_PLUGIN_DIR:-$root/lib/alsa-lib}"
fi

menu_driver=$(
    sed -n 's/^[[:space:]]*menu_driver[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$config" | sed -n '1p'
)
video_driver=drm
video_rotation=3
aspect_ratio_index=0
case "$menu_driver" in
    glui|ozone|xmb)
        # Graphical menu drivers need GLES. Present them on Pixel2's native
        # portrait scanout through the same app-layer Mesa stack as hardware
        # cores, then rotate their logical 640x480 draw coordinates once.
        video_driver=gl
        video_rotation=1
        aspect_ratio_index=24
        export PLUMOS_GL_MENU_ROTATION=display
        export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-$root/emulator/dri}"
        export __EGL_VENDOR_LIBRARY_FILENAMES="${__EGL_VENDOR_LIBRARY_FILENAMES:-$root/emulator/egl_vendor.d/50_mesa.json}"
        ;;
esac

cat >"$append" <<EOF
video_driver = "$video_driver"
video_rotation = "$video_rotation"
video_allow_rotate = "true"
video_force_aspect = "true"
video_aspect_ratio = "1.333333"
aspect_ratio_index = "$aspect_ratio_index"
input_driver = "udev"
input_joypad_driver = "udev"
joypad_autoconfig_dir = "$root/factory-defaults/retroarch/autoconfig"
input_menu_toggle_btn = "14"
system_directory = "${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}"
EOF

export HOME="$root/state/retroarch/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/state/retroarch/cache"
export LD_LIBRARY_PATH="$root/emulator/lib:$root/frontend/lib:$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$root/bin/retroarch" --menu -v -c "$config" --appendconfig "$append" \
    >>"$root/logs/retroarch-menu.log" 2>&1
