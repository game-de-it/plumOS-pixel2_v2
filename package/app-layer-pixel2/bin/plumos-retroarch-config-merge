#!/bin/sh
set -eu

bb=${PLUMOS_BUSYBOX:-/bin/busybox}
root=${PLUMOS_ROOT:-/mnt/plumos}
config=${PLUMOS_RETROARCH_CONFIG:-$root/config/retroarch/retroarch.cfg}
factory=${PLUMOS_RETROARCH_FACTORY_CONFIG:-$root/factory-defaults/retroarch/retroarch.cfg}
core_options=${PLUMOS_RETROARCH_CORE_OPTIONS:-$root/config/retroarch/retroarch-core-options.cfg}
core_options_factory=${PLUMOS_RETROARCH_CORE_OPTIONS_FACTORY:-$root/factory-defaults/retroarch/retroarch-core-options.cfg}
remap=${PLUMOS_RETROARCH_N64_REMAP:-$root/config/retroarch/remaps/ParaLLEl N64/ParaLLEl N64.rmp}
remap_factory=${PLUMOS_RETROARCH_N64_REMAP_FACTORY:-$root/factory-defaults/retroarch/remaps/ParaLLEl N64/ParaLLEl N64.rmp}
state_dir=${PLUMOS_RETROARCH_CONFIG_STATE:-$root/state/retroarch}
marker=$state_dir/factory-config.sha256
legacy_pixel2_sha256=b97c897bb7141a77d6fb17e77a66895540b9bd9cc177d7ee983afcb75e5e819e
legacy_incomplete_full_sha256=9f4aaebdab3cc3a9be24b203161e63f63f1887e4eb0b79c82618086d3cbc4b24
regressed_pixel2_sha256=8d9a8e71cc38e63d1c6084d6bcf99701507cb632ff2dd1f4ebf9963b82beae77
osd_disabled_factory_sha256=2db551beda3cd62e4f87d15d77a56ae2df1905fa3bc3925dbf5aaee803a4dcc6
black_osd_factory_sha256=231ee2585779c098d9512a64cc8b17322c3b86e07d3e84889aaac815893d7280
small_menu_factory_sha256=0fe41cce8ee36e4ca0b346ad2aee17563f08afb9f402fe1a3f8ea5e46a1744ef

[ -s "$factory" ] || {
    printf 'retroarch_config=result-error reason=factory-missing path=%s\n' "$factory" >&2
    exit 1
}
$bb mkdir -p "${config%/*}" "$state_dir"
set -- $($bb sha256sum "$factory")
factory_sha256=$1

atomic_copy() {
    source=$1
    target=$2
    $bb mkdir -p "${target%/*}"
    temporary="${target}.next.$$"
    $bb cp "$source" "$temporary"
    $bb sync
    $bb mv "$temporary" "$target"
}

merge_key_file() {
    merge_factory=$1
    merge_target=$2
    merge_label=$3
    merge_added=0
    merge_result=unchanged
    [ -s "$merge_factory" ] || return 0
    if [ ! -s "$merge_target" ]; then
        atomic_copy "$merge_factory" "$merge_target"
        merge_added=$($bb awk '$0 ~ /^[A-Za-z0-9_.-]+[[:space:]]*=/ { count++ } END { print count + 0 }' "$merge_factory")
        merge_result=installed
        return 0
    fi

    merge_next="${merge_target}.next.$$"
    merge_count="$state_dir/merge-${merge_label}-count.$$"
    $bb cp "$merge_target" "$merge_next"
    printf '\n' >>"$merge_next"
    $bb awk '
        NR == FNR {
            if ($0 ~ /^[A-Za-z0-9_.-]+[[:space:]]*=/) {
                key=$0
                sub(/[[:space:]]*=.*/, "", key)
                present[key]=1
            }
            next
        }
        $0 ~ /^[A-Za-z0-9_.-]+[[:space:]]*=/ {
            key=$0
            sub(/[[:space:]]*=.*/, "", key)
            if (!present[key]) {
                print
                added++
            }
        }
        END { print added + 0 > count_file }
    ' count_file="$merge_count" "$merge_target" "$merge_factory" >>"$merge_next"
    merge_added=$($bb sed -n '1p' "$merge_count" 2>/dev/null || printf '0')
    $bb rm -f "$merge_count"
    if [ "$merge_added" -gt 0 ]; then
        $bb sync
        $bb mv "$merge_next" "$merge_target"
        merge_result=merged
    else
        $bb rm -f "$merge_next"
    fi
}

migrate_legacy_incomplete_values() {
    migrate_next="${config}.next.$$"
    migrate_count="$state_dir/migrate-legacy-count.$$"
    $bb awk '
        $0 == "input_toggle_fast_forward_axis = \"+5\"" {
            $0 = "input_toggle_fast_forward_axis = \"nul\""; changed++
        }
        $0 == "input_toggle_fast_forward_btn = \"nul\"" {
            $0 = "input_toggle_fast_forward_btn = \"7\""; changed++
        }
        $0 == "input_toggle_slowmotion_axis = \"+4\"" {
            $0 = "input_toggle_slowmotion_axis = \"nul\""; changed++
        }
        $0 == "input_toggle_slowmotion_btn = \"nul\"" {
            $0 = "input_toggle_slowmotion_btn = \"6\""; changed++
        }
        $0 == "savefiles_in_content_dir = \"false\"" {
            $0 = "savefiles_in_content_dir = \"true\""; changed++
        }
        $0 == "savestates_in_content_dir = \"false\"" {
            $0 = "savestates_in_content_dir = \"true\""; changed++
        }
        $0 == "sort_savefiles_by_content_enable = \"false\"" {
            $0 = "sort_savefiles_by_content_enable = \"true\""; changed++
        }
        $0 == "sort_savefiles_enable = \"false\"" {
            $0 = "sort_savefiles_enable = \"true\""; changed++
        }
        $0 == "sort_savestates_by_content_enable = \"false\"" {
            $0 = "sort_savestates_by_content_enable = \"true\""; changed++
        }
        $0 == "sort_savestates_enable = \"false\"" {
            $0 = "sort_savestates_enable = \"true\""; changed++
        }
        { print }
        END { print changed + 0 > count_file }
    ' count_file="$migrate_count" "$config" >"$migrate_next"
    legacy_changed=$($bb sed -n '1p' "$migrate_count" 2>/dev/null || printf '0')
    $bb rm -f "$migrate_count"
    if [ "$legacy_changed" -gt 0 ]; then
        $bb sync
        $bb mv "$migrate_next" "$config"
    else
        $bb rm -f "$migrate_next"
    fi
}

migrate_regressed_exit_values() {
    migrate_next="${config}.next.$$"
    migrate_count="$state_dir/migrate-regression-count.$$"
    $bb awk '
        $0 == "input_exit_emulator_btn = \"nul\"" {
            $0 = "input_exit_emulator_btn = \"9\""; changed++
        }
        $0 == "input_menu_toggle_gamepad_combo = \"4\"" {
            $0 = "input_menu_toggle_gamepad_combo = \"0\""; changed++
        }
        { print }
        END { print changed + 0 > count_file }
    ' count_file="$migrate_count" "$config" >"$migrate_next"
    regression_changed=$($bb sed -n '1p' "$migrate_count" 2>/dev/null || printf '0')
    $bb rm -f "$migrate_count"
    if [ "$regression_changed" -gt 0 ]; then
        $bb sync
        $bb mv "$migrate_next" "$config"
    else
        $bb rm -f "$migrate_next"
    fi
}

migrate_osd_values() {
    migrate_next="${config}.next.$$"
    migrate_count="$state_dir/migrate-osd-count.$$"
    $bb awk '
        $0 == "video_font_enable = \"false\"" {
            $0 = "video_font_enable = \"true\""; changed++
        }
        $0 == "video_font_path = \"\"" {
            $0 = "video_font_path = \"/mnt/plumos/fonts/default.otf\""; changed++
        }
        { print }
        END { print changed + 0 > count_file }
    ' count_file="$migrate_count" "$config" >"$migrate_next"
    osd_changed=$($bb sed -n '1p' "$migrate_count" 2>/dev/null || printf '0')
    $bb rm -f "$migrate_count"
    if [ "$osd_changed" -gt 0 ]; then
        $bb sync
        $bb mv "$migrate_next" "$config"
    else
        $bb rm -f "$migrate_next"
    fi
}

migrate_managed_assets_path() {
    migrate_next="${config}.next.$$"
    migrate_count="$state_dir/migrate-menu-assets-count.$$"
    $bb awk '
        $0 == "assets_directory = \"/mnt/plumos/config/retroarch/assets\"" {
            $0 = "assets_directory = \"/mnt/plumos/retroarch/assets\""; changed++
        }
        { print }
        END { print changed + 0 > count_file }
    ' count_file="$migrate_count" "$config" >"$migrate_next"
    assets_changed=$($bb sed -n '1p' "$migrate_count" 2>/dev/null || printf '0')
    $bb rm -f "$migrate_count"
    if [ "$assets_changed" -gt 0 ]; then
        $bb sync
        $bb mv "$migrate_next" "$config"
    else
        $bb rm -f "$migrate_next"
    fi
}

migrate_pixel2_menu_scale_values() {
    migrate_next="${config}.next.$$"
    migrate_count="$state_dir/migrate-menu-scale-count.$$"
    $bb awk '
        $0 == "menu_scale_factor = \"1.000000\"" {
            $0 = "menu_scale_factor = \"1.500000\""; changed++
        }
        $0 == "ozone_font_scale = \"0\"" {
            $0 = "ozone_font_scale = \"1\""; changed++
        }
        $0 == "ozone_font_scale_factor_global = \"1.000000\"" {
            $0 = "ozone_font_scale_factor_global = \"1.350000\""; changed++
        }
        { print }
        END { print changed + 0 > count_file }
    ' count_file="$migrate_count" "$config" >"$migrate_next"
    menu_scale_changed=$($bb sed -n '1p' "$migrate_count" 2>/dev/null || printf '0')
    $bb rm -f "$migrate_count"
    if [ "$menu_scale_changed" -gt 0 ]; then
        $bb sync
        $bb mv "$migrate_next" "$config"
    else
        $bb rm -f "$migrate_next"
    fi
}

write_marker() {
    printf '%s\n' "$factory_sha256" >"$marker.next"
    $bb sync
    $bb mv "$marker.next" "$marker"
}

main_result=unchanged
main_added=0
if [ ! -s "$config" ]; then
    atomic_copy "$factory" "$config"
    main_result=installed
elif set -- $($bb sha256sum "$config") &&
        { [ "$1" = "$legacy_pixel2_sha256" ] ||
          [ "$1" = "$legacy_incomplete_full_sha256" ] ||
          [ "$1" = "$regressed_pixel2_sha256" ]; }; then
    atomic_copy "$factory" "$config"
    main_result=replaced-legacy
elif set -- $($bb sha256sum "$config") &&
        [ "$1" = "$black_osd_factory_sha256" ]; then
    # This exact factory generation accidentally made all plain-DRM OSD text
    # black. Replace it only when the complete active config is byte-identical
    # to that factory. A user-edited config with the same old marker is merged
    # normally below, so an explicit custom message colour is not overwritten.
    atomic_copy "$factory" "$config"
    main_result=replaced-black-osd
elif [ -r "$marker" ] &&
        [ "$($bb sed -n '1p' "$marker")" = "$legacy_incomplete_full_sha256" ]; then
    migrate_legacy_incomplete_values
    merge_key_file "$factory" "$config" config
    main_result=migrated-legacy
    main_added=$((legacy_changed + merge_added))
elif [ -r "$marker" ] &&
        [ "$($bb sed -n '1p' "$marker")" = "$regressed_pixel2_sha256" ]; then
    migrate_regressed_exit_values
    merge_key_file "$factory" "$config" config
    main_result=migrated-regression
    main_added=$((regression_changed + merge_added))
elif [ -r "$marker" ] &&
        [ "$($bb sed -n '1p' "$marker")" = "$osd_disabled_factory_sha256" ]; then
    migrate_osd_values
    merge_key_file "$factory" "$config" config
    main_result=migrated-osd
    main_added=$((osd_changed + merge_added))
elif [ -r "$marker" ] &&
        [ "$($bb sed -n '1p' "$marker")" = "$small_menu_factory_sha256" ]; then
    # The first selectable graphical-menu generation used desktop-oriented
    # 1.0x scaling. Move only values that still match that exact Pixel2
    # factory; explicit user scale/font choices remain authoritative.
    migrate_pixel2_menu_scale_values
    merge_key_file "$factory" "$config" config
    main_result=migrated-menu-scale
    main_added=$((menu_scale_changed + merge_added))
elif [ ! -r "$marker" ] ||
        [ "$($bb sed -n '1p' "$marker")" != "$factory_sha256" ]; then
    merge_key_file "$factory" "$config" config
    main_result=$merge_result
    main_added=$merge_added
fi

# The previous Pixel2 factory pointed menu media at an intentionally mutable
# but empty directory. Migrate only that exact obsolete path. User-selected
# menu drivers, languages, custom asset paths and every unrelated setting are
# preserved.
migrate_managed_assets_path
if [ "$assets_changed" -gt 0 ]; then
    main_result=migrated-menu-assets
    main_added=$((main_added + assets_changed))
fi

# These files are part of the same RetroArch factory contract. Explicit user
# values are preserved while newly supplied core options/remap keys are added.
merge_key_file "$core_options_factory" "$core_options" core-options
printf 'retroarch_aux=result-%s target=core-options added=%s\n' "$merge_result" "$merge_added"
merge_key_file "$remap_factory" "$remap" parallel-n64-remap
printf 'retroarch_aux=result-%s target=parallel-n64-remap added=%s\n' "$merge_result" "$merge_added"

write_marker
printf 'retroarch_config=result-%s added=%s sha256=%s\n' \
    "$main_result" "$main_added" "$factory_sha256"
