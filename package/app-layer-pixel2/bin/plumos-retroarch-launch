#!/bin/sh
set -eu

bb=/bin/busybox
root=${PLUMOS_ROOT:-/mnt/plumos}
rom_root=${PLUMOS_ROM_ROOT:-/mnt/plumos-user/roms}
sdcard_root=${PLUMOS_SDCARD_ROOT:-/mnt/plumos-user}
runtime_root=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
input_env=${PLUMOS_INPUT_MAP_ENV:-$root/config/system/input-map.env}
system_id=
core=
rom=
requested_cpu_policy=
audio_latency=${PLUMOS_RETROARCH_AUDIO_LATENCY:-96}
cpu_governor=${PLUMOS_RETROARCH_CPU_GOVERNOR:-}
audio_output="$root/bin/plumos-audio-output"
fast_forward_state=

export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-$root/emulator/dri}"
export __EGL_VENDOR_LIBRARY_FILENAMES="${__EGL_VENDOR_LIBRARY_FILENAMES:-$root/emulator/egl_vendor.d/50_mesa.json}"
export LD_LIBRARY_PATH="$root/emulator/lib:$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if [ -r "$input_env" ]; then
    set -a
    . "$input_env"
    set +a
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        --system) system_id=$2; shift 2 ;;
        --core) core=$2; shift 2 ;;
        --rom) rom=$2; shift 2 ;;
        --cpu) requested_cpu_policy=$2; shift 2 ;;
        --audio-latency) audio_latency=$2; shift 2 ;;
        --audio|--safe-exit) shift 2 ;;
        *) printf 'plumos-retroarch-launch: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done
if [ -z "$cpu_governor" ]; then
    cpu_governor=$requested_cpu_policy
fi
case "$cpu_governor" in
    ''|interactive|performance|ondemand|schedutil|conservative|powersave|userspace) ;;
    *)
        printf 'plumos-retroarch-launch: unsupported CPU governor: %s\n' "$cpu_governor" >&2
        exit 2
        ;;
esac

case "$system_id" in
    ''|*[!A-Za-z0-9._-]*|*..*)
        printf 'plumos-retroarch-launch: invalid system id\n' >&2
        exit 2
        ;;
esac
core_root=$($bb readlink -f "$root/cores")
rom_root=$($bb readlink -f "$rom_root" 2>/dev/null || true)
sdcard_rom_root=$($bb readlink -f "$sdcard_root/roms" 2>/dev/null || true)
default_rom_root=$($bb readlink -f /mnt/plumos-user/roms 2>/dev/null || true)
bind_rom_root=$($bb readlink -f /roms 2>/dev/null || true)
core=$($bb readlink -f "$core")
rom=$($bb readlink -f "$rom")
case "$core" in "$core_root"/*_libretro.so) ;; *) exit 2 ;; esac
rom_allowed=0
for candidate_root in "$rom_root" "$sdcard_rom_root" "$default_rom_root" "$bind_rom_root"; do
    [ -n "$candidate_root" ] || continue
    case "$rom" in "$candidate_root"/*) rom_allowed=1 ;; esac
done
[ "$rom_allowed" = 1 ] || exit 2
[ -f "$core" ] && [ -f "$rom" ] || exit 1

config="$root/config/retroarch/retroarch.cfg"
factory="$root/factory-defaults/retroarch/retroarch.cfg"
alsa_config="$root/config/alsa/alsa.conf"
alsa_factory="$root/factory-defaults/alsa/alsa.conf"
$bb mkdir -p "$root/config/retroarch" "$root/config/alsa" "$root/saves/$system_id" \
    "$root/states/$system_id" "$root/logs" "$runtime_root/retroarch"
if [ ! -s "$config" ]; then
    $bb cp "$factory" "$config.next"
    $bb sync
    $bb mv "$config.next" "$config"
fi
if [ ! -s "$alsa_config" ] && [ -s "$alsa_factory" ]; then
    $bb cp "$alsa_factory" "$alsa_config.next"
    $bb sync
    $bb mv "$alsa_config.next" "$alsa_config"
fi
if [ -x "$root/bin/plumos-ensure-udev-input-db" ]; then
    "$root/bin/plumos-ensure-udev-input-db" >>"$root/logs/retroarch-launch.log" 2>&1 || true
fi

cpu_restore="$runtime_root/retroarch/cpu-governors.$$"
set_cpu_governor() {
    [ -n "$cpu_governor" ] || return 0
    : >"$cpu_restore"
    changed=0
    for governor_path in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -e "$governor_path" ] || continue
        old_governor=$(cat "$governor_path" 2>/dev/null || true)
        printf '%s %s\n' "$governor_path" "$old_governor" >>"$cpu_restore"
        available_governors=$(cat "${governor_path%/scaling_governor}/scaling_available_governors" 2>/dev/null || true)
        case " $available_governors " in *" $cpu_governor "*) ;; *) continue ;; esac
        if [ -w "$governor_path" ] && printf '%s\n' "$cpu_governor" >"$governor_path" 2>/dev/null; then
            changed=$((changed + 1))
        fi
    done
    printf 'cpu_governor=result-set requested=%s effective=%s fe_policy=%s changed=%s\n' \
        "$cpu_governor" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true)" \
        "${requested_cpu_policy:-none}" "$changed" >>"$root/logs/retroarch-launch.log"
}

restore_cpu_governor() {
    [ -s "$cpu_restore" ] || return 0
    while read -r governor_path old_governor; do
        [ -n "$governor_path" ] || continue
        [ -n "$old_governor" ] || continue
        [ -w "$governor_path" ] || continue
        printf '%s\n' "$old_governor" >"$governor_path" 2>/dev/null || true
    done <"$cpu_restore"
    rm -f "$cpu_restore"
}
cleanup_runtime() {
    restore_cpu_governor
    [ -z "$fast_forward_state" ] || "$bb" rm -f "$fast_forward_state"
}
trap 'cleanup_runtime' EXIT HUP INT TERM
set_cpu_governor

append="$runtime_root/retroarch/append.cfg"
audio_device="${PLUMOS_RETROARCH_AUDIO_DEVICE:-plumos_output}"
if [ -x "$audio_output" ]; then
    "$bb" sh "$audio_output" prepare >>"$root/logs/retroarch-launch.log" 2>&1 || {
        printf 'plumos-retroarch-launch: audio route preparation failed\n' >&2
        exit 1
    }
    export ALSA_CONFIG_PATH="$runtime_root/audio/asound.conf"
    export ALSA_PLUGIN_DIR="$root/lib/alsa-lib"
    export AUDIODEV=plumos_output
    fast_forward_state="$runtime_root/audio/retroarch-fast-forward.$$.state"
    "$bb" rm -f "$fast_forward_state"
    export PLUMOS_AUDIO_FAST_FORWARD_DROP=1
    export PLUMOS_AUDIO_FAST_FORWARD_STATE="$fast_forward_state"
else
    printf 'audio_route=result-fallback reason=router-missing\n' \
        >>"$root/logs/retroarch-launch.log"
    audio_device="${PLUMOS_RETROARCH_AUDIO_DEVICE:-default}"
fi
{
    printf 'audio_driver = "alsa"\n'
    printf 'audio_device = "%s"\n' "$audio_device"
    printf 'audio_latency = "%s"\n' "$audio_latency"
    printf 'video_driver = "drm"\n'
    printf 'video_rotation = "%s"\n' "${PLUMOS_RETROARCH_VIDEO_ROTATION:-3}"
    printf 'video_refresh_rate = "%s"\n' "${PLUMOS_RETROARCH_VIDEO_REFRESH_RATE:-60.000000}"
    printf 'vrr_runloop_enable = "%s"\n' "${PLUMOS_RETROARCH_VRR_RUNLOOP_ENABLE:-false}"
    printf 'video_force_aspect = "true"\n'
    printf 'video_aspect_ratio_auto = "false"\n'
    printf 'aspect_ratio_index = "0"\n'
    printf 'video_aspect_ratio = "1.333333"\n'
    printf 'video_threaded = "true"\n'
    printf 'input_driver = "udev"\n'
    printf 'input_joypad_driver = "udev"\n'
    printf 'joypad_autoconfig_dir = "%s"\n' "$root/factory-defaults/retroarch/autoconfig"
    printf 'input_player1_up_btn = "10"\n'
    printf 'input_player1_down_btn = "11"\n'
    printf 'input_player1_left_btn = "12"\n'
    printf 'input_player1_right_btn = "13"\n'
    printf 'input_player1_left_axis = "-0"\n'
    printf 'input_player1_right_axis = "+0"\n'
    printf 'input_player1_up_axis = "-1"\n'
    printf 'input_player1_down_axis = "+1"\n'
    printf 'input_player1_l_x_minus_axis = "-0"\n'
    printf 'input_player1_l_x_plus_axis = "+0"\n'
    printf 'input_player1_l_y_minus_axis = "-1"\n'
    printf 'input_player1_l_y_plus_axis = "+1"\n'
    printf 'input_player1_analog_dpad_mode = "0"\n'
    printf 'input_menu_toggle_btn = "%s"\n' "${PLUMOS_INPUT_FUNCTION_UDEV_BTN:-14}"
    printf 'config_save_on_exit = "false"\n'
    printf 'savefile_directory = "%s"\n' "$root/saves/$system_id"
    printf 'savestate_directory = "%s"\n' "$root/states/$system_id"
    printf 'system_directory = "%s"\n' "${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}"
} >"$append"

export HOME="$root/state/retroarch/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/state/retroarch/cache"
if [ -z "${ALSA_CONFIG_PATH:-}" ] && [ -s "$alsa_config" ]; then
    export ALSA_CONFIG_PATH="${ALSA_CONFIG_PATH:-$alsa_config}"
fi
export LD_LIBRARY_PATH="$root/emulator/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
$bb mkdir -p "$HOME" "$XDG_CACHE_HOME"
printf 'retroarch=result-start system=%s core=%s rom=%s\n' \
    "$system_id" "${core##*/}" "${rom##*/}" >>"$root/logs/retroarch-launch.log"
set +e
"$root/bin/retroarch" -c "$config" --appendconfig "$append" -L "$core" "$rom" \
    >>"$root/logs/retroarch-launch.log" 2>&1
rc=$?
set -e
$bb rm -f "$append"
[ -z "$fast_forward_state" ] || "$bb" rm -f "$fast_forward_state"
printf 'retroarch=result-exit rc=%s\n' "$rc" >>"$root/logs/retroarch-launch.log"
exit "$rc"
