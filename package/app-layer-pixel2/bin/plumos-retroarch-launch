#!/bin/sh
set -eu

bb=/bin/busybox
root=${PLUMOS_ROOT:-/mnt/plumos}
rom_root=${PLUMOS_ROM_ROOT:-/mnt/plumos-user/roms}
sdcard_root=${PLUMOS_SDCARD_ROOT:-/mnt/plumos-user}
runtime_root=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
input_env=${PLUMOS_INPUT_MAP_ENV:-$root/config/system/input-map.env}
system_id=
core=
rom=
requested_cpu_policy=
audio_latency=${PLUMOS_RETROARCH_AUDIO_LATENCY:-96}
cpu_governor=${PLUMOS_RETROARCH_CPU_GOVERNOR:-}
audio_output="$root/bin/plumos-audio-output"
fast_forward_state=
archive_content=
archive_content_dir=
menu_driver=rgui
graphical_menu=0

export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-$root/emulator/dri}"
export __EGL_VENDOR_LIBRARY_FILENAMES="${__EGL_VENDOR_LIBRARY_FILENAMES:-$root/emulator/egl_vendor.d/50_mesa.json}"
# Some cores (notably EasyRPG) have component-private shared libraries such as
# ICU below lib/libretro.  Include every managed runtime library root instead
# of relying on init's inherited path.
export LD_LIBRARY_PATH="$root/lib/libretro:$root/emulator/lib:$root/frontend/lib:$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if [ -r "$input_env" ]; then
    set -a
    . "$input_env"
    set +a
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        --system) system_id=$2; shift 2 ;;
        --core) core=$2; shift 2 ;;
        --rom) rom=$2; shift 2 ;;
        --cpu) requested_cpu_policy=$2; shift 2 ;;
        --audio-latency) audio_latency=$2; shift 2 ;;
        --audio|--safe-exit) shift 2 ;;
        *) printf 'plumos-retroarch-launch: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done
if [ -z "$cpu_governor" ]; then
    cpu_governor=$requested_cpu_policy
fi
case "$cpu_governor" in
    ''|interactive|performance|ondemand|schedutil|conservative|powersave|userspace) ;;
    *)
        printf 'plumos-retroarch-launch: unsupported CPU governor: %s\n' "$cpu_governor" >&2
        exit 2
        ;;
esac

case "$system_id" in
    ''|*[!A-Za-z0-9._-]*|*..*)
        printf 'plumos-retroarch-launch: invalid system id\n' >&2
        exit 2
        ;;
esac
core_root=$($bb readlink -f "$root/cores")
rom_root=$($bb readlink -f "$rom_root" 2>/dev/null || true)
sdcard_rom_root=$($bb readlink -f "$sdcard_root/roms" 2>/dev/null || true)
default_rom_root=$($bb readlink -f /mnt/plumos-user/roms 2>/dev/null || true)
bind_rom_root=$($bb readlink -f /roms 2>/dev/null || true)
core=$($bb readlink -f "$core")
rom=$($bb readlink -f "$rom")
case "$core" in "$core_root"/*_libretro.so) ;; *) exit 2 ;; esac
rom_allowed=0
for candidate_root in "$rom_root" "$sdcard_rom_root" "$default_rom_root" "$bind_rom_root"; do
    [ -n "$candidate_root" ] || continue
    case "$rom" in "$candidate_root"/*) rom_allowed=1 ;; esac
done
[ "$rom_allowed" = 1 ] || exit 2
[ -f "$core" ] && [ -f "$rom" ] || exit 1

config="$root/config/retroarch/retroarch.cfg"
factory="$root/factory-defaults/retroarch/retroarch.cfg"
core_options="$root/config/retroarch/retroarch-core-options.cfg"
state_root="$root/states/$system_id"
case "${core##*/}" in
    mgba_modern_libretro.so)
        # mGBA savestates are not guaranteed to be compatible across the
        # legacy and modern builds. Battery saves remain shared by system.
        state_root="$state_root/mgba-modern"
        ;;
esac
alsa_config="$root/config/alsa/alsa.conf"
alsa_factory="$root/factory-defaults/alsa/alsa.conf"
$bb mkdir -p "$root/config/retroarch/config" "$root/config/retroarch/remaps" \
    "$root/config/retroarch/playlists/builtin" "$root/config/retroarch/filters/audio" \
    "$root/config/retroarch/filters/video" "$root/config/retroarch/overlays/keyboards" \
    "$root/config/retroarch/records_config" "$root/config/alsa" \
    "$root/saves/$system_id" "$state_root" "$root/logs/retroarch/runtime" \
    "$root/state/retroarch/home" "$root/state/retroarch/cache" \
    "$runtime_root/retroarch" "$runtime_root/cache/retroarch" \
    "$sdcard_root/Screenshots" "$sdcard_root/Recordings" "$sdcard_root/Images/retroarch"
if [ -x "$root/bin/plumos-retroarch-config-merge" ]; then
    "$root/bin/plumos-retroarch-config-merge" >>"$root/logs/retroarch-launch.log" 2>&1
elif [ ! -s "$config" ]; then
    $bb cp "$factory" "$config.next"
    $bb sync
    $bb mv "$config.next" "$config"
fi
if [ ! -s "$alsa_config" ] && [ -s "$alsa_factory" ]; then
    $bb cp "$alsa_factory" "$alsa_config.next"
    $bb sync
    $bb mv "$alsa_config.next" "$alsa_config"
fi

case "$system_id:${core##*/}" in
    arcade:km_mame2003_xtreme_libretro.so)
        "$root/bin/plumos-mame2003-xtreme-config-repair" \
            "$root/config/retroarch/config/MAME 2003-Xtreme/MAME 2003-Xtreme.opt" \
            "$root/state/retroarch/recovery" \
            "disabled" \
            >>"$root/logs/retroarch-launch.log" 2>&1
        ;;
    pc98:np2kai_libretro.so)
        "$root/bin/plumos-np2kai-config-repair" \
            "${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}/np2kai/np2kai.cfg" \
            "$root/state/retroarch/recovery" \
            "$root/config/retroarch/config/Neko Project II kai/Neko Project II kai.opt" \
            "Arrows 3button" \
            >>"$root/logs/retroarch-launch.log" 2>&1
        ;;
esac

menu_driver=$(
    $bb sed -n 's/^[[:space:]]*menu_driver[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$config" | $bb sed -n '1p'
)
case "$menu_driver" in
    glui|ozone|xmb) graphical_menu=1 ;;
    *) graphical_menu=0 ;;
esac

if [ -x "$root/bin/plumos-ensure-udev-input-db" ]; then
    "$root/bin/plumos-ensure-udev-input-db" >>"$root/logs/retroarch-launch.log" 2>&1 || true
fi

cpu_restore="$runtime_root/retroarch/cpu-governors.$$"
set_cpu_governor() {
    [ -n "$cpu_governor" ] || return 0
    : >"$cpu_restore"
    changed=0
    for governor_path in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -e "$governor_path" ] || continue
        old_governor=$(cat "$governor_path" 2>/dev/null || true)
        printf '%s %s\n' "$governor_path" "$old_governor" >>"$cpu_restore"
        available_governors=$(cat "${governor_path%/scaling_governor}/scaling_available_governors" 2>/dev/null || true)
        case " $available_governors " in *" $cpu_governor "*) ;; *) continue ;; esac
        if [ -w "$governor_path" ] && printf '%s\n' "$cpu_governor" >"$governor_path" 2>/dev/null; then
            changed=$((changed + 1))
        fi
    done
    printf 'cpu_governor=result-set requested=%s effective=%s fe_policy=%s changed=%s\n' \
        "$cpu_governor" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true)" \
        "${requested_cpu_policy:-none}" "$changed" >>"$root/logs/retroarch-launch.log"
}

restore_cpu_governor() {
    [ -s "$cpu_restore" ] || return 0
    while read -r governor_path old_governor; do
        [ -n "$governor_path" ] || continue
        [ -n "$old_governor" ] || continue
        [ -w "$governor_path" ] || continue
        printf '%s\n' "$old_governor" >"$governor_path" 2>/dev/null || true
    done <"$cpu_restore"
    rm -f "$cpu_restore"
}
cleanup_runtime() {
    restore_cpu_governor
    [ -z "$fast_forward_state" ] || "$bb" rm -f "$fast_forward_state"
    [ -z "$archive_content" ] || "$bb" rm -f "$archive_content"
    [ -z "$archive_content_dir" ] || "$bb" rmdir "$archive_content_dir" 2>/dev/null || true
}
trap 'cleanup_runtime' EXIT HUP INT TERM
set_cpu_governor

case "$system_id:$rom" in
    gameandwatch:*.zip|gameandwatch:*.ZIP)
        archive_stats=$(
            "$bb" unzip -l "$rom" 2>/dev/null |
                "$bb" awk '
                    $1 ~ /^-+$/ { section++; next }
                    section == 1 && NF >= 4 {
                        files++
                        name = tolower($NF)
                        if (name ~ /\.mgw$/) mgw++
                    }
                    END { print files + 0, mgw + 0 }
                '
        )
        [ "$archive_stats" = "1 1" ] || {
            printf 'plumos-retroarch-launch: Game & Watch ZIP must contain exactly one MGW file\n' >&2
            exit 1
        }
        archive_content_dir="$runtime_root/retroarch/gameandwatch.$$"
        archive_content="$archive_content_dir/content.mgw"
        "$bb" mkdir -p "$archive_content_dir"
        if ! "$bb" unzip -p "$rom" >"$archive_content" ||
           [ ! -s "$archive_content" ]; then
            printf 'plumos-retroarch-launch: cannot extract Game & Watch MGW content\n' >&2
            exit 1
        fi
        rom=$archive_content
        printf 'retroarch_archive=result-extracted system=gameandwatch format=mgw\n' \
            >>"$root/logs/retroarch-launch.log"
        ;;
esac

append="$runtime_root/retroarch/append.cfg"
video_driver=drm
video_allow_rotate=true
video_rotation=${PLUMOS_RETROARCH_VIDEO_ROTATION:-3}
# Do not place the normal aspect selection in append.cfg. RetroArch stores the
# user's choice in the writable main config, and append.cfg has higher
# precedence. Keep this empty unless a hardware/display route has a mandatory
# presentation contract below.
aspect_ratio_index=
if [ "$graphical_menu" = 1 ]; then
    # RGUI can be drawn by the low-overhead plain-DRM path. Graphical menu
    # drivers require GLES, so follow the user's persistent menu_driver choice
    # for game launches as well as the contentless RetroArch app. This keeps
    # RGUI as the fast factory default while making Ozone/XMB/GLUI an explicit
    # user-selected presentation policy.
    video_driver=gl
    video_rotation=1
    export PLUMOS_GL_MENU_ROTATION=display
fi
case "${core##*/}" in
    flycast_libretro.so|\
    flycast_xtreme_libretro.so|\
    km_duckswanstation_xtreme_amped_libretro.so|\
    parallel_n64_libretro.so)
        # Hardware-rendered cores require a real EGL/GLES context. Keep their
        # complete Pixel2 presentation contract together: KMS/GBM GL driver,
        # GL's opposite panel winding, a full portrait scanout which becomes
        # logical 4:3 after rotation, and the same matrix for the RGUI texture.
        video_driver=gl
        video_rotation=1
        aspect_ratio_index=24
        if [ "$graphical_menu" = 1 ]; then
            export PLUMOS_GL_MENU_ROTATION=display
        else
            export PLUMOS_GL_MENU_ROTATION=content
        fi
        ;;
esac
case "$system_id" in
    dreamcast)
        # Dreamcast content is always horizontal. Flycast nevertheless sends
        # SET_ROTATION=0, which would replace Pixel2's user rotation after the
        # GL driver starts. Reject that no-op core request and keep the panel
        # correction selected by video_rotation.
        video_allow_rotate=false
        ;;
    n64|psx)
        # Current Pixel2 GLES routes for these systems are horizontal. Do not
        # let a no-op core rotation replace the fixed panel correction.
        video_allow_rotate=false
        ;;
    wonderswan|wonderswancolor)
        # Match the proven plumOS portrait-panel contract: RetroArch sees an
        # unrotated logical viewport, Beetle WonderSwan performs its own
        # SELECT-controlled content rotation, and DRM applies only the fixed
        # Pixel2 panel correction at final presentation.
        if [ "$graphical_menu" = 1 ]; then
            # The GL driver owns the fixed Pixel2 panel rotation. Allow the
            # core's SELECT-controlled rotation to be composed on top of it.
            video_allow_rotate=true
            video_rotation=1
        else
            video_allow_rotate=false
            video_rotation=0
            export PLUMOS_DRM_PANEL_ROTATION=3
        fi
        # WonderSwan uses a 224x144 (14:9) display and changes geometry when
        # SELECT switches orientation. The global Pixel2 4:3 policy would
        # distort both layouts, so use RetroArch's core-provided aspect entry.
        aspect_ratio_index=22
        ;;
esac
audio_device="${PLUMOS_RETROARCH_AUDIO_DEVICE:-plumos_output}"
if [ -x "$audio_output" ]; then
    "$bb" sh "$audio_output" prepare >>"$root/logs/retroarch-launch.log" 2>&1 || {
        printf 'plumos-retroarch-launch: audio route preparation failed\n' >&2
        exit 1
    }
    export ALSA_CONFIG_PATH="$runtime_root/audio/asound.conf"
    export ALSA_PLUGIN_DIR="$root/lib/alsa-lib"
    export AUDIODEV=plumos_output
    fast_forward_state="$runtime_root/audio/retroarch-fast-forward.$$.state"
    "$bb" rm -f "$fast_forward_state"
    export PLUMOS_AUDIO_FAST_FORWARD_DROP=1
    export PLUMOS_AUDIO_FAST_FORWARD_STATE="$fast_forward_state"
else
    printf 'audio_route=result-fallback reason=router-missing\n' \
        >>"$root/logs/retroarch-launch.log"
    audio_device="${PLUMOS_RETROARCH_AUDIO_DEVICE:-default}"
fi
{
    printf 'audio_driver = "alsa"\n'
    printf 'audio_device = "%s"\n' "$audio_device"
    printf 'audio_latency = "%s"\n' "$audio_latency"
    printf 'video_driver = "%s"\n' "$video_driver"
    printf 'video_rotation = "%s"\n' "$video_rotation"
    printf 'video_allow_rotate = "%s"\n' "$video_allow_rotate"
    printf 'video_refresh_rate = "%s"\n' "${PLUMOS_RETROARCH_VIDEO_REFRESH_RATE:-60.000000}"
    printf 'vrr_runloop_enable = "%s"\n' "${PLUMOS_RETROARCH_VRR_RUNLOOP_ENABLE:-false}"
    [ -z "$aspect_ratio_index" ] ||
        printf 'aspect_ratio_index = "%s"\n' "$aspect_ratio_index"
    printf 'video_threaded = "true"\n'
    printf 'input_driver = "udev"\n'
    printf 'input_joypad_driver = "udev"\n'
    printf 'joypad_autoconfig_dir = "%s"\n' "$root/factory-defaults/retroarch/autoconfig"
    printf 'input_player1_up_btn = "10"\n'
    printf 'input_player1_down_btn = "11"\n'
    printf 'input_player1_left_btn = "12"\n'
    printf 'input_player1_right_btn = "13"\n'
    printf 'input_player1_left_axis = "-0"\n'
    printf 'input_player1_right_axis = "+0"\n'
    printf 'input_player1_up_axis = "-1"\n'
    printf 'input_player1_down_axis = "+1"\n'
    printf 'input_player1_l_x_minus_axis = "-0"\n'
    printf 'input_player1_l_x_plus_axis = "+0"\n'
    printf 'input_player1_l_y_minus_axis = "-1"\n'
    printf 'input_player1_l_y_plus_axis = "+1"\n'
    printf 'input_player1_analog_dpad_mode = "0"\n'
    printf 'input_menu_toggle_btn = "%s"\n' "${PLUMOS_INPUT_FUNCTION_UDEV_BTN:-14}"
    printf 'savefile_directory = "%s"\n' "$root/saves/$system_id"
    printf 'savestate_directory = "%s"\n' "$state_root"
    case "${core##*/}" in
        mgba_modern_libretro.so)
            printf 'savestates_in_content_dir = "false"\n'
            ;;
    esac
    printf 'system_directory = "%s"\n' "${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}"
    printf 'core_options_path = "%s"\n' "$core_options"
} >"$append"

export HOME="$root/state/retroarch/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/state/retroarch/cache"
if [ -z "${ALSA_CONFIG_PATH:-}" ] && [ -s "$alsa_config" ]; then
    export ALSA_CONFIG_PATH="${ALSA_CONFIG_PATH:-$alsa_config}"
fi
export LD_LIBRARY_PATH="$root/lib/libretro:$root/emulator/lib:$root/frontend/lib:$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
$bb mkdir -p "$HOME" "$XDG_CACHE_HOME"
printf 'retroarch=result-start system=%s core=%s rom=%s\n' \
    "$system_id" "${core##*/}" "${rom##*/}" >>"$root/logs/retroarch-launch.log"
set +e
"$root/bin/retroarch" -c "$config" --appendconfig "$append" -L "$core" "$rom" \
    >>"$root/logs/retroarch-launch.log" 2>&1
rc=$?
set -e
$bb rm -f "$append"
[ -z "$fast_forward_state" ] || "$bb" rm -f "$fast_forward_state"
printf 'retroarch=result-exit rc=%s\n' "$rc" >>"$root/logs/retroarch-launch.log"
exit "$rc"
