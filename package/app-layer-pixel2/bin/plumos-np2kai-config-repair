#!/bin/sh
set -eu

bb=${PLUMOS_BUSYBOX:-}
if [ -z "$bb" ] && [ -x /bin/busybox ]; then
    bb=/bin/busybox
fi
bb_run() {
    if [ -n "$bb" ]; then
        "$bb" "$@"
    else
        "$@"
    fi
}
config=${1:-/mnt/plumos-user/bios/np2kai/np2kai.cfg}
recovery_dir=${2:-/mnt/plumos/state/retroarch/recovery}
default_memsw='48 05 04 08 01 00 00 6e'

if [ ! -f "$config" ]; then
    printf 'np2kai_config=result-skip reason=config-missing\n'
    exit 0
fi

# An all-zero PC-98 memory-switch record is not a usable machine setting. It
# was observed after a previously working image began failing in MS-DOS with
# invalid INT 21h. A clean config generated by the same pinned NP2kai core uses
# the value below and boots that identical HDI. Preserve every non-zero value,
# since it may be an intentional user machine configuration.
if ! bb_run grep -Eq \
    '^[[:space:]]*MEMswtch[[:space:]]*=[[:space:]]*00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]*$' \
    "$config"; then
    printf 'np2kai_config=result-valid field=MEMswtch\n'
    exit 0
fi

bb_run mkdir -p "$recovery_dir"
backup="$recovery_dir/np2kai.cfg.before-invalid-memsw-repair"
if [ ! -e "$backup" ]; then
    bb_run cp -p "$config" "$backup"
fi

next="${config}.plumos-repair.$$"
trap 'bb_run rm -f "$next"' EXIT HUP INT TERM
bb_run sed \
    "s/^[[:space:]]*MEMswtch[[:space:]]*=.*/MEMswtch = $default_memsw /" \
    "$config" >"$next"
bb_run chmod --reference="$config" "$next" 2>/dev/null || true
bb_run sync
bb_run mv "$next" "$config"
bb_run sync
trap - EXIT HUP INT TERM

printf 'np2kai_config=result-repaired field=MEMswtch reason=all-zero backup=%s\n' \
    "$backup"
