#!/bin/sh
set -eu

bb=${PLUMOS_BUSYBOX:-}
if [ -z "$bb" ] && [ -x /bin/busybox ]; then
    bb=/bin/busybox
fi
bb_run() {
    if [ -n "$bb" ]; then
        "$bb" "$@"
    else
        "$@"
    fi
}
config=${1:-/mnt/plumos-user/bios/np2kai/np2kai.cfg}
recovery_dir=${2:-/mnt/plumos/state/retroarch/recovery}
core_options=${3:-/mnt/plumos/config/retroarch/config/Neko Project II kai/Neko Project II kai.opt}
default_joymode=${4:-Arrows 3button}
default_memsw='48 05 04 08 01 00 00 6e'

# An all-zero PC-98 memory-switch record is not a usable machine setting. It
# was observed after a previously working image began failing in MS-DOS with
# invalid INT 21h. A clean config generated by the same pinned NP2kai core uses
# the value below and boots that identical HDI. Preserve every non-zero value,
# since it may be an intentional user machine configuration.
if [ ! -f "$config" ]; then
    printf 'np2kai_config=result-skip reason=config-missing\n'
elif bb_run grep -Eq \
    '^[[:space:]]*MEMswtch[[:space:]]*=[[:space:]]*00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]+00[[:space:]]*$' \
    "$config"; then
    bb_run mkdir -p "$recovery_dir"
    backup="$recovery_dir/np2kai.cfg.before-invalid-memsw-repair"
    if [ ! -e "$backup" ]; then
        bb_run cp -p "$config" "$backup"
    fi

    next="${config}.plumos-repair.$$"
    trap 'bb_run rm -f "$next"' EXIT HUP INT TERM
    bb_run sed \
        "s/^[[:space:]]*MEMswtch[[:space:]]*=.*/MEMswtch = $default_memsw /" \
        "$config" >"$next"
    bb_run chmod --reference="$config" "$next" 2>/dev/null || true
    bb_run sync
    bb_run mv "$next" "$config"
    bb_run sync
    trap - EXIT HUP INT TERM

    printf 'np2kai_config=result-repaired field=MEMswtch reason=all-zero backup=%s\n' \
        "$backup"
else
    printf 'np2kai_config=result-valid field=MEMswtch\n'
fi

# RetroArch's per-core .opt file overrides retroarch-core-options.cfg. Older
# Pixel2 builds generated this file with NP2kai's upstream OFF default, so the
# later handheld joy-to-key default never reached the core. Migrate that exact
# stale default once. A non-OFF value is a user selection and must be kept; the
# marker also allows users to deliberately select OFF again after migration.
joymode_marker="$recovery_dir/np2kai-joymode-v1-migrated"
if [ -e "$joymode_marker" ]; then
    printf 'np2kai_config=result-valid field=joymode reason=migration-complete\n'
elif [ ! -f "$core_options" ]; then
    printf 'np2kai_config=result-skip field=joymode reason=core-options-missing\n'
elif bb_run grep -Eq \
    '^[[:space:]]*np2kai_joymode[[:space:]]*=[[:space:]]*"OFF"[[:space:]]*$' \
    "$core_options"; then
    bb_run mkdir -p "$recovery_dir"
    joymode_backup="$recovery_dir/Neko-Project-II-kai.opt.before-joymode-migration"
    if [ ! -e "$joymode_backup" ]; then
        bb_run cp -p "$core_options" "$joymode_backup"
    fi

    joymode_next="${core_options}.plumos-repair.$$"
    trap 'bb_run rm -f "$joymode_next"' EXIT HUP INT TERM
    bb_run sed \
        "s/^[[:space:]]*np2kai_joymode[[:space:]]*=.*/np2kai_joymode = \"$default_joymode\"/" \
        "$core_options" >"$joymode_next"
    bb_run chmod --reference="$core_options" "$joymode_next" 2>/dev/null || true
    bb_run sync
    bb_run mv "$joymode_next" "$core_options"
    : >"$joymode_marker"
    bb_run sync
    trap - EXIT HUP INT TERM

    printf 'np2kai_config=result-repaired field=joymode reason=stale-off value=%s backup=%s\n' \
        "$default_joymode" "$joymode_backup"
else
    bb_run mkdir -p "$recovery_dir"
    : >"$joymode_marker"
    bb_run sync
    printf 'np2kai_config=result-valid field=joymode reason=user-selection-preserved\n'
fi
