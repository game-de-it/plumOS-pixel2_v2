#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
STATE_DIR="${PLUMOS_SSH_PASSWORD_DIR:-$PLUMOS_ROOT/config/ssh}"
SHADOW_FILE="${PLUMOS_SSH_SHADOW_FILE:-$STATE_DIR/shadow}"
SYSTEM_SHADOW="${PLUMOS_SYSTEM_SHADOW:-/etc/shadow}"
BUSYBOX="${PLUMOS_BUSYBOX:-$PLUMOS_ROOT/network/bin/busybox}"
INITIAL_PASSWORD="${PLUMOS_SSH_INITIAL_PASSWORD:-plumos}"

usage() {
  cat <<EOF
Usage: plumos-ssh-password set
       plumos-ssh-password ensure-default
       plumos-ssh-password apply
       plumos-ssh-password status

The set command reads one password line from standard input. The resulting
hash is stored in Pixel2 device-local ext4 state. The ensure-default command
creates the public initial password only when no device-local password exists.
EOF
}

shadow_is_bound() {
  awk -v target="$SYSTEM_SHADOW" '$2 == target { found = 1 } END { exit !found }' \
    /proc/mounts 2>/dev/null
}

valid_shadow() {
  [ -s "$SHADOW_FILE" ] || return 1
  awk -F: '$1 == "root" && $2 ~ /^\$/ { found = 1 } END { exit !found }' \
    "$SHADOW_FILE" 2>/dev/null
}

apply_shadow() {
  valid_shadow || return 1
  chmod 0640 "$SHADOW_FILE" 2>/dev/null || true
  if shadow_is_bound; then
    umount "$SYSTEM_SHADOW" 2>/dev/null || return 1
  fi
  mount --bind "$SHADOW_FILE" "$SYSTEM_SHADOW"
}

write_password() {
  password="$1"
  [ -n "$password" ] || {
    printf 'plumos-ssh-password: empty password refused\n' >&2
    return 2
  }
  [ -x "$BUSYBOX" ] || {
    printf 'plumos-ssh-password: BusyBox is unavailable: %s\n' "$BUSYBOX" >&2
    return 1
  }
  [ -r "$SYSTEM_SHADOW" ] || {
    printf 'plumos-ssh-password: system shadow is unavailable\n' >&2
    return 1
  }

  mkdir -p "$STATE_DIR" || return 1
  chmod 0700 "$STATE_DIR" 2>/dev/null || true
  hash="$(printf '%s' "$password" | "$BUSYBOX" cryptpw -P 0 -m sha512)" || return 1
  unset password
  case "$hash" in
    '$6$'*) ;;
    *)
      printf 'plumos-ssh-password: failed to create SHA-512 hash\n' >&2
      return 1
      ;;
  esac

  base="$SYSTEM_SHADOW"
  [ ! -s "$SHADOW_FILE" ] || base="$SHADOW_FILE"
  tmp="$SHADOW_FILE.tmp.$$"
  awk -F: -v OFS=: -v hash="$hash" '
    $1 == "root" { $2 = hash; changed = 1 }
    { print }
    END { if (!changed) exit 1 }
  ' "$base" > "$tmp" || {
    rm -f "$tmp"
    return 1
  }
  chmod 0640 "$tmp" || {
    rm -f "$tmp"
    return 1
  }
  chown 0:$(stat -c %g "$SYSTEM_SHADOW" 2>/dev/null || printf 0) "$tmp" \
    2>/dev/null || true
  mv -f "$tmp" "$SHADOW_FILE" || {
    rm -f "$tmp"
    return 1
  }
  apply_shadow
  sync "$SHADOW_FILE" 2>/dev/null || sync 2>/dev/null || true
}

set_password() {
  password=""
  IFS= read -r password || true
  write_password "$password"
  unset password
}

ensure_default_password() {
  if [ -e "$SHADOW_FILE" ]; then
    valid_shadow || {
      printf 'plumos-ssh-password: refusing invalid existing shadow: %s\n' \
        "$SHADOW_FILE" >&2
      return 1
    }
    apply_shadow
    return
  fi
  write_password "$INITIAL_PASSWORD"
}

case "${1:-}" in
  set) set_password ;;
  ensure-default) ensure_default_password ;;
  apply)
    [ -e "$SHADOW_FILE" ] || exit 0
    apply_shadow
    ;;
  status)
    if ! valid_shadow; then
      printf 'ssh_password=not_configured\n'
      exit 1
    fi
    if shadow_is_bound; then
      printf 'ssh_password=configured\nshadow=bound\nstorage=%s\n' "$SHADOW_FILE"
    else
      printf 'ssh_password=configured\nshadow=not_bound\nstorage=%s\n' "$SHADOW_FILE"
      exit 2
    fi
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
