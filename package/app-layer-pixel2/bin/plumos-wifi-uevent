#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
RECOVERY_CONTROL="${PLUMOS_ROOT}/bin/plumos-wifi-recovery"
USB_HOST_CONTROL="${PLUMOS_PIXEL2_USB_HOST_CONTROL:-/usr/lib/plumos/init.d/15-usb-host-reenumerate}"
USB_HOST_TRANSITION_MARKER="${PLUMOS_PIXEL2_USB_HOST_TRANSITION_MARKER:-/run/plumos/usb-host-probe-active}"

release_usb_host() {
  [ -x "$USB_HOST_CONTROL" ] || exit 0
  exec "$USB_HOST_CONTROL" release >/dev/null 2>&1
}

release_usb_host_later() {
  [ -x "$USB_HOST_CONTROL" ] || exit 0
  exec "$USB_HOST_CONTROL" release-later >/dev/null 2>&1
}

reconcile_usb_role() {
  [ -x "$USB_HOST_CONTROL" ] || exit 0
  exec "$USB_HOST_CONTROL" reconcile >/dev/null 2>&1
}

case "${ACTION:-}:${SUBSYSTEM:-}" in
  remove:usb)
    # A bounded System probe may intentionally unbind DWC2. Its remove event is
    # not a physical dongle removal and must not switch the PHY back to OTG.
    [ ! -e "$USB_HOST_TRANSITION_MARKER" ] || exit 0
    # The RTL8821CU storage identity disappears once during its intentional
    # eject-based mode switch. Delay that release so the c811 identity can
    # enumerate; a real dongle removal is released immediately.
    case "${PRODUCT:-}" in
      0bda/1a2b/*|0BDA/1A2B/*|bda/1a2b/*|BDA/1A2B/*)
        release_usb_host_later
        ;;
      1d6b/*|1D6B/*)
        exit 0
        ;;
      *)
        release_usb_host
        ;;
    esac
    ;;
  change:extcon)
    reconcile_usb_role
    ;;
  change:power_supply)
    supply="${POWER_SUPPLY_NAME:-}"
    if [ -z "$supply" ] && [ -n "${DEVPATH:-}" ]; then
      supply="${DEVPATH##*/}"
    fi
    case "$supply" in
      usb) reconcile_usb_role ;;
      *) exit 0 ;;
    esac
    ;;
esac

[ "${ACTION:-}" = add ] || exit 0

case "${SUBSYSTEM:-}" in
  net)
    iface="${INTERFACE:-}"
    if [ -z "$iface" ] && [ -n "${DEVPATH:-}" ]; then
      iface="${DEVPATH##*/}"
    fi
    case "$iface" in
      wlan*|mlan*|p2p*) ;;
      *) exit 0 ;;
    esac
    ;;
  usb)
    case "${PRODUCT:-}" in
      0bda/1a2b/*|0BDA/1A2B/*|bda/1a2b/*|BDA/1A2B/*|\
      0bda/c811/*|0BDA/C811/*|bda/c811/*|BDA/C811/*|\
      0bda/c820/*|0BDA/C820/*|bda/c820/*|BDA/C820/*) ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac

[ -x "$RECOVERY_CONTROL" ] || exit 0
exec "$RECOVERY_CONTROL" recover >/dev/null 2>&1
