#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
SYSTEM_SETTINGS="${PLUMOS_SYSTEM_SETTINGS_JSON:-$PLUMOS_ROOT/config/system/settings.json}"
RUNTIME_STATE="${PLUMOS_VOLUME_RUNTIME_STATE:-/run/plumos/volume/current}"
BOOST_RUNTIME_STATE="${PLUMOS_SPEAKER_BOOST_RUNTIME_STATE:-/run/plumos/volume/speaker-boost-step}"
BOOST_SAVED_STATE="${PLUMOS_SPEAKER_BOOST_SAVED_STATE:-$PLUMOS_ROOT/config/system/speaker-boost-step}"
LOG="${PLUMOS_VOLUME_LOG:-/run/plumos/volume/last-apply.log}"
VOLUME_MAX=20
VOLUME_DEFAULT=8
BOOST_STEP_DEFAULT=30

mkdir -p "${RUNTIME_STATE%/*}" "${BOOST_RUNTIME_STATE%/*}" "${LOG%/*}" \
  2>/dev/null || true

usage() {
  printf '%s\n' \
    'Usage: plumos-volume-control init|apply [0..20]|up|down|step +/-N|get|status' \
    '       plumos-volume-control runtime-up|runtime-down|runtime-step +/-N|persist-runtime' \
    '       plumos-volume-control speaker-boost get|apply|runtime 0..15 (0.5 dB steps)'
}

normalize() {
  value="${1:-}"
  case "$value" in ""|*[!0-9]*) return 1 ;; esac
  value="$(printf '%s' "$value" | sed 's/^0*//')"
  [ -n "$value" ] || value=0
  [ "$value" -gt "$VOLUME_MAX" ] && value="$VOLUME_MAX"
  printf '%s\n' "$value"
}

valid_signed_int() {
  value="${1:-}"
  case "$value" in -*) value="${value#-}" ;; esac
  case "$value" in ""|*[!0-9]*) return 1 ;; esac
}

normalize_boost_step() {
  value="${1:-}"
  case "$value" in ""|*[!0-9]*) return 1 ;; esac
  value="$(printf '%s' "$value" | sed 's/^0*//')"
  [ -n "$value" ] || value=0
  [ "$value" -le 30 ] || return 1
  printf '%s\n' "$value"
}

boost_db_to_step() {
  value="${1:-}"
  half=0
  case "$value" in
    *.5) half=1; value="${value%.5}" ;;
    *.0) value="${value%.0}" ;;
    *.*) return 1 ;;
  esac
  case "$value" in ""|*[!0-9]*) return 1 ;; esac
  value="$(printf '%s' "$value" | sed 's/^0*//')"
  [ -n "$value" ] || value=0
  [ "$value" -le 15 ] || return 1
  [ "$half" -eq 0 ] || [ "$value" -lt 15 ] || return 1
  printf '%s\n' $((value * 2 + half))
}

boost_step_to_db() {
  step="$(normalize_boost_step "$1")" || step="$BOOST_STEP_DEFAULT"
  whole=$((step / 2))
  if [ $((step % 2)) -eq 0 ]; then
    printf '%s.0\n' "$whole"
  else
    printf '%s.5\n' "$whole"
  fi
}

read_boost_saved() {
  step=""
  if [ -r "$BOOST_SAVED_STATE" ]; then
    step="$(sed -n '1s/^\([0-9][0-9]*\).*$/\1/p' "$BOOST_SAVED_STATE" 2>/dev/null)"
  fi
  normalize_boost_step "${step:-$BOOST_STEP_DEFAULT}" || \
    printf '%s\n' "$BOOST_STEP_DEFAULT"
}

read_boost_runtime() {
  step=""
  if [ -r "$BOOST_RUNTIME_STATE" ]; then
    step="$(sed -n '1s/^\([0-9][0-9]*\).*$/\1/p' "$BOOST_RUNTIME_STATE" 2>/dev/null)"
  fi
  case "$step" in
    ""|*[!0-9]*) read_boost_saved ;;
    *) normalize_boost_step "$step" || read_boost_saved ;;
  esac
}

write_boost_runtime() {
  step="$(normalize_boost_step "$1")" || return 2
  tmp="$BOOST_RUNTIME_STATE.tmp.$$"
  printf '%s\n' "$step" >"$tmp" && mv -f "$tmp" "$BOOST_RUNTIME_STATE" || {
    rm -f "$tmp"
    return 1
  }
}

write_boost_saved() {
  step="$(normalize_boost_step "$1")" || return 2
  mkdir -p "${BOOST_SAVED_STATE%/*}" || return 1
  tmp="$BOOST_SAVED_STATE.tmp.$$"
  printf '%s\n' "$step" >"$tmp" && mv -f "$tmp" "$BOOST_SAVED_STATE" || {
    rm -f "$tmp"
    return 1
  }
}

ensure_boost_runtime() {
  [ -r "$BOOST_RUNTIME_STATE" ] || write_boost_runtime "$(read_boost_saved)"
}

apply_speaker_boost() {
  persist="$1"
  step="$(boost_db_to_step "$2")" || return 2
  [ "$persist" -eq 0 ] || write_boost_saved "$step" || return 1
  write_boost_runtime "$step" || return 1
  [ "$persist" -eq 0 ] || sync
}

read_saved() {
  value=""
  if [ -r "$SYSTEM_SETTINGS" ]; then
    value="$(sed -n 's/.*"volume"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
      "$SYSTEM_SETTINGS" 2>/dev/null | head -n 1)"
  fi
  normalize "${value:-$VOLUME_DEFAULT}" || printf '%s\n' "$VOLUME_DEFAULT"
}

read_runtime() {
  value=""
  if [ -r "$RUNTIME_STATE" ]; then
    value="$(sed -n '1s/^\([0-9][0-9]*\).*$/\1/p' "$RUNTIME_STATE" 2>/dev/null)"
  fi
  case "$value" in ""|*[!0-9]*) read_saved ;; *) normalize "$value" ;; esac
}

write_runtime() {
  volume="$(normalize "$1")" || return 2
  tmp="$RUNTIME_STATE.tmp.$$"
  printf '%s\n' "$volume" >"$tmp" && mv -f "$tmp" "$RUNTIME_STATE" || {
    rm -f "$tmp"
    return 1
  }
}

write_saved() {
  volume="$(normalize "$1")" || return 2
  mkdir -p "${SYSTEM_SETTINGS%/*}" || return 1
  tmp="$SYSTEM_SETTINGS.tmp.$$"
  if [ -r "$SYSTEM_SETTINGS" ] &&
     grep -q '"volume"[[:space:]]*:' "$SYSTEM_SETTINGS" 2>/dev/null; then
    sed 's/"volume"[[:space:]]*:[[:space:]]*[0-9][0-9]*/"volume": '"$volume"'/' \
      "$SYSTEM_SETTINGS" >"$tmp" || {
        rm -f "$tmp"
        return 1
      }
  elif [ -r "$SYSTEM_SETTINGS" ]; then
    awk -v volume="$volume" '
      BEGIN { inserted = 0; previous = "" }
      {
        if (!inserted && $0 ~ /^[[:space:]]*}[[:space:]]*$/) {
          if (previous != "") {
            sub(/[[:space:]]*$/, "", previous)
            if (previous !~ /,[[:space:]]*$/) previous = previous ","
            print previous
            previous = ""
          }
          print "  \"volume\": " volume
          inserted = 1
        }
        if (previous != "") print previous
        previous = $0
      }
      END { if (previous != "") print previous }
    ' "$SYSTEM_SETTINGS" >"$tmp" || {
      rm -f "$tmp"
      return 1
    }
  else
    {
      printf '{\n'
      printf '  "version": 1,\n'
      printf '  "volume": %s\n' "$volume"
      printf '}\n'
    } >"$tmp" || {
      rm -f "$tmp"
      return 1
    }
  fi
  mv -f "$tmp" "$SYSTEM_SETTINGS"
}

apply_volume() {
  volume="$(normalize "${1:-$(read_runtime)}")" || return 2
  write_runtime "$volume" || return 1
  ensure_boost_runtime || return 1
  {
    printf 'backend=pixel2-state-only\n'
    printf 'volume=%s\n' "$volume"
    printf 'speaker_boost_db=%s\n' "$(boost_step_to_db "$(read_boost_runtime)")"
    printf 'note=RK817 mixer command backend is not packaged yet\n'
  } >"$LOG"
}

change_saved() {
  current="$(read_saved)"
  delta="$1"
  next=$((current + delta))
  [ "$next" -lt 0 ] && next=0
  [ "$next" -gt "$VOLUME_MAX" ] && next="$VOLUME_MAX"
  write_saved "$next" && apply_volume "$next"
}

change_runtime() {
  current="$(read_runtime)"
  delta="$1"
  next=$((current + delta))
  [ "$next" -lt 0 ] && next=0
  [ "$next" -gt "$VOLUME_MAX" ] && next="$VOLUME_MAX"
  apply_volume "$next"
}

case "${1:-}" in
  init) apply_volume "$(read_runtime)" ;;
  apply) apply_volume "${2:-$(read_runtime)}" ;;
  up) change_saved 1 ;;
  down) change_saved -1 ;;
  step)
    [ "$#" -eq 2 ] && valid_signed_int "$2" || { usage >&2; exit 2; }
    change_saved "$2"
    ;;
  runtime-up) change_runtime 1 ;;
  runtime-down) change_runtime -1 ;;
  runtime-step)
    [ "$#" -eq 2 ] && valid_signed_int "$2" || { usage >&2; exit 2; }
    change_runtime "$2"
    ;;
  persist-runtime)
    volume="$(read_runtime)"
    write_saved "$volume"
    sync
    ;;
  get) read_saved ;;
  status)
    printf 'backend=pixel2-state-only\n'
    printf 'volume=%s\n' "$(read_runtime)"
    printf 'speaker_boost_db=%s\n' "$(boost_step_to_db "$(read_boost_runtime)")"
    printf 'alsa_card='
    sed -n '1p' /proc/asound/card0/id 2>/dev/null || printf 'unknown\n'
    ;;
  speaker-boost)
    case "${2:-}" in
      get) boost_step_to_db "$(read_boost_runtime)" ;;
      apply)
        [ "$#" -eq 3 ] && apply_speaker_boost 1 "$3" || {
          usage >&2
          exit 2
        }
        ;;
      runtime)
        [ "$#" -eq 3 ] && apply_speaker_boost 0 "$3" || {
          usage >&2
          exit 2
        }
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
