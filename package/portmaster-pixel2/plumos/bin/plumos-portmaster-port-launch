#!/bin/sh
set -u

if [ "${PLUMOS_PORTMASTER_PORT_BUSYBOX_REEXEC:-0}" != 1 ]; then
  early_busybox="${PLUMOS_BUSYBOX:-/mnt/plumos-user/.tmp_update/busybox}"
  if [ -x "$early_busybox" ]; then
    export PLUMOS_PORTMASTER_PORT_BUSYBOX_REEXEC=1
    exec "$early_busybox" sh "$0" "$@"
  fi
fi

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
PLUMOS_SDCARD_ROOT="${PLUMOS_SDCARD_ROOT:-/mnt/plumos-user}"
PLUMOS_ROM_ROOT="${PLUMOS_ROM_ROOT:-$PLUMOS_SDCARD_ROOT/roms}"
RUN_ROOT="${PLUMOS_PORTMASTER_RUN_ROOT:-/run/plumos/portmaster}"
BB="${PLUMOS_BUSYBOX:-/mnt/plumos-user/.tmp_update/busybox}"
APP_ROOT="${PLUMOS_PORTMASTER_APP_ROOT:-${PLUMOS_ROOT}/apps/portmaster}"
LIB_DIR="${RUN_ROOT}/lib"
ROMS_ROOT="${PLUMOS_ROM_ROOT}"
STATE_ROOT="${PLUMOS_ROOT}/state/portmaster"
DATA_ROOT="${PLUMOS_PORTMASTER_DATA_ROOT:-${STATE_ROOT}/data}"
PM_DIR="${DATA_ROOT}/upstream/PortMaster"
LOG_FILE="${PLUMOS_ROOT}/logs/apps/portmaster-ports.log"
PID_FILE="${RUN_ROOT}/port.pid"
START_FILE="${RUN_ROOT}/port.starttime"
SCRIPT_FILE="${RUN_ROOT}/port.script"
MOUNTS_FILE="${RUN_ROOT}/port.mounts"
DRI_DIR="${RUN_ROOT}/dri"
PORT_BASH="${APP_ROOT}/adapter/bin/aarch64/bash"
SDL_ROTATE_LIB="${APP_ROOT}/adapter/lib/aarch64/libplumos-portmaster-sdl-rotate.so"
GL_ROTATE_LIB="${APP_ROOT}/adapter/lib/aarch64/libplumos-portmaster-gl-rotate.so"
child=""
restore_frontend=0
script="${1:-}"
[ -n "$script" ] || { printf 'usage: plumOS-portmaster-port-launch SCRIPT [ARGS...]\n' >&2; exit 64; }
shift
[ -x "$BB" ] || BB=/bin/busybox
resolved_roms_root="$(readlink -f "$ROMS_ROOT" 2>/dev/null || true)"
[ -n "$resolved_roms_root" ] && ROMS_ROOT="$resolved_roms_root"
script="$(readlink -f "$script" 2>/dev/null || true)"

# Pixel2 mounts the same FAT32 ROM filesystem at both /roms and
# /mnt/plumos-user/roms.  readlink cannot collapse bind-mount aliases, so a FE
# path under the latter used to fail the string-only ownership check when
# PLUMOS_ROM_ROOT was /roms.  Accept only aliases whose root and final script
# are the same filesystem objects, then rewrite to the configured root.  This
# keeps the path traversal boundary and gives the stop helper one canonical
# ownership form.
script_accepted=0
for root_alias in \
  "$ROMS_ROOT" \
  "${PLUMOS_SDCARD_ROOT%/}/roms" \
  /mnt/plumos-user/roms \
  /roms; do
  resolved_alias="$(readlink -f "$root_alias" 2>/dev/null || true)"
  [ -n "$resolved_alias" ] || continue
  [ "$resolved_alias" -ef "$ROMS_ROOT" ] 2>/dev/null || continue
  case "$script" in
    "${resolved_alias}"/[Pp][Oo][Rr][Tt][Ss]/*.sh)
      port_path="${script#"${resolved_alias}"/}"
      port_relative="${port_path#*/}"
      case "$port_relative" in
        */*)
          printf 'refusing nested PortMaster helper script: %s\n' "$script" >&2
          exit 64
          ;;
      esac
      canonical_script="${ROMS_ROOT}/${port_path}"
      [ "$canonical_script" -ef "$script" ] 2>/dev/null || continue
      script="$canonical_script"
      PORTS_ROOT="${script%/*}"
      script_accepted=1
      break
      ;;
  esac
done
[ "$script_accepted" -eq 1 ] || {
  printf 'refusing script outside %s/ports: %s\n' "$ROMS_ROOT" "$script" >&2
  exit 64
}
[ -f "$script" ] || { printf 'missing PortMaster script: %s\n' "$script" >&2; exit 127; }

prepare_content_alias() {
  content_root="${RUN_ROOT}/content"
  ports_alias="${content_root}/ports"
  mkdir -p "$content_root"
  if [ -e "$ports_alias" ] && [ ! -L "$ports_alias" ]; then
    printf 'PortMaster runtime content alias is obstructed: %s\n' \
      "$ports_alias" >&2
    return 1
  fi
  rm -f "$ports_alias"
  ln -s "$PORTS_ROOT" "$ports_alias"
  PLUMOS_PORTMASTER_DIRECTORY="${content_root#/}"
  export PLUMOS_PORTMASTER_DIRECTORY
}

prepare_content_alias || exit 1

frontend_is_ancestor() {
  parent=$PPID
  count=0
  while [ "$parent" -gt 1 ] 2>/dev/null && [ "$count" -lt 16 ]; do
    cmdline="$(tr '\000' ' ' < "/proc/${parent}/cmdline" 2>/dev/null || true)"
    case "$cmdline" in
      *plumos-controller-ui-pixel2*|*plumos-controller-ui-fbdev*) return 0 ;;
    esac
    parent="$(sed 's/.*) //' "/proc/${parent}/stat" 2>/dev/null | awk '{print $2}' || true)"
    case "$parent" in ''|*[!0-9]*) return 1 ;; esac
    count=$((count + 1))
  done
  return 1
}

frontend_running() {
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-frontend-stop" status 2>/dev/null | grep -q 'pid='
}

is_mounted() {
  awk -v path="$1" \
    'tolower($5) == tolower(path) { found=1 } END { exit !found }' \
    /proc/self/mountinfo
}

cleanup() {
  if [ -n "$child" ]; then
    recorded="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ "$recorded" = "$child" ]; then
      kill -TERM "-$child" 2>/dev/null || true
      for _ in 1 2 3 4 5; do
        kill -0 "-$child" 2>/dev/null || break
        sleep 1
      done
      kill -KILL "-$child" 2>/dev/null || true
    fi
  fi
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-portmaster-gptokeyb-stop" stop 2>/dev/null || true
  if [ -f "$MOUNTS_FILE" ]; then
    sed '1!G;h;$!d' "$MOUNTS_FILE" 2>/dev/null | while IFS= read -r target; do
      [ -n "$target" ] || continue
      is_mounted "$target" && umount "$target" 2>/dev/null || true
    done
  fi
  rm -f "$PID_FILE" "$START_FILE" "$SCRIPT_FILE" "$MOUNTS_FILE"
  if [ "$restore_frontend" -eq 1 ] && ! frontend_running; then
    "$BB" setsid "$BB" sh "${PLUMOS_ROOT}/bin/plumos-frontend-launch" \
      >/dev/null 2>&1 </dev/null &
  fi
}

trap cleanup EXIT HUP INT TERM

prepare_compat_mount() {
  compat_target=/usr/lib/compat

  [ -d "$compat_target" ] || return 0

  if is_mounted "$compat_target"; then
    printf 'PortMaster has a stale compatibility mount: %s\n' "$compat_target" >&2
    return 1
  fi
  mount --bind "$LIB_DIR" "$compat_target" || {
    printf 'PortMaster cannot bind the compatibility runtime: %s\n' "$compat_target" >&2
    return 1
  }
  printf '%s\n' "$compat_target" >> "$MOUNTS_FILE"
}

prepare_patcher_compat() {
  patcher_target="${PM_DIR}/utils/patcher.txt"
  patcher_override="${PLUMOS_PORTMASTER_PATCHER_OVERRIDE:-${APP_ROOT}/adapter/overrides/patcher.txt}"
  main_target="${PM_DIR}/utils/patcher/main.lua"
  main_override="${RUN_ROOT}/patcher-main.lua"
  talkies_target="${PM_DIR}/utils/patcher/talkies.lua"
  talkies_override="${RUN_ROOT}/patcher-talkies.lua"
  font_size_line='local fontSize = 16'
  box_y_line='  local boxY = windowHeight-(boxH+currentDialog.padding)'
  dialog_height_line='  height                  = nil,'

  for required in \
    "$patcher_target" "$patcher_override" "$main_target" "$talkies_target"; do
    [ -f "$required" ] || {
      printf 'PortMaster patcher compatibility file is missing: %s\n' \
        "$required" >&2
      return 1
    }
  done
  if is_mounted "$patcher_target" || is_mounted "$main_target" ||
     is_mounted "$talkies_target"; then
    printf 'PortMaster has a stale patcher compatibility mount\n' >&2
    return 1
  fi
  [ "$(grep -Fxc "$box_y_line" "$talkies_target")" -eq 1 ] || {
    printf 'PortMaster patcher dialog layout is unsupported: %s\n' \
      "$talkies_target" >&2
    return 1
  }
  [ "$(grep -Fxc "$dialog_height_line" "$talkies_target")" -eq 1 ] || {
    printf 'PortMaster patcher dialog height layout is unsupported: %s\n' \
      "$talkies_target" >&2
    return 1
  }
  [ "$(grep -Fxc "$font_size_line" "$main_target")" -eq 1 ] || {
    printf 'PortMaster patcher font layout is unsupported: %s\n' \
      "$main_target" >&2
    return 1
  }

  # Enlarge the upstream 16 px dialog font for Pixel2's compact LCD.  Give the
  # wrapped text a 128 px box and keep its lowest row clear of the panel edge.
  sed "s/${font_size_line}/local fontSize = 24/" \
    "$main_target" > "$main_override" || return 1
  grep -Fq 'local fontSize = 24' "$main_override" || return 1
  sed \
    -e "s/${box_y_line}/${box_y_line}-12/" \
    -e "s/${dialog_height_line}/  height                  = 128,/" \
    "$talkies_target" > "$talkies_override" || return 1
  grep -Fq "${box_y_line}-12" "$talkies_override" || return 1
  grep -Fq '  height                  = 128,' \
    "$talkies_override" || return 1

  mount --bind "$patcher_override" "$patcher_target" || return 1
  printf '%s\n' "$patcher_target" >> "$MOUNTS_FILE"
  mount --bind "$main_override" "$main_target" || return 1
  printf '%s\n' "$main_target" >> "$MOUNTS_FILE"
  mount --bind "$talkies_override" "$talkies_target" || return 1
  printf '%s\n' "$talkies_target" >> "$MOUNTS_FILE"
}

patch_known_port_runtime_path() {
  case "$(basename "$script" | tr '[:upper:]' '[:lower:]')" in
    'moonlight new.sh') ;;
    *) return 0 ;;
  esac

  gui_file="$(dirname "$script")/moonlightnew/gui/main.lua"
  old_path='LD_LIBRARY_PATH=%s/moonlight/libs:/usr/lib/compat'
  interim_path='LD_LIBRARY_PATH=%s/moonlight/libs:/run/plumos/portmaster/lib:/usr/lib/compat'
  new_path='LD_LIBRARY_PATH=%s/moonlight/libs:/usr/lib/compat:${LD_LIBRARY_PATH:-}'
  [ -f "$gui_file" ] || {
    printf 'PortMaster Moonlight GUI is missing: %s\n' "$gui_file" >&2
    return 1
  }
  grep -Fq "$new_path" "$gui_file" && return 0
  if grep -Fq "$old_path" "$gui_file"; then
    source_path="$old_path"
  elif grep -Fq "$interim_path" "$gui_file"; then
    source_path="$interim_path"
  else
    printf 'PortMaster Moonlight GUI has an unknown runtime-path contract: %s\n' "$gui_file" >&2
    return 1
  fi

  temp_file="${gui_file}.plumos.$$"
  sed "s#${source_path}#${new_path}#" "$gui_file" > "$temp_file" || {
    rm -f "$temp_file"
    return 1
  }
  mv -f "$temp_file" "$gui_file" || {
    rm -f "$temp_file"
    return 1
  }
  sync "$gui_file" 2>/dev/null || sync
}

port_requires_armhf() {
  grep -Eq "^[[:space:]]*(export[[:space:]]+)?PORT_32BIT[[:space:]]*=[[:space:]]*['\"]?[Yy]" "$script"
}

if port_requires_armhf; then
  mkdir -p "$(dirname "$LOG_FILE")"
  message="PortMaster ARMHF port is not supported by the Pixel2 app layer: $(basename "$script")"
  printf '%s\n' "$message" >&2
  printf '\n[%s] unsupported_armhf script=%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$script" >> "$LOG_FILE"
  exit 78
fi

[ -x "$PORT_BASH" ] || {
  printf 'PortMaster bash runtime is missing: %s\n' "$PORT_BASH" >&2
  exit 127
}

if [ -f "$PID_FILE" ]; then
  old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -d "/proc/${old_pid}" ]; then
    printf 'PortMaster port is already running: pid=%s\n' "$old_pid" >&2
    exit 75
  fi
  rm -f "$PID_FILE" "$START_FILE" "$SCRIPT_FILE"
fi

"$BB" sh "${PLUMOS_ROOT}/bin/plumos-portmaster-runtime" prepare >/dev/null || exit 1
mkdir -p "$RUN_ROOT" "$DRI_DIR" "$(dirname "$LOG_FILE")" "$STATE_ROOT/home"
if [ -f "${PLUMOS_ROOT}/emulator/dri/rockchip_dri.so" ]; then
  ln -sf "${PLUMOS_ROOT}/emulator/dri/rockchip_dri.so" \
    "${DRI_DIR}/rockchip_dri.so"
fi
audio_output="${PLUMOS_ROOT}/bin/plumos-audio-output"
[ -x "$audio_output" ] || {
  printf 'plumos-portmaster-port-launch: audio router is missing\n' >&2
  exit 1
}
"$BB" sh "$audio_output" prepare >>"$LOG_FILE" 2>&1 || {
  printf 'plumos-portmaster-port-launch: audio route preparation failed\n' >&2
  exit 1
}
audio_status="$(tr '\n' ' ' </run/plumos/audio/output.status)"
if [ -x "${PLUMOS_ROOT}/bin/plumos-volume-control" ]; then
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-volume-control" apply \
    >>"$LOG_FILE" 2>&1 || true
fi
: > "$MOUNTS_FILE"
patch_known_port_runtime_path || exit 1
prepare_compat_mount || exit 1
prepare_patcher_compat || exit 1
for name in config libs themes; do
  source_dir="${STATE_ROOT}/${name}"
  target_dir="${PM_DIR}/${name}"
  mkdir -p "$source_dir" "$target_dir"
  if is_mounted "$target_dir"; then
    printf 'PortMaster port has a stale state mount: %s\n' "$target_dir" >&2
    exit 1
  fi
  mount --bind "$source_dir" "$target_dir" || exit 1
  printf '%s\n' "$target_dir" >> "$MOUNTS_FILE"
done
export PLUMOS_ROOT PLUMOS_RUNTIME_ROOT="/run/plumos"
export PLUMOS_PORTMASTER_APP_ROOT="$APP_ROOT"
export PLUMOS_PORTMASTER_DATA_ROOT="$DATA_ROOT"
export PLUMOS_PORTMASTER_MOUNTS_FILE="$MOUNTS_FILE"
export PORT_BASH
export HOME="${STATE_ROOT}/home"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${RUN_ROOT}/cache"
export XDG_DATA_HOME="${DATA_ROOT}/upstream"
export HM_TOOLS_DIR="${DATA_ROOT}/upstream"
export HM_PORTS_DIR="$PORTS_ROOT"
export HM_SCRIPTS_DIR="$PORTS_ROOT"
export PATH="${APP_ROOT}/adapter/shims:${RUN_ROOT}/busybox-bin:${APP_ROOT}/adapter/bin/aarch64:${PLUMOS_ROOT}/bin:${PATH}"
export LD_LIBRARY_PATH="${RUN_ROOT}/lib:${PLUMOS_ROOT}/apps/pyxel/lib:${PLUMOS_ROOT}/apps/python/lib:${PLUMOS_ROOT}/lib:${PLUMOS_ROOT}/apps/nextcommander/lib:${PLUMOS_ROOT}/emulator/lib:${PLUMOS_ROOT}/apps/pyxel/site/pygame.libs:${LD_LIBRARY_PATH:-}"
export PYSDL2_DLL_PATH="${RUN_ROOT}/lib"
export SDL_VIDEODRIVER="kmsdrm"
export SDL_RENDER_DRIVER="opengles2"
export SDL_AUDIODRIVER="alsa"
export ALSOFT_DRIVERS="alsa"
# Balatro's OpenAL runtime opens ALSA default and waits on its poll descriptor
# before the first write.  Use the selected physical PCM descriptors here;
# the stable Pixel2 SDL hotplug proxy would otherwise leave OpenAL PREPARED.
export PLUMOS_AUDIO_POLL_PROXY=0
export ALSA_CONFIG_PATH="/run/plumos/audio/asound.conf"
export ALSA_PLUGIN_DIR="${PLUMOS_ROOT}/lib/alsa-lib"
export SDL_GAMECONTROLLERCONFIG_FILE="${RUN_ROOT}/gamecontrollerdb.txt"
export SDL_GAMECONTROLLERCONFIG="$(cat "$SDL_GAMECONTROLLERCONFIG_FILE")"
export AUDIODEV="plumos_output"
export SDL_VIDEO_KMSDRM_DEVICE_INDEX="${SDL_VIDEO_KMSDRM_DEVICE_INDEX:-0}"
export SDL_VIDEO_EGL_DRIVER="${SDL_VIDEO_EGL_DRIVER:-${PLUMOS_ROOT}/apps/pyxel/lib/libEGL.so.1}"
export SDL_VIDEO_GL_DRIVER="${SDL_VIDEO_GL_DRIVER:-${PLUMOS_ROOT}/apps/pyxel/lib/libGLESv2.so.2}"
export LIBGL_DRIVERS_PATH="${DRI_DIR}"
export __EGL_VENDOR_LIBRARY_FILENAMES="${__EGL_VENDOR_LIBRARY_FILENAMES:-${PLUMOS_ROOT}/emulator/egl_vendor.d/50_mesa.json}"
unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE
export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-true}"
[ -r "$SDL_ROTATE_LIB" ] || {
  printf 'PortMaster Pixel2 SDL rotation library is missing: %s\n' "$SDL_ROTATE_LIB" >&2
  exit 127
}
[ -r "$GL_ROTATE_LIB" ] || {
  printf 'PortMaster Pixel2 GL rotation library is missing: %s\n' "$GL_ROTATE_LIB" >&2
  exit 127
}
export PLUMOS_PORTMASTER_SDL_ROTATION=270
export PLUMOS_PORTMASTER_GL_ROTATION=270
export LD_PRELOAD="${SDL_ROTATE_LIB}:${GL_ROTATE_LIB}${LD_PRELOAD:+:${LD_PRELOAD}}"
mkdir -p "$XDG_CACHE_HOME" "$HM_PORTS_DIR"

if ! frontend_is_ancestor && frontend_running; then
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-frontend-stop" stop >> "$LOG_FILE" 2>&1
  restore_frontend=1
fi

printf '\n[%s] script=%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$script" \
  "$(printf '%s' "$audio_status" | tr '\n' ' ')" >> "$LOG_FILE"
setsid "$PORT_BASH" "$script" "$@" >> "$LOG_FILE" 2>&1 &
child=$!
printf '%s\n' "$child" > "$PID_FILE"
sed 's/.*) //' "/proc/${child}/stat" | awk '{print $20}' > "$START_FILE"
printf '%s\n' "$script" > "$SCRIPT_FILE"
wait "$child"
rc=$?
exit "$rc"
