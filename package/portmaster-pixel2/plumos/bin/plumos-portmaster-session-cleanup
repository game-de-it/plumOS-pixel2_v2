#!/bin/sh
set -u

session_id="${PLUMOS_PORTMASTER_SESSION_ID:-}"
proc_root="${PLUMOS_PORTMASTER_PROC_ROOT:-/proc}"
kill_bin="${PLUMOS_PORTMASTER_KILL_BIN:-kill}"
sleep_bin="${PLUMOS_PORTMASTER_SLEEP_BIN:-sleep}"
log_file="${PLUMOS_PORTMASTER_SESSION_LOG:-}"
cleanup_pid="${PLUMOS_PORTMASTER_CLEANUP_PID:-$$}"

[ -n "$session_id" ] || exit 0

# Keep the captured identity for matching existing port processes, but give
# tr/grep/date/sleep/kill helpers started by this cleanup a different identity.
# A helper can otherwise appear in the next /proc pass and be reported as a
# newly remaining port process.
PLUMOS_PORTMASTER_SESSION_ID="cleanup:${session_id}"
export PLUMOS_PORTMASTER_SESSION_ID

log_event() {
  [ -n "$log_file" ] || return 0
  printf '[%s] session-cleanup id=%s %s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$session_id" "$*" >> "$log_file"
}

pid_is_cleanup_descendant() {
  current=$1
  depth=0
  while [ "$depth" -lt 32 ]; do
    [ "$current" = "$cleanup_pid" ] && return 0
    [ -r "$proc_root/$current/status" ] || return 1
    parent=""
    while IFS=: read -r key value; do
      [ "$key" = PPid ] || continue
      set -- $value
      parent=${1:-}
      break
    done < "$proc_root/$current/status"
    case "$parent" in ''|0|*[!0-9]*) return 1 ;; esac
    current=$parent
    depth=$((depth + 1))
  done
  return 1
}

pid_has_session() {
  pid=$1
  [ "$pid" != "$$" ] || return 1
  pid_is_cleanup_descendant "$pid" && return 1
  [ -r "$proc_root/$pid/environ" ] || return 1
  tr '\000' '\n' < "$proc_root/$pid/environ" 2>/dev/null |
    grep -Fqx "PLUMOS_PORTMASTER_SESSION_ID=$session_id"
}

session_pids() {
  for status in "$proc_root"/[0-9]*/status; do
    [ -f "$status" ] || continue
    pid=${status%/status}
    pid=${pid##*/}
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    pid_has_session "$pid" && printf '%s\n' "$pid"
  done
}

signal_session() {
  signal=$1
  found=0
  session_pids | while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    # Recheck immediately before signalling to avoid a PID reuse race.
    pid_has_session "$pid" || continue
    "$kill_bin" "-$signal" "$pid" 2>/dev/null || true
    log_event "signal=$signal pid=$pid"
    found=1
  done
  return "$found"
}

signal_session TERM || true
for _ in 1 2; do
  [ -z "$(session_pids)" ] && break
  "$sleep_bin" 1
done
signal_session KILL || true
for _ in 1 2 3; do
  [ -z "$(session_pids)" ] && break
  "$sleep_bin" 1
done
remaining="$(session_pids | tr '\n' ' ')"
if [ -n "$remaining" ]; then
  log_event "result=remaining pids=$remaining"
  exit 1
fi
log_event "result=clean"
