--- a/system/core/adb/adb.cpp
+++ b/system/core/adb/adb.cpp
@@ -79,15 +79,35 @@ void put_apacket(apacket *p)
     delete p;
 }
 
+#if !ADB_HOST
+static void plumos_write_transport_state(const char* state) {
+    const char* path = getenv("PLUMOS_ADBD_TRANSPORT_STATE");
+    if (path == nullptr || path[0] == '\0') {
+        path = "/run/plumos/adbd-transport.state";
+    }
+    std::string value(state);
+    value += "\n";
+    if (!android::base::WriteStringToFile(value, path)) {
+        PLOG(WARNING) << "cannot write plumOS ADB transport state to " << path;
+    }
+}
+#endif
+
 void handle_online(atransport *t)
 {
     D("adb: online");
+#if !ADB_HOST
+    plumos_write_transport_state("online");
+#endif
     t->online = 1;
     t->SetConnectionEstablished(true);
 }
 
 void handle_offline(atransport *t)
 {
+#if !ADB_HOST
+    plumos_write_transport_state("offline");
+#endif
     if (t->GetConnectionState() == kCsOffline) {
         LOG(INFO) << t->serial_name() << ": already offline";
         return;
