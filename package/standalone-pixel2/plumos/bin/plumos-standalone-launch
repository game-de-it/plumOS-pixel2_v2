#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
PLUMOS_RUNTIME_ROOT="${PLUMOS_RUNTIME_ROOT:-/run/plumos}"
PLUMOS_USER_ROOT="${PLUMOS_USER_ROOT:-/mnt/plumos-user}"
EMU_ROOT="${PLUMOS_ROOT}/standalone"
LOG_ROOT="${PLUMOS_ROOT}/logs/standalone"
BB="${PLUMOS_BUSYBOX:-/bin/busybox}"
id=${1:-}
[ "$#" -gt 0 ] && shift
[ -x "$BB" ] || BB=busybox

fail() {
  mkdir -p "$LOG_ROOT"
  printf 'plumos-standalone-launch: %s\n' "$*" >&2
  printf 'id=%s error=%s\n' "$id" "$*" >>"$LOG_ROOT/launcher.log"
  exit "${2:-1}"
}

[ -n "$id" ] || fail "missing emulator ID" 2
case "$id" in
  *[!A-Za-z0-9_.-]*) fail "invalid emulator ID: $id" 2 ;;
esac

mkdir -p "$LOG_ROOT"
export HOME="${PLUMOS_ROOT}/state/standalone/${id}"
export XDG_CONFIG_HOME="${HOME}/config"
export XDG_DATA_HOME="${HOME}/data"
export XDG_CACHE_HOME="${PLUMOS_RUNTIME_ROOT}/cache/standalone/${id}"
export PATH="${PLUMOS_ROOT}/bin:${PATH}"
SONAME_MAP="${PLUMOS_ROOT}/config/standalone/soname-links.tsv"
SONAME_DIR="${PLUMOS_RUNTIME_ROOT}/standalone/lib"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$SONAME_DIR"
find "$SONAME_DIR" -type l -delete 2>/dev/null || true
if [ -f "$SONAME_MAP" ]; then
  while IFS="$(printf '\t')" read -r soname real_name; do
    [ -n "$soname" ] && [ -f "${PLUMOS_ROOT}/lib/${real_name}" ] || continue
    ln -sf "${PLUMOS_ROOT}/lib/${real_name}" "${SONAME_DIR}/${soname}"
  done <"$SONAME_MAP"
fi

export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-${PLUMOS_ROOT}/emulator/dri}"
export __EGL_VENDOR_LIBRARY_FILENAMES="${__EGL_VENDOR_LIBRARY_FILENAMES:-${PLUMOS_ROOT}/emulator/egl_vendor.d/50_mesa.json}"
export LD_LIBRARY_PATH="${SONAME_DIR}:${PLUMOS_ROOT}/emulator/lib:${PLUMOS_ROOT}/lib:${LD_LIBRARY_PATH:-}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
export ALSA_CONFIG_PATH="${PLUMOS_ALSA_CONFIG_PATH:-${PLUMOS_RUNTIME_ROOT}/audio/asound.conf}"
export ALSA_PLUGIN_DIR="${PLUMOS_ALSA_PLUGIN_DIR:-${PLUMOS_ROOT}/lib/alsa-lib}"
export AUDIODEV="${AUDIODEV:-plumos_output}"

AUDIO_OUTPUT_HELPER="${PLUMOS_AUDIO_OUTPUT_HELPER:-${PLUMOS_ROOT}/bin/plumos-audio-output}"
if [ -x "$AUDIO_OUTPUT_HELPER" ]; then
  audio_status="$($AUDIO_OUTPUT_HELPER prepare 2>&1)" || {
    fail "audio output prepare failed: $audio_status" 49
  }
  printf 'id=%s audio_device=%s alsa_config=%s %s\n' "$id" "$AUDIODEV" \
    "$ALSA_CONFIG_PATH" "$(printf '%s' "$audio_status" | tr '\n' ' ')" \
    >>"$LOG_ROOT/launcher.log"
else
  fail "audio output helper missing: $AUDIO_OUTPUT_HELPER" 49
fi

cpu_index=1
while [ "$cpu_index" -le 3 ]; do
  online_path="/sys/devices/system/cpu/cpu${cpu_index}/online"
  [ -w "$online_path" ] && printf '1\n' >"$online_path" 2>/dev/null || true
  cpu_index=$((cpu_index + 1))
done

cpu_policy="${PLUMOS_STANDALONE_CPU_POLICY:-ondemand}"
case "$cpu_policy" in
  interactive|performance|ondemand|schedutil|conservative)
    for cpufreq in /sys/devices/system/cpu/cpufreq/policy*; do
      [ -w "${cpufreq}/scaling_governor" ] || continue
      cpu_min="$(cat "${cpufreq}/cpuinfo_min_freq" 2>/dev/null || true)"
      cpu_max="$(cat "${cpufreq}/cpuinfo_max_freq" 2>/dev/null || true)"
      [ -z "$cpu_min" ] || printf '%s\n' "$cpu_min" >"${cpufreq}/scaling_min_freq" 2>/dev/null || true
      [ -z "$cpu_max" ] || printf '%s\n' "$cpu_max" >"${cpufreq}/scaling_max_freq" 2>/dev/null || true
      grep -qw "$cpu_policy" "${cpufreq}/scaling_available_governors" 2>/dev/null || continue
      printf '%s\n' "$cpu_policy" >"${cpufreq}/scaling_governor" 2>/dev/null || true
    done
    ;;
esac

case "$id" in
  pico8)
    rom=${1:-}
    [ -n "$rom" ] || fail "missing PICO-8 cartridge path" 2
    [ -f "$rom" ] || fail "missing PICO-8 cartridge: $rom" 2
    shift
    case "$rom" in
      *.[pP]8|*.[pP][nN][gG]) ;;
      *) fail "unsupported PICO-8 cartridge: $rom" 2 ;;
    esac

    pico8_system_root=""
    for pico8_root in \
      "${PLUMOS_USER_ROOT}/roms/pico-8" \
      "${PLUMOS_USER_ROOT}/roms/pico8" \
      "${PLUMOS_USER_ROOT}/roms/PICO8" \
      "${PLUMOS_USER_ROOT}/roms/PICO" \
      "${PLUMOS_USER_ROOT}/Roms/pico-8" \
      "${PLUMOS_USER_ROOT}/Roms/pico8" \
      "${PLUMOS_USER_ROOT}/Roms/PICO8" \
      "${PLUMOS_USER_ROOT}/Roms/PICO"; do
      case "$rom" in
        "$pico8_root"/*)
          pico8_system_root=$pico8_root
          break
          ;;
      esac
    done
    [ -n "$pico8_system_root" ] ||
      fail "PICO-8 cartridge is outside the user ROM tree: $rom" 2

    pico8_runtime="${pico8_system_root}/aarch64"
    [ -f "${pico8_runtime}/pico8.dat" ] ||
      fail "PICO-8 data file is missing: ${pico8_runtime}/pico8.dat" 127
    exe=""
    for pico8_candidate in \
      "${pico8_runtime}/pico8_64" \
      "${pico8_runtime}/_pico8_64" \
      "${pico8_runtime}/pico8_dyn"; do
      [ -f "$pico8_candidate" ] || continue
      pico8_magic="$($BB dd if="$pico8_candidate" bs=1 count=4 2>/dev/null | \
        $BB od -An -tx1 | $BB tr -d ' \n')"
      pico8_machine="$($BB dd if="$pico8_candidate" bs=1 skip=18 count=2 2>/dev/null | \
        $BB od -An -tx1 | $BB tr -d ' \n')"
      [ "$pico8_magic" = 7f454c46 ] || continue
      [ "$pico8_machine" = b700 ] || continue
      exe=$pico8_candidate
      break
    done
    [ -n "$exe" ] ||
      fail "no AArch64 PICO-8 executable found in: $pico8_runtime" 126
    [ -x "$exe" ] || chmod 0755 "$exe" 2>/dev/null ||
      fail "AArch64 PICO-8 executable is not executable: $exe" 126

    workdir=$pico8_runtime
    mkdir -p "$HOME/desktop" "$HOME/carts"
    pico8_rotation="${EMU_ROOT}/pico8/lib/libplumos-pico8-sdl-rotate.so"
    [ -f "$pico8_rotation" ] ||
      fail "PICO-8 Pixel2 display adapter is missing: $pico8_rotation" 127
    export PLUMOS_PICO8_SDL_ROTATION=270
    # PICO-8 otherwise prefers SDL's desktop OpenGL renderer on this runtime.
    # That backend cannot create the target texture needed for the Pixel2's
    # final landscape-to-native rotation; the GLES2 renderer supports it.
    export SDL_RENDER_DRIVER=opengles2
    export LD_PRELOAD="${pico8_rotation}${LD_PRELOAD:+:$LD_PRELOAD}"
    export SDL_NOMOUSE=1
    export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
    export SDL_GAMECONTROLLERCONFIG='19008d96010000000221000000010000,plumOS Pixel2 Controller,a:b1,b:b0,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,back:b8,start:b9,guide:b14,dpup:b10,dpdown:b11,dpleft:b12,dpright:b13,platform:Linux,'
    pico8_pixel_perfect="${PLUMOS_PICO8_PIXEL_PERFECT:-0}"
    case "$pico8_pixel_perfect" in
      0|1) ;;
      *) fail "invalid PICO-8 pixel-perfect setting: $pico8_pixel_perfect" 2 ;;
    esac
    case "${rom##*/}" in
      *[sS][pP][lL][oO][rR][eE]*)
        set -- -home "$HOME" -desktop "$HOME/desktop" \
          -root_path "$pico8_system_root" -joystick 0 \
          -pixel_perfect "$pico8_pixel_perfect" \
          -splore "$@"
        ;;
      *)
        set -- -home "$HOME" -desktop "$HOME/desktop" \
          -root_path "$pico8_system_root" -joystick 0 \
          -pixel_perfect "$pico8_pixel_perfect" \
          -run "$rom" "$@"
        ;;
    esac
    ;;
  ppsspp)
    exe="${EMU_ROOT}/ppsspp/bin/PPSSPPSDL"
    workdir="${EMU_ROOT}/ppsspp"
    # Pixel2 has a native 480x640 portrait panel.  PPSSPP renders a logical
    # 640x480 landscape surface and the Pixel2 presenter rotates it CCW.
    export PLUMOS_PIXEL2_DISPLAY_ROTATION=ccw
    export PLUMOS_PIXEL2_DISPLAY_SWAP=0
    export PLUMOS_PIXEL2_DISPLAY_LOGICAL=640x480
    export PLUMOS_PIXEL2_DISPLAY_FORCE_LANDSCAPE=1
    export PLUMOS_PIXEL2_UI_ROTATION=none
    ppsspp_factory_dir="${PLUMOS_ROOT}/factory-defaults/standalone/ppsspp/PSP/SYSTEM"
    ppsspp_config_dir="${XDG_CONFIG_HOME}/ppsspp/PSP/SYSTEM"
    ppsspp_config="${ppsspp_config_dir}/ppsspp.ini"
    if [ ! -f "$ppsspp_config" ]; then
      for ppsspp_name in controls.ini ppsspp.ini; do
        [ -f "$ppsspp_factory_dir/$ppsspp_name" ] ||
          fail "PPSSPP factory config missing: $ppsspp_factory_dir/$ppsspp_name" 78
      done
      mkdir -p "$ppsspp_config_dir"
      for ppsspp_name in controls.ini ppsspp.ini; do
        ppsspp_config_tmp="$ppsspp_config_dir/$ppsspp_name.tmp.$$"
        cp "$ppsspp_factory_dir/$ppsspp_name" "$ppsspp_config_tmp" ||
          fail "failed to seed PPSSPP config: $ppsspp_name" 78
      done
      mv -f "$ppsspp_config_dir/controls.ini.tmp.$$" \
        "$ppsspp_config_dir/controls.ini"
      mv -f "$ppsspp_config_dir/ppsspp.ini.tmp.$$" "$ppsspp_config"
    fi
    if ! pidof PPSSPPSDL >/dev/null 2>&1; then
      rm -f /dev/shm/PPSSPP_ID /run/shm/PPSSPP_ID 2>/dev/null || true
    fi
    # Migrate only the exact settings shipped by the first Pixel2 PPSSPP
    # package. The portrait LCD presenter needs a 9/16 correction before its
    # final CCW rotation, while the A30-proven -2 UI scale remains readable on
    # the 640x480 logical screen. Other user settings are preserved.
    if [ -f "$ppsspp_config" ]; then
      ppsspp_config_tmp="${ppsspp_config}.tmp.$$"
      awk '
        /^\[/ { section=$0 }
        $0 == "UIScaleFactor = -8" {
          print "UIScaleFactor = -2"
          next
        }
        section == "[DisplayLayout.Landscape]" &&
          $0 == "DisplayAspectRatio = 1.000000" {
          print "DisplayAspectRatio = 0.562500"
          next
        }
        section == "[DisplayLayout.Landscape]" &&
          $0 == "InternalScreenRotation = 0" {
          print "InternalScreenRotation = 1"
          next
        }
        section == "[DisplayLayout.Portrait]" &&
          $0 == "InternalScreenRotation = 0" {
          print "InternalScreenRotation = 2"
          next
        }
        { print }
      ' "$ppsspp_config" >"$ppsspp_config_tmp" ||
        fail "failed to migrate PPSSPP display config" 78
      if cmp "$ppsspp_config" "$ppsspp_config_tmp" >/dev/null 2>&1; then
        rm -f "$ppsspp_config_tmp"
      else
        mv -f "$ppsspp_config_tmp" "$ppsspp_config" ||
          fail "failed to install PPSSPP display config migration" 78
        printf 'id=ppsspp config_migration=pixel2-aspect-ui-v1\n' >>"$LOG_ROOT/launcher.log"
      fi
    fi
    ppsspp_controls="${ppsspp_config_dir}/controls.ini"
    if [ -f "$ppsspp_controls" ] &&
       ! grep -Eq '^Pause[[:space:]]*=.*(^|,)10-4(,|$)' "$ppsspp_controls"; then
      ppsspp_pause="$(grep '^Pause[[:space:]]*=' "$ppsspp_controls" 2>/dev/null | head -n 1 || true)"
      if [ -n "$ppsspp_pause" ]; then
        ppsspp_controls_tmp="${ppsspp_controls}.tmp.$$"
        sed '/^Pause[[:space:]]*=/ s/$/,10-4/' "$ppsspp_controls" >"$ppsspp_controls_tmp" &&
          mv -f "$ppsspp_controls_tmp" "$ppsspp_controls"
      fi
    fi
    set -- --fullscreen --graphics=gles2.0 "$@"
    ;;
  flycast)
    exe="${EMU_ROOT}/flycast/bin/flycast"
    workdir="${EMU_ROOT}/flycast"
    set -- -config window:fullscreen=yes "$@"
    ;;
  drastic)
    exe="${EMU_ROOT}/drastic/bin/drastic"
    workdir="${EMU_ROOT}/drastic"
    drastic_content=${1:-}
    [ -n "$drastic_content" ] || fail "missing Nintendo DS content path" 2
    [ -f "$drastic_content" ] || fail "missing Nintendo DS content: $drastic_content" 2
    ;;
  scummvm)
    exe="${EMU_ROOT}/scummvm/bin/scummvm"
    workdir="${EMU_ROOT}/scummvm"
    content=${1:-}
    [ -n "$content" ] || fail "missing ScummVM content path" 2
    shift
    if [ -d "$content" ]; then
      game_dir=$content
    elif [ -f "$content" ]; then
      game_dir=${content%/*}
    else
      fail "missing ScummVM content: $content" 2
    fi
    set -- --config="${XDG_CONFIG_HOME}/scummvm.ini" \
      --savepath="${XDG_DATA_HOME}/saves" --fullscreen \
      --path="$game_dir" --auto-detect "$@"
    ;;
  easyrpg)
    exe="${EMU_ROOT}/easyrpg/bin/easyrpg-player"
    workdir="${EMU_ROOT}/easyrpg"
    project=${1:-}
    [ -n "$project" ] || fail "missing EasyRPG project path" 2
    shift
    case "$project" in *.[lL][dD][bB]) project=${project%/*} ;; esac
    set -- --project-path "$project" "$@"
    ;;
  openbor)
    exe="${EMU_ROOT}/openbor/bin/OpenBOR"
    workdir="${PLUMOS_RUNTIME_ROOT}/standalone/openbor-work.$$"
    pak=${1:-}
    [ -n "$pak" ] || fail "missing OpenBOR PAK path" 2
    [ -f "$pak" ] || fail "missing OpenBOR PAK: $pak" 2
    shift
    mkdir -p "$workdir/Paks" "${XDG_DATA_HOME}/Saves" "${XDG_DATA_HOME}/Logs" \
      "${XDG_DATA_HOME}/ScreenShots"
    ln -s "$pak" "$workdir/Paks/${pak##*/}"
    ;;
  pcsx_rearmed)
    exe="${EMU_ROOT}/pcsx_rearmed/bin/pcsx"
    workdir="${EMU_ROOT}/pcsx_rearmed"
    rom=${1:-}
    [ -n "$rom" ] || fail "missing PlayStation content path" 2
    [ -f "$rom" ] || fail "missing PlayStation content: $rom" 2
    shift
    pcsx_factory="${PLUMOS_ROOT}/factory-defaults/standalone/pcsx_rearmed/pcsx.cfg"
    pcsx_profile="${HOME}/.pcsx"
    pcsx_config="${pcsx_profile}/pcsx.cfg"
    [ -f "$pcsx_factory" ] || fail "PCSX-ReARMed factory config missing" 78
    mkdir -p "$pcsx_profile/bios" "$pcsx_profile/memcards" \
      "$pcsx_profile/sstates" "$pcsx_profile/cheats" \
      "$pcsx_profile/patches" "$pcsx_profile/cfg" \
      "$pcsx_profile/screenshots" "$HOME/.picodrive"
    if [ ! -s "$pcsx_config" ]; then
      pcsx_config_tmp="${pcsx_config}.tmp.$$"
      cp "$pcsx_factory" "$pcsx_config_tmp" ||
        fail "failed to seed PCSX-ReARMed config" 78
      mv -f "$pcsx_config_tmp" "$pcsx_config"
    fi
    if [ ! -e "$HOME/.picodrive/skin" ]; then
      ln -s "$workdir/skin" "$HOME/.picodrive/skin" ||
        fail "failed to seed PCSX-ReARMed skin" 78
    fi
    bios_root="${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}"
    for bios_dir in "$bios_root/psx" "$bios_root/ps1" "$bios_root"; do
      [ -d "$bios_dir" ] || continue
      for bios in "$bios_dir"/[sS][cC][pP][hH]*.[bB][iI][nN]; do
        [ -f "$bios" ] || continue
        bios_name=${bios##*/}
        [ -e "$pcsx_profile/bios/$bios_name" ] ||
          cp -p "$bios" "$pcsx_profile/bios/$bios_name"
      done
    done
    # The minimal Pixel2 System intentionally does not install the legacy
    # libpthread compatibility DSO.  The managed RetroArch runtime owns the
    # glibc-2.36-compatible copy required by Debian's SDL2 build, so expose it
    # only to this package-local sdl12-compat chain.
    pcsx_pthread="${PLUMOS_ROOT}/emulator/lib/libpthread.so.0"
    [ -f "$pcsx_pthread" ] ||
      fail "PCSX-ReARMed SDL2 pthread compatibility runtime missing" 127
    export LD_LIBRARY_PATH="${workdir}/lib:${PLUMOS_ROOT}/emulator/lib:${LD_LIBRARY_PATH}"
    export SDL_VIDEODRIVER=dummy
    export SDL_AUDIODRIVER=alsa
    export SDL_NOMOUSE=1
    export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
    export PLUMOS_PCSX_AUDIO_INPUT_RATE=44100
    export PLUMOS_PCSX_REQUIRE_ALSA=1
    set -- -cdfile "$rom" "$@"
    ;;
  nxengine-evo)
    exe="${EMU_ROOT}/nxengine-evo/bin/nxengine-evo"
    workdir="${EMU_ROOT}/nxengine-evo"
    set --
    ;;
  *) fail "unknown standalone emulator: $id" 2 ;;
esac

if [ "$id" = drastic ]; then
  runtime="$workdir"
  loader="$runtime/runtime/ld-linux-armhf.so.3"
  compat="$runtime/lib/libdrastic_mmap_compat.so"
  runner="$runtime/bin/runner"
  log="$LOG_ROOT/drastic.log"
  drastic_mounts=""
  runner_pid=""
  pid=""
  runner_ready="${PLUMOS_RUNTIME_ROOT}/standalone/drastic.runner-ready.$$"
  setarch_bin=""
  setarch_mode=""

  [ -x "$loader" ] && [ -x "$exe" ] && [ -x "$runner" ] &&
    [ -f "$runtime/lib/libSDL2-2.0.so.0" ] &&
    [ -f "$compat" ] || {
    fail "DraStic runtime is missing" 127
  }
  [ -c /dev/dri/card0 ] || fail "DraStic DRM device is unavailable" 1
  [ -c /dev/input/event2 ] || fail "DraStic Pixel2 input device is unavailable" 1
  mkdir -p /dev/shm
  chmod 1777 /dev/shm 2>/dev/null || true

  if [ -x "$runtime/bin/setarch" ]; then
    setarch_bin="$runtime/bin/setarch"
    setarch_mode=util-linux
  fi
  for candidate in "$BB" /bin/busybox busybox; do
    [ -z "$setarch_bin" ] || break
    command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ] || continue
    if "$candidate" --list 2>/dev/null | grep -qx setarch; then
      setarch_bin="$candidate"
      setarch_mode=busybox
      break
    fi
  done
  if [ -z "$setarch_bin" ] && command -v setarch >/dev/null 2>&1; then
    setarch_bin=$(command -v setarch)
    setarch_mode=util-linux
  fi
  [ -n "$setarch_bin" ] || fail "setarch is missing for 32-bit DraStic" 127

  work="${HOME}/work"
  mkdir -p \
    "$work/backup" \
    "$work/config" \
    "$work/input_record" \
    "$work/profiles" \
    "$work/savestates" \
    "$work/system" \
    "$work/unzip_cache"
  for mutable_dir in backup config input_record profiles savestates system unzip_cache; do
    mkdir -p "$runtime/$mutable_dir"
  done
  for factory_config in "$runtime"/config/*; do
    [ -f "$factory_config" ] || continue
    config_name=${factory_config##*/}
    [ -e "$work/config/$config_name" ] ||
      cp -p "$factory_config" "$work/config/$config_name"
  done
  drastic_config="$work/config/drastic.cfg"
  if [ -f "$drastic_config" ] &&
     grep -Fqx 'controls_b[CONTROL_INDEX_MENU] = 1154' "$drastic_config"; then
    drastic_config_tmp="${drastic_config}.tmp.$$"
    sed 's/^controls_b\[CONTROL_INDEX_MENU\] = 1154$/controls_b[CONTROL_INDEX_MENU] = 1032/' \
      "$drastic_config" >"$drastic_config_tmp" &&
      mv -f "$drastic_config_tmp" "$drastic_config"
  fi
  bios_root="${PLUMOS_BIOS_ROOT:-/mnt/plumos-user/bios}"
  for bios_source_dir in "$bios_root/drastic" "$bios_root/nds" "$bios_root"; do
    [ -d "$bios_source_dir" ] || continue
    for user_bios in "$bios_source_dir"/drastic_bios_*.bin; do
      [ -f "$user_bios" ] || continue
      bios_name=${user_bios##*/}
      [ -e "$work/system/$bios_name" ] ||
        cp -p "$user_bios" "$work/system/$bios_name"
    done
  done

  restore_drastic_runtime() {
    rc=$?
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" >/dev/null 2>&1 || true
      core_wait=0
      while kill -0 "$pid" 2>/dev/null && [ "$core_wait" -lt 20 ]; do
        sleep 0.1
        core_wait=$((core_wait + 1))
      done
      kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      pid=""
    fi
    if [ -n "$runner_pid" ]; then
      # The Pixel2 power overlay may have stopped the DRM runner before the
      # launcher receives HUP/TERM (for example during a power transition).
      # A stopped process cannot act on a pending TERM, so resume it first and
      # keep cleanup bounded instead of waiting forever.
      kill -CONT "$runner_pid" >/dev/null 2>&1 || true
      kill -TERM "$runner_pid" >/dev/null 2>&1 || true
      runner_stop_wait=0
      while kill -0 "$runner_pid" 2>/dev/null &&
            [ "$runner_stop_wait" -lt 20 ]; do
        sleep 0.1
        runner_stop_wait=$((runner_stop_wait + 1))
      done
      kill -0 "$runner_pid" 2>/dev/null &&
        kill -KILL "$runner_pid" >/dev/null 2>&1 || true
      wait "$runner_pid" >/dev/null 2>&1 || true
      runner_pid=""
    fi
    rm -f /dev/shm/NDS_SHM "$runner_ready" 2>/dev/null || true
    for mount_target in $drastic_mounts; do
      umount "$mount_target" >/dev/null 2>&1 || true
    done
    exit "$rc"
  }
  trap restore_drastic_runtime EXIT INT TERM HUP

  for mutable_dir in backup config input_record profiles savestates system unzip_cache; do
    mount --bind "$work/$mutable_dir" "$runtime/$mutable_dir" ||
      fail "failed to bind DraStic mutable directory: $mutable_dir" 1
    drastic_mounts="$runtime/$mutable_dir $drastic_mounts"
  done

  if [ -x "$PLUMOS_ROOT/bin/plumos-volume-control" ]; then
    "$PLUMOS_ROOT/bin/plumos-volume-control" apply >>"$log" 2>&1 || true
  fi

  mkdir -p "${PLUMOS_RUNTIME_ROOT}/standalone"
  rm -f /dev/shm/NDS_SHM "$runner_ready"
  (
    cd "$runtime" || exit 127
    NDS_RUNNER_READY_FILE="$runner_ready" \
    NDS_RUNNER_STARTUP_TIMEOUT_MS="${PLUMOS_DRASTIC_STARTUP_TIMEOUT_MS:-15000}" \
      exec "$runner"
  ) >>"$log" 2>&1 &
  runner_pid=$!
  runner_wait=0
  while [ ! -e /dev/shm/NDS_SHM ] && [ "$runner_wait" -lt 50 ]; do
    kill -0 "$runner_pid" 2>/dev/null || fail "DraStic display runner exited" 1
    sleep 0.1
    runner_wait=$((runner_wait + 1))
  done
  [ -e /dev/shm/NDS_SHM ] || fail "DraStic display runner timeout" 1

  PID_ROOT="${PLUMOS_RUNTIME_ROOT}/standalone"
  pid_file="${PID_ROOT}/${id}.pid"
  exe_file="${PID_ROOT}/${id}.exe"
  mkdir -p "$PID_ROOT"
  rm -f "$pid_file" "$exe_file"
  printf 'id=%s exe=%s args=%s runtime=armhf-gkd-pixel2\n' \
    "$id" "$exe" "$drastic_content" >>"$LOG_ROOT/launcher.log"
  (
    cd "$runtime" || exit 127
    export SDL_VIDEODRIVER=NDS
    export SDL_AUDIODRIVER=alsa
    export ALSA_PLUGIN_DIR="${PLUMOS_ROOT}/lib/alsa-lib-armhf"
    export AUDIODEV=plumos_output
    export NDS_DEBUG_LEVEL="${NDS_DEBUG_LEVEL:-INFO}"
    if [ "$setarch_mode" = busybox ]; then
      exec "$setarch_bin" setarch linux32 -R \
        "$loader" \
        --preload "$compat" \
        --library-path "$runtime/lib:$runtime/runtime/lib32" \
        "$exe" "$drastic_content"
    fi
    exec "$setarch_bin" linux32 -R \
      "$loader" \
      --preload "$compat" \
      --library-path "$runtime/lib:$runtime/runtime/lib32" \
      "$exe" "$drastic_content"
  ) >>"$log" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" >"$pid_file"
  printf '%s\n' "$loader" >"$exe_file"

  display_wait=0
  while [ ! -e "$runner_ready" ] && [ "$display_wait" -lt 200 ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null
      rc=$?
      fail "DraStic exited before first displayed frame (rc=$rc)" 1
    fi
    kill -0 "$runner_pid" 2>/dev/null ||
      fail "DraStic display runner exited before first frame" 1
    sleep 0.1
    display_wait=$((display_wait + 1))
  done
  [ -e "$runner_ready" ] || fail "DraStic first displayed frame timeout" 1
  printf 'id=drastic display_ready=first-frame runner_pid=%s core_pid=%s\n' \
    "$runner_pid" "$pid" >>"$LOG_ROOT/launcher.log"

  while kill -0 "$pid" 2>/dev/null; do
    kill -0 "$runner_pid" 2>/dev/null ||
      fail "DraStic display runner exited during emulation" 1
    sleep 0.2
  done
  wait "$pid"
  rc=$?
  printf 'id=%s exit=%s\n' "$id" "$rc" >>"$LOG_ROOT/launcher.log"
  exit "$rc"
fi

[ -x "$exe" ] || fail "missing standalone emulator binary: $exe" 127

PID_ROOT="${PLUMOS_RUNTIME_ROOT}/standalone"
pid_file="${PID_ROOT}/${id}.pid"
exe_file="${PID_ROOT}/${id}.exe"
mkdir -p "$PID_ROOT"
if [ -f "$pid_file" ] && [ -f "$exe_file" ]; then
  old_pid="$(cat "$pid_file" 2>/dev/null || true)"
  old_exe="$(cat "$exe_file" 2>/dev/null || true)"
  if [ -n "$old_pid" ] && [ -r "/proc/${old_pid}/exe" ] &&
     [ "$(readlink "/proc/${old_pid}/exe" 2>/dev/null || true)" = "$old_exe" ]; then
    fail "standalone emulator already running: $id pid=$old_pid" 75
  fi
fi
rm -f "$pid_file" "$exe_file"

cleanup() {
  rc=$?
  [ -n "${openbor_workdir:-}" ] && rm -rf "$openbor_workdir"
  exit "$rc"
}
trap cleanup EXIT INT TERM HUP

printf 'id=%s exe=%s args=%s\n' "$id" "$exe" "$*" >>"$LOG_ROOT/launcher.log"
cd "$workdir" || exit 127
"$exe" "$@" >>"$LOG_ROOT/${id}.log" 2>&1 &
pid=$!
printf '%s\n' "$pid" >"$pid_file"
printf '%s\n' "$exe" >"$exe_file"
wait "$pid"
