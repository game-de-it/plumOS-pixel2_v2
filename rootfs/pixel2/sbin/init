#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root HOSTNAME=plumos-pixel2

bb=/bin/busybox
is_mounted() {
    $bb grep -qs " $1 " /proc/mounts 2>/dev/null
}

if is_mounted /.plumos-dispatcher-old; then
    printf 'plumos-init=dispatcher-detach-start\n' \
        >>/storage/plumos/logs/system-dispatcher.log 2>/dev/null || true
    $bb umount /.plumos-dispatcher-old 2>/dev/null || \
        $bb umount -l /.plumos-dispatcher-old 2>/dev/null || true
    printf 'plumos-init=dispatcher-detach-complete\n' \
        >>/storage/plumos/logs/system-dispatcher.log 2>/dev/null || true
    $bb sync
fi

is_mounted /proc || $bb mount -t proc proc /proc
is_mounted /sys || $bb mount -t sysfs sysfs /sys
is_mounted /dev || $bb mount -t devtmpfs devtmpfs /dev
$bb mkdir -p /dev/pts /run /tmp /boot /state /roms /root \
    /flash /storage /mnt/plumos /mnt/plumos-user
is_mounted /dev/pts || $bb mount -t devpts devpts /dev/pts
$bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
$bb mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || true
$bb hostname "$HOSTNAME"

mkdir -p /run/plumos
exec >/dev/console 2>&1
printf 'plumos-init=result-start device=pixel2\n'
printf 'plumos-init=result-start device=pixel2\n' >/dev/kmsg 2>/dev/null || true
if is_mounted /storage; then
    $bb mkdir -p /storage/plumos/logs
    printf 'plumos-init=result-start device=pixel2 storage=pre-mounted\n' \
        >>/storage/plumos/logs/init.log 2>/dev/null || true
fi

echo /sbin/mdev >/proc/sys/kernel/hotplug 2>/dev/null || true
$bb mdev -s

find_label() {
    $bb blkid -L "$1" 2>/dev/null || true
}

mount_partition() {
    target=$1
    label=$2
    fallback=$3
    options=$4
    device=$(find_label "$label")
    [ -n "$device" ] || device=$fallback
    [ -b "$device" ] || return 1
    $bb mount -o "$options" "$device" "$target"
}

if is_mounted /flash; then
    printf 'plumos-init=mount-source flash=stock-initramfs\n'
    is_mounted /boot || $bb mount --bind /flash /boot 2>/dev/null || true
else
    mount_partition /boot PLUMOS_BOOT /dev/mmcblk0p1 ro 2>/dev/null || \
        printf 'plumos-init=warn mount=boot\n'
fi
if is_mounted /storage; then
    printf 'plumos-init=mount-source storage=stock-initramfs\n'
    is_mounted /mnt/plumos || $bb mount --bind /storage /mnt/plumos 2>/dev/null || true
fi
if ! is_mounted /mnt/plumos && \
    ! mount_partition /mnt/plumos PLUMOS_SYS /dev/mmcblk0p2 rw 2>/dev/null; then
    if mount_partition /mnt/plumos PLUMOS_STATE /dev/mmcblk0p2 rw 2>/dev/null; then
        printf 'plumos-init=warn mount=runtime legacy-label=PLUMOS_STATE\n'
    else
        $bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /mnt/plumos
        printf 'plumos-init=warn mount=runtime fallback=tmpfs\n'
    fi
fi
if ! mount_partition /mnt/plumos-user PLUMOS_USER /dev/mmcblk0p3 rw 2>/dev/null; then
    if mount_partition /mnt/plumos-user PLUMOS_ROMS /dev/mmcblk0p3 rw 2>/dev/null; then
        printf 'plumos-init=warn mount=user-data legacy-label=PLUMOS_ROMS\n'
    else
        $bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /mnt/plumos-user
        printf 'plumos-init=warn mount=user-data fallback=tmpfs\n'
    fi
fi

$bb mkdir -p /mnt/plumos/state /mnt/plumos/config /mnt/plumos/logs \
    /mnt/plumos/root/.ssh /mnt/plumos-user/roms /mnt/plumos-user/bios \
    /mnt/plumos-user/Images /mnt/plumos-user/Screenshots \
    /mnt/plumos-user/updates
$bb mount --bind /mnt/plumos/state /state 2>/dev/null || true
[ -e /state/plumos ] || $bb ln -s /mnt/plumos /state/plumos
$bb mount --bind /mnt/plumos-user/roms /roms 2>/dev/null || true
chmod 0700 /mnt/plumos/root /mnt/plumos/root/.ssh
$bb mount --bind /mnt/plumos/root /root 2>/dev/null || true
printf 'plumos-init=mounts-ready boot=%s runtime=%s user=%s\n' \
    "$(is_mounted /boot && echo 1 || echo 0)" \
    "$(is_mounted /mnt/plumos && echo 1 || echo 0)" \
    "$(is_mounted /mnt/plumos-user && echo 1 || echo 0)" \
    >>/mnt/plumos/logs/init.log 2>/dev/null || true
/usr/bin/plumos-diagnostics > /state/plumos/logs/boot-diagnostics.txt 2>&1 || true

apply_pending_update() {
    updater=/usr/sbin/plumos-system-update
    log=/mnt/plumos/logs/system-update-boot.log
    [ -x "$updater" ] || return 0
    printf '%s update=apply-pending stage=start\n' \
        "$($bb date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$log"
    PLUMOS_ROOT=/mnt/plumos PLUMOS_USERDATA_ROOT=/mnt/plumos-user \
        PLUMOS_BOOT_ROOT=/flash "$updater" apply-pending >>"$log" 2>&1
    rc=$?
    printf '%s update=apply-pending stage=end rc=%s\n' \
        "$($bb date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >>"$log"
    case "$rc" in
        0) return 0 ;;
        20)
            $bb sync
            if [ -x /mnt/plumos/bin/plumos-safe-shutdown ]; then
                /mnt/plumos/bin/plumos-safe-shutdown --reboot --no-hold-resume \
                    >>"$log" 2>&1 || true
            fi
            exec $bb reboot -f
            ;;
        *) return 0 ;;
    esac
}

apply_pending_update

for service in /usr/lib/plumos/init.d/*; do
    [ -x "$service" ] || continue
    printf 'plumos-init=service-start name=%s\n' "${service##*/}"
    "$service" start || printf 'plumos-init=service-failed name=%s rc=%s\n' \
        "${service##*/}" "$?"
done

/usr/bin/plumos-diagnostics > /state/plumos/logs/runtime-diagnostics.txt 2>&1 || true

printf 'plumos-init=result-ready console=tty1\n'
if [ -s /run/plumos/frontend.pid ]; then
    frontend_pid=$($bb cat /run/plumos/frontend.pid 2>/dev/null || true)
    case "$frontend_pid" in
        ''|*[!0-9]*) ;;
        *)
            while $bb kill -0 "$frontend_pid" 2>/dev/null; do
                $bb sleep 2
            done
            printf 'plumos-init=warn frontend=stopped pid=%s\n' "$frontend_pid"
            ;;
    esac
fi
exec $bb setsid $bb cttyhack /bin/sh -l
