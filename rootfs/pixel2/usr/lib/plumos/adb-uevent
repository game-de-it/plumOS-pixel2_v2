#!/bin/sh
set -u

SERVICES_CONF="${PLUMOS_ADB_SERVICES_CONF:-/mnt/plumos/config/network/services.conf}"
RECOVERY_MARKER="${PLUMOS_ADB_RECOVERY_MARKER:-/mnt/plumos-user/plumos-enable-adb}"
ADBD_CONTROL="${PLUMOS_ADB_CONTROL:-/usr/lib/plumos/init.d/10-adbd}"
SUPPRESS_UNTIL="${PLUMOS_ADB_SUPPRESS_UNTIL:-/run/plumos/adbd-replug-suppress-until}"
LOG="${PLUMOS_ADB_LOG:-/state/plumos/logs/adbd.log}"
SETTLE_SECONDS="${PLUMOS_ADB_RECOVERY_SETTLE_SECONDS:-1}"

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=adb-uevent %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

adb_requested() {
    [ -f "$RECOVERY_MARKER" ] && return 0
    [ -r "$SERVICES_CONF" ] || return 0
    mode=$(sed -n 's/^usb_mode=//p' "$SERVICES_CONF" 2>/dev/null | tail -n 1)
    case "$mode" in
        adb) return 0 ;;
        wifi|off) return 1 ;;
    esac
    value=$(sed -n 's/^adb_enabled=//p' "$SERVICES_CONF" 2>/dev/null | tail -n 1)
    case "$value" in 0|false|off) return 1 ;; *) return 0 ;; esac
}

adb_requested || exit 0
[ -x "$ADBD_CONTROL" ] || exit 0

if [ "${SUBSYSTEM:-}" = usb ] && [ "${ACTION:-}" = remove ] &&
    [ "${DEVTYPE:-}" = usb_device ]; then
    case "${DEVPATH:-}" in
        /devices/platform/ff300000.usb/usb1/1-*) ;;
        *) exit 0 ;;
    esac
    sleep "$SETTLE_SECONDS"
    adb_requested || exit 0
    log "action=controller-takeover reason=downstream-removed product=${PRODUCT:-unknown}"
    exec "$ADBD_CONTROL" takeover >>"$LOG" 2>&1
fi

[ "${SUBSYSTEM:-}" = android_usb ] || exit 0
[ "${USB_STATE:-}" = DISCONNECTED ] || exit 0

now=$(date +%s 2>/dev/null || printf '0\n')
deadline=$(cat "$SUPPRESS_UNTIL" 2>/dev/null || printf '0\n')
case "$now" in ''|*[!0-9]*) now=0 ;; esac
case "$deadline" in ''|*[!0-9]*) deadline=0 ;; esac
if [ "$deadline" -gt 0 ] && [ "$now" -le "$deadline" ]; then
    log "result=ignored reason=self-rebind deadline=$deadline"
    exit 0
fi
rm -f "$SUPPRESS_UNTIL"

sleep "$SETTLE_SECONDS"
adb_requested || exit 0
log 'action=replug reason=kernel-disconnected'
exec "$ADBD_CONTROL" replug >>"$LOG" 2>&1
