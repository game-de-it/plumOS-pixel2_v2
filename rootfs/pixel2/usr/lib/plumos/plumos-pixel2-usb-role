#!/bin/sh
set -u

# Pixel2 keeps the exact stock DTB.  That tree declares ff300000.usb as OTG
# but does not expose a Linux usb-role-switch, so /sys/class/usb_role is empty.
# Use the DWC2 force-mode bits that the in-kernel role-switch implementation
# would use, then return immediately.  This is an explicit mode transition,
# not a cable monitor or transport watchdog.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

DEVMEM="${PLUMOS_PIXEL2_USB_DEVMEM:-/bin/busybox devmem}"
GUSBCFG_ADDR="${PLUMOS_PIXEL2_USB_GUSBCFG_ADDR:-0xff30000c}"
GINTSTS_ADDR="${PLUMOS_PIXEL2_USB_GINTSTS_ADDR:-0xff300014}"
POLL_ATTEMPTS="${PLUMOS_PIXEL2_USB_POLL_ATTEMPTS:-110}"
POLL_DELAY_US="${PLUMOS_PIXEL2_USB_POLL_DELAY_US:-2000}"

read_reg() {
    # DEVMEM intentionally permits a command plus applet, e.g.
    # "/bin/busybox devmem" on the generated System image.
    # shellcheck disable=SC2086
    $DEVMEM "$1" 32
}

write_reg() {
    # shellcheck disable=SC2086
    $DEVMEM "$1" 32 "$2" >/dev/null
}

hex32() {
    printf '0x%08x\n' "$(( $1 & 0xffffffff ))"
}

settle() {
    [ "$POLL_DELAY_US" -gt 0 ] || return 0
    if command -v usleep >/dev/null 2>&1; then
        usleep "$POLL_DELAY_US"
    else
        sleep 1
    fi
}

read_gusbcfg() {
    value=$(read_reg "$GUSBCFG_ADDR") || return 1
    case "$value" in
        0x[0-9A-Fa-f]*|[0-9]*) printf '%s\n' "$value" ;;
        *) return 1 ;;
    esac
}

current_mode() {
    gintsts=$(read_reg "$GINTSTS_ADDR") || return 1
    if [ $((gintsts & 1)) -eq 1 ]; then
        printf '%s\n' host
    else
        printf '%s\n' device
    fi
}

set_device() {
    before=$(read_gusbcfg) || return 1
    # Clear FORCEHOSTMODE (bit 29), set FORCEDEVMODE (bit 30), and preserve
    # every other stock-kernel-programmed field.
    after=$(( (before & 0x9fffffff) | 0x40000000 ))
    write_reg "$GUSBCFG_ADDR" "$(hex32 "$after")" || return 1

    attempt=0
    while [ "$attempt" -lt "$POLL_ATTEMPTS" ]; do
        mode=$(current_mode 2>/dev/null || true)
        if [ "$mode" = device ]; then
            printf 'requested=device mode=device gusbcfg_before=%s gusbcfg_after=%s\n' \
                "$(hex32 "$before")" "$(hex32 "$after")"
            return 0
        fi
        settle
        attempt=$((attempt + 1))
    done
    printf 'requested=device mode=%s gusbcfg_before=%s gusbcfg_after=%s\n' \
        "${mode:-unknown}" "$(hex32 "$before")" "$(hex32 "$after")" >&2
    return 1
}

set_auto() {
    before=$(read_gusbcfg) || return 1
    # Clear both force bits.  The exact-stock DTB/PHY signals resume ownership
    # of OTG role selection for Wi-Fi host operation and cable detection.
    after=$((before & 0x9fffffff))
    write_reg "$GUSBCFG_ADDR" "$(hex32 "$after")" || return 1
    settle
    mode=$(current_mode 2>/dev/null || printf '%s\n' unknown)
    printf 'requested=auto mode=%s gusbcfg_before=%s gusbcfg_after=%s\n' \
        "$mode" "$(hex32 "$before")" "$(hex32 "$after")"
}

show_status() {
    gusbcfg=$(read_gusbcfg) || return 1
    mode=$(current_mode) || return 1
    forced=auto
    [ $((gusbcfg & 0x40000000)) -eq 0 ] || forced=device
    [ $((gusbcfg & 0x20000000)) -eq 0 ] || forced=host
    printf 'mode=%s\nforced=%s\ngusbcfg=%s\n' \
        "$mode" "$forced" "$(hex32 "$gusbcfg")"
}

case "${1:-}" in
    device) set_device ;;
    auto) set_auto ;;
    status) show_status ;;
    *) printf 'usage: %s {device|auto|status}\n' "$0" >&2; exit 2 ;;
esac
