#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root
BUSYBOX="${PLUMOS_BUSYBOX:-/bin/busybox}"
UEVENT_HELPER="${PLUMOS_ADB_UEVENT_HELPER:-/usr/lib/plumos/adb-uevent}"
WATCHDOG_PID="${PLUMOS_ADB_WATCHDOG_PID:-/run/plumos/adbd-watchdog.pid}"
LOG="${PLUMOS_ADB_LOG:-/state/plumos/logs/adbd.log}"
PROC_ROOT="${PLUMOS_PROC_ROOT:-/proc}"

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=adb-watchdog %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

watchdog_running() {
    [ -s "$WATCHDOG_PID" ] || return 1
    watchdog_pid=$(cat "$WATCHDOG_PID" 2>/dev/null || true)
    case "$watchdog_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$watchdog_pid" 2>/dev/null || return 1
    cmdline=$(tr '\000' ' ' <"$PROC_ROOT/$watchdog_pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in *"busybox uevent $UEVENT_HELPER"*) return 0 ;; esac
    return 1
}

monitor() {
    trap 'rm -f "$WATCHDOG_PID"; exit 0' TERM INT EXIT
    exec "$BUSYBOX" uevent "$UEVENT_HELPER"
}

start_watchdog() {
    if watchdog_running; then
        return 0
    fi
    rm -f "$WATCHDOG_PID"
    [ -x "$BUSYBOX" ] && [ -x "$UEVENT_HELPER" ] || {
        log 'result=start-failed reason=uevent-helper-missing'
        return 1
    }
    "$0" monitor </dev/null >>"$LOG" 2>&1 &
    watchdog_pid=$!
    printf '%s\n' "$watchdog_pid" >"$WATCHDOG_PID"
    sleep 1
    if ! watchdog_running; then
        log 'result=start-failed reason=uevent-monitor-exited'
        rm -f "$WATCHDOG_PID"
        return 1
    fi
    log "result=started mode=kernel-uevent pid=$watchdog_pid"
}

stop_watchdog() {
    if watchdog_running; then
        watchdog_pid=$(cat "$WATCHDOG_PID")
        kill "$watchdog_pid" 2>/dev/null || true
        elapsed=0
        while kill -0 "$watchdog_pid" 2>/dev/null && [ "$elapsed" -lt 5 ]; do
            sleep 1
            elapsed=$((elapsed + 1))
        done
        kill -9 "$watchdog_pid" 2>/dev/null || true
    fi
    rm -f "$WATCHDOG_PID"
    log 'result=stopped'
}

case "${1:-}" in
    start) start_watchdog ;;
    stop) stop_watchdog ;;
    restart) stop_watchdog; start_watchdog ;;
    monitor) monitor ;;
    *) printf 'usage: %s {start|stop|restart}\n' "$0" >&2; exit 2 ;;
esac
