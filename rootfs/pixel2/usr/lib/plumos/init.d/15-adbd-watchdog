#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root
SERVICE=/usr/lib/plumos/init.d/10-adbd
PID=/run/plumos/adbd.pid
WATCHDOG_PID=/run/plumos/adbd-watchdog.pid
LOG=/state/plumos/logs/adbd.log

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=adb-watchdog %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

watch() {
    printf '%s\n' "$$" >"$WATCHDOG_PID"
    log 'result=started'
    while :; do
        sleep 5
        if [ ! -s "$PID" ] || ! kill -0 "$(cat "$PID" 2>/dev/null)" 2>/dev/null; then
            log 'event=daemon-missing action=restart'
            "$SERVICE" restart >>"$LOG" 2>&1 || \
                log 'result=restart-failed'
        fi
    done
}

case "${1:-}" in
    start)
        if [ -s "$WATCHDOG_PID" ] && kill -0 "$(cat "$WATCHDOG_PID")" 2>/dev/null; then
            exit 0
        fi
        watch &
        ;;
    *) printf 'usage: %s start\n' "$0" >&2; exit 2 ;;
esac
