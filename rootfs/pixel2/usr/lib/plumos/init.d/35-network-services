#!/bin/sh
set -u

LOG=/mnt/plumos/logs/network-services-boot.log
SERVICE=/mnt/plumos/bin/plumos-network-services

[ "${1:-}" = start ] || exit 2
[ -x "$SERVICE" ] || exit 0
mkdir -p "${LOG%/*}"
# ADB is brought up earlier by 10-adbd. Network services start asynchronously,
# so a missing WLAN cannot block the FE or turn a deferred Samba start into a
# fatal boot failure.
(
    PLUMOS_ROOT=/mnt/plumos PLUMOS_SDCARD_ROOT=/mnt/plumos-user \
        "$SERVICE" start-enabled >>"$LOG" 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || printf '%s service=network-services result=degraded rc=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >>"$LOG"
) &
exit 0
