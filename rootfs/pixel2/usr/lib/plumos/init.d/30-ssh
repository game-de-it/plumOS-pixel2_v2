#!/bin/sh
set -u

LOG=/state/plumos/logs/ssh.log

[ "${1:-}" = start ] || exit 2
# Network-service policy and credentials are app-layer owned. The following
# 35-network-services stage starts SSH only when its persisted toggle is on.
# Keep this compatibility slot so older init ordering remains stable without
# bypassing the frontend's saved service state.
printf '%s service=ssh result=delegated owner=plumos-network-services\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG"
exit 0
