#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=${PLUMOS_WIFI_CONFIG:-/mnt/plumos/config/wpa_supplicant.conf}
SETTINGS=${PLUMOS_SYSTEM_SETTINGS_JSON:-/mnt/plumos/config/system/settings.json}
SERVICES_CONF=${PLUMOS_NETWORK_SERVICES_CONF:-/mnt/plumos/config/network/services.conf}
ADB_MARKER=${PLUMOS_NETWORK_ADB_MARKER:-/mnt/plumos-user/plumos-enable-adb}
LOG=${PLUMOS_WIFI_LOG:-/state/plumos/logs/usb-wifi.log}
CONTROL=${PLUMOS_NETWORK_CONTROL:-/mnt/plumos/bin/plumos-network-control}
RECOVERY=${PLUMOS_WIFI_RECOVERY:-/mnt/plumos/bin/plumos-wifi-recovery}

log() {
    printf '%s service=usb-wifi %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

adb_requested() {
    [ -f "$ADB_MARKER" ] && return 0
    [ -r "$SERVICES_CONF" ] || return 0
    value=$(sed -n 's/^adb_enabled=//p' "$SERVICES_CONF" 2>/dev/null | tail -n 1)
    case "$value" in
        1|true|on|'') return 0 ;;
        *) return 1 ;;
    esac
}

start_wifi() {
    if adb_requested; then
        [ ! -x "$RECOVERY" ] || \
            PLUMOS_ROOT=/mnt/plumos PLUMOS_SDCARD_ROOT=/mnt/plumos-user \
                "$RECOVERY" stop >>"$LOG" 2>&1 || true
        log 'result=disabled reason=adb-priority'
        return 0
    fi
    [ -s "$CONFIG" ] || {
        log 'result=disabled reason=config-missing'
        return 0
    }
    if [ -r "$SETTINGS" ] &&
        grep -Eq '"wifi_enabled"[[:space:]]*:[[:space:]]*(false|0)' \
            "$SETTINGS" 2>/dev/null; then
        log 'result=disabled reason=saved-off'
        return 0
    fi
    # Match the V90S lifecycle: one sync starts the blocking uevent monitor and
    # schedules the initial bounded recovery. This keeps association and DHCP
    # outside the boot critical path while retaining hotplug after a failed
    # initial attempt.
    if [ -x "$RECOVERY" ]; then
        PLUMOS_ROOT=/mnt/plumos PLUMOS_SDCARD_ROOT=/mnt/plumos-user \
            "$RECOVERY" sync >>"$LOG" 2>&1 || \
            log 'result=failed reason=recovery-sync'
        log 'result=background-started mode=recovery-sync'
        return 0
    fi

    # Compatibility fallback for an older Runtime that predates the shared
    # recovery helper.
    [ -x "$CONTROL" ] || {
        log 'result=failed reason=network-control-missing'
        return 0
    }
    (
        PLUMOS_ROOT=/mnt/plumos PLUMOS_SDCARD_ROOT=/mnt/plumos-user \
            "$CONTROL" --wifi on >>"$LOG" 2>&1
        rc=$?
        log "result=background-complete rc=$rc"
    ) &
    log 'result=background-started mode=legacy-network-control'
}

case "${1:-}" in
    start) start_wifi ;;
    *) printf 'usage: %s start\n' "$0" >&2; exit 2 ;;
esac
