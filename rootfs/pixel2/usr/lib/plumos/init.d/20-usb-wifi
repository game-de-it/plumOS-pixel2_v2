#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=/state/plumos/config/wpa_supplicant.conf
LOG=/state/plumos/logs/usb-wifi.log
PID=/run/plumos/wpa_supplicant.pid

log() {
    printf '%s service=usb-wifi %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

find_interface() {
    for iface in /sys/class/net/wlan* /sys/class/net/wlp*; do
        [ -e "$iface" ] || continue
        basename "$iface"
        return 0
    done
    return 1
}

start_wifi() {
    [ -s "$CONFIG" ] || {
        log 'result=disabled reason=config-missing'
        return 0
    }
    chmod 0600 "$CONFIG"
    for module in r8188eu rtl8xxxu mt7601u rt2800usb ath9k_htc; do
        modprobe "$module" 2>/dev/null || true
    done
    mdev -s 2>/dev/null || true
    iface=$(find_interface) || {
        log 'result=failed reason=interface-missing'
        return 1
    }
    ip link set "$iface" up
    wpa_supplicant -B -P "$PID" -i "$iface" -c "$CONFIG" -f "$LOG"
    udhcpc -b -q -i "$iface" -p "/run/plumos/udhcpc-${iface}.pid" \
        >>"$LOG" 2>&1
    log "result=started interface=$iface"
}

case "${1:-}" in
    start) start_wifi ;;
    *) printf 'usage: %s start\n' "$0" >&2; exit 2 ;;
esac
