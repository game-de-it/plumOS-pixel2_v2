#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

USB_ONLINE="${PLUMOS_USB_HOST_USB_ONLINE:-/sys/class/power_supply/usb/online}"
USB_DEVICES_ROOT="${PLUMOS_USB_HOST_DEVICES_ROOT:-/sys/bus/usb/devices}"
DWC2_DRIVER="${PLUMOS_USB_HOST_DWC2_DRIVER:-/sys/bus/platform/drivers/dwc2}"
PLATFORM_DEVICE="${PLUMOS_USB_HOST_PLATFORM_DEVICE:-/sys/bus/platform/devices/ff300000.usb}"
DEVICE_ID="${PLUMOS_USB_HOST_DEVICE_ID:-ff300000.usb}"
OTG_MODE="${PLUMOS_USB_HOST_OTG_MODE:-/sys/devices/platform/ff2c0000.syscon/ff2c0000.syscon:usb2-phy@100/otg_mode}"
WPA_CONFIG="${PLUMOS_USB_HOST_WPA_CONFIG:-/mnt/plumos/config/wpa_supplicant.conf}"
LOG="${PLUMOS_USB_HOST_LOG:-/state/plumos/logs/usb-host-reenumerate.log}"
RESET_DELAY="${PLUMOS_USB_HOST_RESET_DELAY:-2}"
MODE_SETTLE="${PLUMOS_USB_HOST_MODE_SETTLE:-1}"
ENUMERATION_WAIT="${PLUMOS_USB_HOST_ENUMERATION_WAIT:-3}"
RELEASE_DELAY="${PLUMOS_USB_HOST_RELEASE_DELAY:-5}"
BUSYBOX="${PLUMOS_USB_HOST_BUSYBOX:-/bin/busybox}"
PHY_STATUS_ADDR="${PLUMOS_USB_HOST_PHY_STATUS_ADDR:-0xff2c0120}"
PHY_BVALID_MASK="${PLUMOS_USB_HOST_PHY_BVALID_MASK:-0x200}"
PHY_STATUS_FILE="${PLUMOS_USB_HOST_PHY_STATUS_FILE:-}"

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=usb-host-reenumerate %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

wifi_requested() {
    [ -s "$WPA_CONFIG" ] || return 1
    return 0
}

usb_upstream_online() {
    [ -r "$USB_ONLINE" ] || return 1
    value=$(tr -d '[:space:]' <"$USB_ONLINE" 2>/dev/null || true)
    [ "$value" = 1 ]
}

downstream_present() {
    for device in "$USB_DEVICES_ROOT"/*; do
        [ -r "$device/idVendor" ] || continue
        case "${device##*/}" in usb*) continue ;; esac
        return 0
    done
    return 1
}

current_otg_mode() {
    [ -r "$OTG_MODE" ] || return 1
    tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null
}

phy_bvalid() {
    # PX30/RK3326 exposes the OTG UTMI status at USB2PHY GRF + 0x120;
    # bit 9 is BVALID.  Read it only while the PHY is not forced to host,
    # because host mode's own VBUS source also asserts BVALID.
    if [ -n "$PHY_STATUS_FILE" ]; then
        [ -r "$PHY_STATUS_FILE" ] || return 1
        status=$(tr -d '[:space:]' <"$PHY_STATUS_FILE" 2>/dev/null || true)
    else
        [ -x "$BUSYBOX" ] || return 1
        status=$("$BUSYBOX" devmem "$PHY_STATUS_ADDR" 32 2>/dev/null || true)
    fi
    case "$status" in
        0x*|0X*|[0-9]*) ;;
        *) return 1 ;;
    esac
    [ $((status & PHY_BVALID_MASK)) -ne 0 ]
}

upstream_present() {
    usb_upstream_online && return 0
    mode=$(current_otg_mode 2>/dev/null || true)
    [ "$mode" = host ] && return 1
    phy_bvalid
}

release_wifi_host_mode() {
    [ -r "$OTG_MODE" ] || {
        log "result=warning reason=otg-mode-missing path=$OTG_MODE"
        return 1
    }
    mode=$(tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null || true)
    if [ "$mode" = otg ]; then
        log 'stage=otg-mode-ready source=sysfs'
        return 0
    fi
    [ -w "$OTG_MODE" ] || {
        log "result=warning reason=otg-mode-read-only mode=${mode:-unknown} path=$OTG_MODE"
        return 1
    }
    if ! printf 'otg\n' >"$OTG_MODE"; then
        log "result=warning reason=otg-mode-release-failed mode=${mode:-unknown} path=$OTG_MODE"
        return 0
    fi
    mode=$(tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null || true)
    if [ "$mode" != otg ]; then
        log "result=warning reason=otg-mode-release-verify-failed mode=${mode:-unknown}"
        return 0
    fi
    log 'stage=otg-mode-released source=sysfs'
    sleep "$MODE_SETTLE"
}

force_wifi_host_mode() {
    [ -r "$OTG_MODE" ] || {
        log "result=warning reason=otg-mode-missing path=$OTG_MODE"
        return 0
    }
    mode=$(tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null || true)
    if [ "$mode" = host ]; then
        log 'stage=host-mode-ready source=sysfs'
        return 0
    fi
    [ -w "$OTG_MODE" ] || {
        log "result=warning reason=otg-mode-read-only mode=${mode:-unknown} path=$OTG_MODE"
        return 0
    }
    if ! printf 'host\n' >"$OTG_MODE"; then
        log "result=warning reason=otg-mode-write-failed mode=${mode:-unknown} path=$OTG_MODE"
        return 1
    fi
    mode=$(tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null || true)
    if [ "$mode" != host ]; then
        log "result=warning reason=otg-mode-verify-failed mode=${mode:-unknown}"
        return 1
    fi
    log 'stage=host-mode-forced source=sysfs'
    sleep "$MODE_SETTLE"
}

worker() {
    require_saved_wifi="${1:-yes}"
    if [ "$require_saved_wifi" = yes ] && ! wifi_requested; then
        release_wifi_host_mode
        log 'result=skipped reason=wifi-not-requested'
        return 0
    fi
    [ -r "$USB_ONLINE" ] || {
        release_wifi_host_mode
        log "result=skipped reason=usb-upstream-signal-missing path=$USB_ONLINE"
        return 0
    }
    if downstream_present; then
        force_wifi_host_mode || true
        log 'result=skipped reason=downstream-already-enumerated'
        return 0
    fi
    if upstream_present; then
        release_wifi_host_mode
        log 'result=skipped reason=usb-upstream-online'
        return 0
    fi
    # Pixel2 keeps the stock DTB's dr_mode=otg, but this project dedicates the
    # single connector to USB-host Wi-Fi.  A controller rebind while the PHY is
    # still in OTG mode can miss a dongle that remained inserted across boot.
    # Use Rockchip's stock sysfs ABI to force host before probing/rebinding;
    # this changes neither the DTB nor the kernel and is safe to repeat.
    if ! force_wifi_host_mode; then
        release_wifi_host_mode
        log 'result=failed reason=host-mode-unavailable owner=otg'
        return 1
    fi
    [ -d "$PLATFORM_DEVICE" ] || {
        release_wifi_host_mode
        log "result=skipped reason=controller-missing device=$DEVICE_ID"
        return 0
    }
    [ -w "$DWC2_DRIVER/bind" ] || {
        release_wifi_host_mode
        log "result=failed reason=bind-unavailable driver=$DWC2_DRIVER"
        return 1
    }

    if [ -L "$PLATFORM_DEVICE/driver" ]; then
        [ -w "$DWC2_DRIVER/unbind" ] || {
            release_wifi_host_mode
            log "result=failed reason=unbind-unavailable driver=$DWC2_DRIVER"
            return 1
        }
        printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/unbind" || {
            release_wifi_host_mode
            log 'result=failed stage=unbind'
            return 1
        }
        log "stage=unbound device=$DEVICE_ID"
        sleep "$RESET_DELAY"
    fi

    printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/bind" || {
        release_wifi_host_mode
        log 'result=failed stage=bind'
        return 1
    }
    log "stage=bound device=$DEVICE_ID"

    elapsed=0
    while [ "$elapsed" -lt "$ENUMERATION_WAIT" ]; do
        if downstream_present; then
            log "result=reenumerated elapsed=$elapsed"
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    release_wifi_host_mode
    log 'result=reset-complete downstream=absent owner=otg'
}

release_if_idle() {
    if usb_upstream_online; then
        release_wifi_host_mode
        log 'result=released reason=usb-upstream-online'
        return 0
    fi
    if downstream_present; then
        log 'result=skipped reason=downstream-still-present'
        return 0
    fi
    release_wifi_host_mode
    log 'result=released reason=downstream-absent'
}

reconcile_role() {
    if downstream_present; then
        log 'result=reconciled owner=downstream-host'
        return 0
    fi
    if upstream_present; then
        release_wifi_host_mode
        log 'result=reconciled owner=upstream'
        return 0
    fi
    release_if_idle
}

start_release_worker() {
    (
        sleep "$RELEASE_DELAY"
        exec "$0" release-if-idle
    ) </dev/null >>"$LOG" 2>&1 &
    log "result=release-scheduled pid=$! delay=$RELEASE_DELAY"
}

start_worker() {
    # Do not add DWC2 reset time to the boot critical path.  Service 20 starts
    # the Wi-Fi uevent monitor while this worker holds the controller unbound,
    # so the subsequent USB add is observed; its initial recovery is also a
    # fallback if enumeration wins the race.
    "$0" worker </dev/null >>"$LOG" 2>&1 &
    log "result=scheduled pid=$!"
}

case "${1:-}" in
    start|worker)
        if [ "$1" = start ]; then
            start_worker
        else
            worker
        fi
        ;;
    probe)
        worker no
        ;;
    release)
        release_wifi_host_mode
        log 'result=released reason=requested'
        ;;
    release-if-idle)
        release_if_idle
        ;;
    release-later)
        start_release_worker
        ;;
    reconcile)
        reconcile_role
        ;;
    *)
        printf 'usage: %s {start|worker|probe|release|release-if-idle|release-later|reconcile}\n' "$0" >&2
        exit 2
        ;;
esac
