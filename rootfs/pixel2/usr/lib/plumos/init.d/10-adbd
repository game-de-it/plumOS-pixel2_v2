#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root
GADGET="${PLUMOS_ADB_GADGET:-/sys/kernel/config/usb_gadget/plumos_pixel2}"
UDC_CLASS="${PLUMOS_ADB_UDC_CLASS:-/sys/class/udc}"
FFS="${PLUMOS_ADB_FFS:-/dev/usb-ffs/adb}"
PID="${PLUMOS_ADB_PID:-/run/plumos/adbd.pid}"
RECOVERY_PID="${PLUMOS_ADB_RECOVERY_PID:-/run/plumos/adbd-recovery.pid}"
LOG="${PLUMOS_ADB_LOG:-/state/plumos/logs/adbd.log}"
SERIAL_FILE="${PLUMOS_ADB_SERIAL_FILE:-/state/plumos/config/adb-serial}"
PROC_ROOT="${PLUMOS_ADB_PROC_ROOT:-/proc}"
SERVICES_CONF="${PLUMOS_ADB_SERVICES_CONF:-/mnt/plumos/config/network/services.conf}"
OPT_IN_MARKER="${PLUMOS_ADB_OPT_IN_MARKER:-/mnt/plumos-user/plumos-enable-adb}"
RECOVERY_DELAY="${PLUMOS_ADB_RECOVERY_DELAY:-4}"
RECOVERY_WAIT="${PLUMOS_ADB_RECOVERY_WAIT:-6}"

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=adb %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

pid_running() {
    [ -s "$PID" ] || return 1
    pid=$(tr -d '[:space:]' <"$PID" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    cmdline=$(tr '\000' ' ' <"$PROC_ROOT/$pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in *adbd*) return 0 ;; esac
    return 1
}

gadget_bound() {
    [ -r "$GADGET/UDC" ] && [ -n "$(cat "$GADGET/UDC" 2>/dev/null)" ]
}

udc_path() {
    set -- "$UDC_CLASS"/*
    [ -e "$1" ] || return 1
    printf '%s\n' "$1"
}

udc_state() {
    path=$(udc_path 2>/dev/null) || {
        printf 'missing\n'
        return 1
    }
    cat "$path/state" 2>/dev/null || printf 'unknown\n'
}

udc_online() {
    case "$(udc_state 2>/dev/null || true)" in
        configured|suspended) return 0 ;;
        *) return 1 ;;
    esac
}

wait_udc_online() {
    timeout=$1
    elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        udc_online && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    udc_online
}

recovery_running() {
    [ -s "$RECOVERY_PID" ] || return 1
    recovery_pid=$(tr -d '[:space:]' <"$RECOVERY_PID" 2>/dev/null || true)
    case "$recovery_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$recovery_pid" 2>/dev/null
}

stop_recovery() {
    if [ "${PLUMOS_ADBD_RECOVERY_WORKER:-0}" = 1 ]; then
        rm -f "$RECOVERY_PID"
        return 0
    fi
    if recovery_running; then
        recovery_pid=$(cat "$RECOVERY_PID")
        [ "$recovery_pid" = "$$" ] || kill "$recovery_pid" 2>/dev/null || true
    fi
    rm -f "$RECOVERY_PID"
}

adb_enabled_by_policy() {
    [ -f "$OPT_IN_MARKER" ] && return 0
    # Pixel2 has no onboard Wi-Fi, so a fresh or recovered image must retain a
    # maintenance path.  A value written by the frontend always wins; only an
    # absent setting uses the default-on policy.
    [ -r "$SERVICES_CONF" ] || return 0
    value=$(sed -n 's/^adb_enabled=//p' "$SERVICES_CONF" 2>/dev/null | tail -n 1)
    case "$value" in
        1|true|on) return 0 ;;
        0|false|off) return 1 ;;
        '') return 0 ;;
        *) return 1 ;;
    esac
}

stop_adbd() {
    stop_recovery
    if [ -e "$GADGET/UDC" ]; then
        : >"$GADGET/UDC" 2>>"$LOG" || true
    fi
    if pid_running; then
        pid=$(cat "$PID")
        kill "$pid" 2>/dev/null || true
        elapsed=0
        while kill -0 "$pid" 2>/dev/null && [ "$elapsed" -lt 5 ]; do
            sleep 1
            elapsed=$((elapsed + 1))
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID"
    log 'result=stopped'
}

start_adbd() {
    if ! adb_enabled_by_policy; then
        log "result=disabled reason=explicit-user-setting marker=$OPT_IN_MARKER"
        return 0
    fi
    [ -x /usr/sbin/adbd ] || {
        log 'result=failed reason=binary-missing'
        return 1
    }
    if pid_running && gadget_bound; then
        log "result=already-running pid=$(cat "$PID")"
        return 0
    fi
    if pid_running; then
        log 'event=running-unbound action=clean-restart'
        stop_adbd
    fi
    [ -d /sys/kernel/config/usb_gadget ] || \
        mount -t configfs configfs /sys/kernel/config
    for role_file in /sys/class/usb_role/*/role; do
        [ -w "$role_file" ] || continue
        printf 'device\n' >"$role_file" 2>>"$LOG" || true
        log "usb_role path=$role_file value=$(cat "$role_file" 2>/dev/null || true)"
    done
    mdev -s 2>/dev/null || true
    sleep 1
    udc_path=$(udc_path 2>/dev/null) || {
        log 'result=failed reason=udc-missing'
        return 1
    }
    udc=${udc_path##*/}
    log "udc=result-found name=$udc state=$(cat "$udc_path/state" 2>/dev/null || true)"

    mkdir -p "$GADGET/strings/0x409" \
        "$GADGET/configs/c.1/strings/0x409" \
        "$GADGET/functions/ffs.adb" "$FFS"
    printf '0x18d1\n' >"$GADGET/idVendor"
    printf '0x4ee7\n' >"$GADGET/idProduct"
    printf '0x0200\n' >"$GADGET/bcdUSB"
    printf '0x0100\n' >"$GADGET/bcdDevice"
    mkdir -p "${SERIAL_FILE%/*}"
    if [ ! -s "$SERIAL_FILE" ]; then
        serial=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '-' | cut -c1-16)
        printf 'plumos-pixel2-%s\n' "${serial:-unknown}" >"$SERIAL_FILE"
    fi
    serial=$(tr -cd 'A-Za-z0-9._-' <"$SERIAL_FILE" | cut -c1-64)
    printf '%s\n' "${serial:-plumos-pixel2-unknown}" >"$GADGET/strings/0x409/serialnumber"
    printf 'plumOS\n' >"$GADGET/strings/0x409/manufacturer"
    printf 'plumOS Pixel2 ADB\n' >"$GADGET/strings/0x409/product"
    printf 'ADB maintenance\n' >"$GADGET/configs/c.1/strings/0x409/configuration"
    printf '120\n' >"$GADGET/configs/c.1/MaxPower"
    [ -e "$GADGET/configs/c.1/ffs.adb" ] || \
        ln -s "$GADGET/functions/ffs.adb" "$GADGET/configs/c.1/ffs.adb"
    grep -q " $FFS functionfs " /proc/mounts 2>/dev/null || \
        mount -t functionfs adb "$FFS"

    /usr/sbin/adbd >>"$LOG" 2>&1 &
    printf '%s\n' "$!" >"$PID"
    elapsed=0
    while [ "$elapsed" -lt 12 ]; do
        [ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] && break
        kill -0 "$(cat "$PID")" 2>/dev/null || {
            log 'result=failed reason=daemon-exited'
            return 1
        }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    [ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] || {
        log 'result=failed reason=functionfs-timeout'
        return 1
    }
    : >"$GADGET/UDC" 2>>"$LOG" || true
    printf '%s\n' "$udc" >"$GADGET/UDC" || {
        log 'result=failed reason=udc-bind'
        stop_adbd
        return 1
    }
    log "result=started udc=$udc access=default-on-no-explicit-setting"
    [ "${PLUMOS_ADBD_RECOVERY_WORKER:-0}" = 1 ] || schedule_recovery
}

rebind_adbd() {
    udc_path=$(udc_path 2>/dev/null) || return 1
    udc=${udc_path##*/}
    : >"$GADGET/UDC" 2>>"$LOG" || return 1
    sleep 1
    printf '%s\n' "$udc" >"$GADGET/UDC" 2>>"$LOG" || return 1
    wait_udc_online "$RECOVERY_WAIT"
}

schedule_recovery() {
    recovery_running && return 0
    mkdir -p "${RECOVERY_PID%/*}"
    (
        sleep "$RECOVERY_DELAY"
        if adb_enabled_by_policy && pid_running && gadget_bound; then
            state=$(udc_state 2>/dev/null || true)
            case "$state" in
                configured|suspended)
                    log "result=watchdog-healthy state=$state"
                    ;;
                *)
                    log "action=watchdog-recover reason=udc-${state:-unknown}"
                    PLUMOS_ADBD_RECOVERY_WORKER=1 "$0" recover || true
                    ;;
            esac
        fi
        rm -f "$RECOVERY_PID"
    ) </dev/null >>"$LOG" 2>&1 &
    printf '%s\n' "$!" >"$RECOVERY_PID"
}

recover_adbd() {
    if pid_running && gadget_bound; then
        state=$(udc_state 2>/dev/null || true)
        case "$state" in
            configured|suspended)
                log "result=recover-not-needed state=$state"
                return 0
                ;;
            *)
                log "action=rebind reason=udc-${state:-unknown}"
                if rebind_adbd; then
                    log "result=recovered action=rebind state=$(udc_state 2>/dev/null || true)"
                    return 0
                fi
                log "result=rebind-failed state=$(udc_state 2>/dev/null || true) action=clean-restart"
                ;;
        esac
    fi
    if pid_running && [ -e "$GADGET/UDC" ]; then
        udc_path=$(udc_path 2>/dev/null) || return 1
        printf '%s\n' "${udc_path##*/}" >"$GADGET/UDC" && {
            log "result=recovered action=bind udc=${udc_path##*/}"
            return 0
        }
    fi
    log 'action=recover-restart'
    stop_adbd
    start_adbd
}

status_adbd() {
    state=stopped
    bound=0
    gadget_bound && bound=1
    udc_state=unknown
    udc_path=$(udc_path 2>/dev/null || true)
    [ -n "$udc_path" ] && [ -e "$udc_path/state" ] && \
        udc_state=$(cat "$udc_path/state" 2>/dev/null || true)
    if ! adb_enabled_by_policy; then
        state=disabled
    elif pid_running && [ "$bound" -eq 1 ]; then
        case "$udc_state" in
            configured|suspended) state=running ;;
            *) state=waiting_usb ;;
        esac
    fi
    printf 'service=adb\nrunning=%s\ngadget_bound=%s\nudc_state=%s\n' \
        "$(pid_running && echo 1 || echo 0)" "$bound" "$udc_state"
    printf 'state=%s\nopted_in=%s\n' "$state" \
        "$(adb_enabled_by_policy && echo 1 || echo 0)"
}

case "${1:-}" in
    start) start_adbd ;;
    stop) stop_adbd ;;
    restart) stop_adbd; start_adbd ;;
    recover) recover_adbd ;;
    status) status_adbd ;;
    *) printf 'usage: %s {start|stop|restart|recover|status}\n' "$0" >&2; exit 2 ;;
esac
