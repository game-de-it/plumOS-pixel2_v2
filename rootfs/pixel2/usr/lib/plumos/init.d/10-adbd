#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root
GADGET="${PLUMOS_ADB_GADGET:-/sys/kernel/config/usb_gadget/plumos_pixel2}"
FFS="${PLUMOS_ADB_FFS:-/dev/usb-ffs/adb}"
PID="${PLUMOS_ADB_PID:-/run/plumos/adbd.pid}"
LOG="${PLUMOS_ADB_LOG:-/state/plumos/logs/adbd.log}"
SERIAL_FILE="${PLUMOS_ADB_SERIAL_FILE:-/state/plumos/config/adb-serial}"
DWC2_DRIVER="${PLUMOS_ADB_DWC2_DRIVER:-/sys/bus/platform/drivers/dwc2}"
PLATFORM_DEVICE="${PLUMOS_ADB_PLATFORM_DEVICE:-/sys/bus/platform/devices/ff300000.usb}"
DEVICE_ID="${PLUMOS_ADB_PLATFORM_DEVICE_ID:-ff300000.usb}"
UDC_ROOT="${PLUMOS_ADB_UDC_ROOT:-/sys/class/udc}"
DWC2_RESET_DELAY="${PLUMOS_ADB_DWC2_RESET_DELAY:-1}"
DWC2_UDC_WAIT="${PLUMOS_ADB_DWC2_UDC_WAIT:-4}"

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=adb %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

pid_running() {
    [ -s "$PID" ] || return 1
    pid=$(cat "$PID" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    cmdline=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in *adbd*) return 0 ;; esac
    return 1
}

endpoints_open() {
    pid_running || return 1
    ep0=0
    ep1=0
    ep2=0
    for fd in /proc/"$pid"/fd/*; do
        target=$(readlink "$fd" 2>/dev/null || true)
        case "$target" in
            "$FFS/ep0") ep0=1 ;;
            "$FFS/ep1") ep1=1 ;;
            "$FFS/ep2") ep2=1 ;;
        esac
    done
    [ "$ep0" -eq 1 ] && [ "$ep1" -eq 1 ] && [ "$ep2" -eq 1 ]
}

udc_name() {
    set -- "$UDC_ROOT"/*
    [ -e "$1" ] || return 1
    printf '%s\n' "${1##*/}"
}

reset_dwc2_for_device() {
    [ -d "$PLATFORM_DEVICE" ] || {
        log "result=controller-reset-failed reason=device-missing device=$DEVICE_ID"
        return 1
    }
    [ -w "$DWC2_DRIVER/bind" ] || {
        log "result=controller-reset-failed reason=bind-unavailable driver=$DWC2_DRIVER"
        return 1
    }

    if [ -L "$PLATFORM_DEVICE/driver" ]; then
        [ -w "$DWC2_DRIVER/unbind" ] || {
            log "result=controller-reset-failed reason=unbind-unavailable driver=$DWC2_DRIVER"
            return 1
        }
        printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/unbind" || {
            log 'result=controller-reset-failed stage=unbind'
            return 1
        }
        log "controller-reset stage=unbound device=$DEVICE_ID"
        sleep "$DWC2_RESET_DELAY"
    fi

    printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/bind" || {
        log 'result=controller-reset-failed stage=bind'
        return 1
    }
    log "controller-reset stage=bound device=$DEVICE_ID"

    elapsed=0
    while [ "$elapsed" -lt "$DWC2_UDC_WAIT" ]; do
        set -- "$UDC_ROOT"/*
        [ -e "$1" ] && {
            log "result=controller-reset-complete udc=${1##*/} elapsed=$elapsed"
            return 0
        }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    log 'result=controller-reset-failed reason=udc-missing-after-bind'
    return 1
}

stop_adbd() {
    if [ -e "$GADGET/UDC" ]; then
        : >"$GADGET/UDC" 2>>"$LOG" || true
    fi
    if pid_running; then
        pid=$(cat "$PID")
        kill "$pid" 2>/dev/null || true
        elapsed=0
        while kill -0 "$pid" 2>/dev/null && [ "$elapsed" -lt 5 ]; do
            sleep 1
            elapsed=$((elapsed + 1))
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID"
    log 'result=stopped'
}

status_adbd() {
    if ! pid_running; then
        printf '%s\n' 'state=stopped'
        printf '%s\n' 'summary=ADB daemon is not running'
        return 2
    fi
    if ! endpoints_open; then
        printf '%s\n' 'state=stopped'
        printf '%s\n' 'summary=ADB daemon lost its FunctionFS endpoints'
        return 2
    fi

    udc_state=not-attached
    for state_file in "$UDC_ROOT"/*/state; do
        [ -r "$state_file" ] || continue
        udc_state=$(cat "$state_file" 2>/dev/null || printf '%s\n' unknown)
        break
    done
    case "$udc_state" in
        configured)
            printf '%s\n' 'state=running'
            printf '%s\n' 'summary=ADB connected over USB'
            ;;
        *)
            printf '%s\n' 'state=waiting_usb'
            printf '%s\n' 'summary=ADB enabled; waiting for USB host'
            ;;
    esac
}

start_adbd() {
    [ -x /usr/sbin/adbd ] || {
        log 'result=failed reason=binary-missing'
        return 1
    }
    if pid_running; then
        log "result=already-running pid=$(cat "$PID")"
        return 0
    fi
    [ -d /sys/kernel/config/usb_gadget ] || \
        mount -t configfs configfs /sys/kernel/config
    for role_file in /sys/class/usb_role/*/role; do
        [ -w "$role_file" ] || continue
        printf 'device\n' >"$role_file" 2>>"$LOG" || true
        log "usb_role path=$role_file value=$(cat "$role_file" 2>/dev/null || true)"
    done
    mdev -s 2>/dev/null || true
    sleep 1
    set -- "$UDC_ROOT"/*
    [ -e "$1" ] || {
        log 'result=failed reason=udc-missing'
        return 1
    }
    udc=${1##*/}
    log "udc=result-found name=$udc state=$(cat "$1/state" 2>/dev/null || true)"

    mkdir -p "$GADGET/strings/0x409" \
        "$GADGET/configs/c.1/strings/0x409" \
        "$GADGET/functions/ffs.adb" "$FFS"
    printf '0x18d1\n' >"$GADGET/idVendor"
    printf '0x4ee7\n' >"$GADGET/idProduct"
    printf '0x0200\n' >"$GADGET/bcdUSB"
    printf '0x0100\n' >"$GADGET/bcdDevice"
    mkdir -p "${SERIAL_FILE%/*}"
    if [ ! -s "$SERIAL_FILE" ]; then
        serial=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '-' | cut -c1-16)
        printf 'plumos-pixel2-%s\n' "${serial:-unknown}" >"$SERIAL_FILE"
    fi
    serial=$(tr -cd 'A-Za-z0-9._-' <"$SERIAL_FILE" | cut -c1-64)
    printf '%s\n' "${serial:-plumos-pixel2-unknown}" >"$GADGET/strings/0x409/serialnumber"
    printf 'plumOS\n' >"$GADGET/strings/0x409/manufacturer"
    printf 'plumOS Pixel2 ADB\n' >"$GADGET/strings/0x409/product"
    printf 'ADB maintenance\n' >"$GADGET/configs/c.1/strings/0x409/configuration"
    printf '120\n' >"$GADGET/configs/c.1/MaxPower"
    [ -e "$GADGET/configs/c.1/ffs.adb" ] || \
        ln -s "$GADGET/functions/ffs.adb" "$GADGET/configs/c.1/ffs.adb"
    grep -q " $FFS functionfs " /proc/mounts 2>/dev/null || \
        mount -t functionfs adb "$FFS"

    /usr/sbin/adbd >>"$LOG" 2>&1 &
    printf '%s\n' "$!" >"$PID"
    elapsed=0
    while [ "$elapsed" -lt 12 ]; do
        [ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] && break
        kill -0 "$(cat "$PID")" 2>/dev/null || {
            log 'result=failed reason=daemon-exited'
            return 1
        }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    [ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] || {
        log 'result=failed reason=functionfs-timeout'
        return 1
    }
    : >"$GADGET/UDC" 2>>"$LOG" || true
    printf '%s\n' "$udc" >"$GADGET/UDC" || {
        log 'result=failed reason=udc-bind'
        stop_adbd
        return 1
    }
    log "result=started udc=$udc auth=disabled-development"
}

restart_adbd() {
    stop_adbd
    # Restart is only invoked by an explicit USB mode change or resume path.
    # It is not a transport watchdog. Reclaim the dual-role controller once,
    # then leave normal host enumeration and cable replug entirely alone.
    reset_dwc2_for_device || return $?
    start_adbd
}

case "${1:-}" in
    start) start_adbd ;;
    stop) stop_adbd ;;
    restart) restart_adbd ;;
    reset-controller) reset_dwc2_for_device ;;
    status) status_adbd ;;
    *) printf 'usage: %s {start|stop|restart|reset-controller|status}\n' "$0" >&2; exit 2 ;;
esac
