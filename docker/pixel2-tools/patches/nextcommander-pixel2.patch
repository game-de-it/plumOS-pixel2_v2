+#ifdef PLUMOS_PIXEL2
+void Screen::nativeFlip()
+{
+    auto *native = static_cast<plumos_fbdev_renderer *>(native_renderer);
+    if (native == nullptr || surface == nullptr || native->mem == nullptr) {
+        return;
+    }
+    const auto *source = static_cast<const std::uint32_t *>(surface->pixels);
+    const int stride = surface->pitch / 4;
+    for (int y = 0; y < surface->h; y++) {
+        for (int x = 0; x < surface->w; x++) {
+            const std::uint32_t pixel = source[y * stride + x];
+            plumos_fbdev_put_pixel(native, x, y,
+                plumos_fbdev_pack_color(native,
+                    static_cast<std::uint8_t>((pixel >> 16) & 0xff),
+                    static_cast<std::uint8_t>((pixel >> 8) & 0xff),
+                    static_cast<std::uint8_t>(pixel & 0xff)));
+        }
+    }
+    if (plumos_fbdev_present(native)) {
+        static int capture_attempted = 0;
+        const char *capture_path =
+            std::getenv("PLUMOS_NEXTCOMMANDER_SCREENSHOT");
+        if (!capture_attempted && capture_path != nullptr &&
+                capture_path[0] != '\0') {
+            char error[256] = {};
+            capture_attempted = 1;
+            if (plumos_fbdev_write_screenshot_png(
+                    native, capture_path, error, sizeof(error))) {
+                SDL_Log("Pixel2 screenshot saved: %s", capture_path);
+            } else {
+                SDL_Log("Pixel2 screenshot failed: %s", error);
+            }
+        }
+    } else {
+        SDL_Log("Pixel2 DRM page flip failed");
+    }
+}
+
+void Screen::shutdown()
+{
+    auto *native = static_cast<plumos_fbdev_renderer *>(native_renderer);
+    if (native != nullptr) {
+        plumos_fbdev_renderer_shutdown(native);
+        std::free(native);
+        native_renderer = nullptr;
+    }
+    if (surface != nullptr) {
+        SDL_FreeSurface(surface);
+        surface = nullptr;
+    }
+}
+#endif
+
 int Screen::onResize(int w, int h)
 {
 #ifdef USE_SDL2
+#ifdef PLUMOS_PIXEL2
+    (void)w;
+    (void)h;
+    return 0;
+#else
     this->surface = SDL_GetWindowSurface(this->window);
     setPhysicalResolution(surface->w, surface->h);
+#endif
 #else
 #ifndef MIYOOMINI
     this->surface = SDL_GetVideoSurface();
