+static u16 VIDOGLVdp1ColorRGBA8To16(const u8 *pixel) {
+  u32 color = (u32)pixel[0] | ((u32)pixel[1] << 8) |
+    ((u32)pixel[2] << 16) | ((u32)pixel[3] << 24);
+  if ((color & 0x80000000) == 0) {
+    return 0x0000;
+  }
+  if ((color & 0x40000000) == 0) {
+    return 0x8000 | ((color >> 3) & 0x001F) |
+      ((color >> 6) & 0x03E0) | ((color >> 9) & 0x7C00);
+  }
+  return color & 0x7FFF;
+}
