diff --git a/Makefile b/Makefile
index 2585252..2f3668e 100644
--- a/Makefile
+++ b/Makefile
@@ -349,11 +349,14 @@ else ifneq (,$(findstring arm64_cortex_a53_gles2,$(platform)))
    TARGET := $(TARGET_NAME)_libretro.so
