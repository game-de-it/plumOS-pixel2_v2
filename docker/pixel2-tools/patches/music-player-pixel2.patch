+static void plumos_music_pixel2_set_rotation(
+    struct plumos_fbdev_renderer *renderer, const char *rotation) {
+  plumos_fbdev_renderer_set_rotation(renderer, rotation);
+  if (!renderer) {
+    return;
+  }
+  if (renderer->rotation == 1 || renderer->rotation == 3) {
+    renderer->var.xres = renderer->physical_yres;
+    renderer->var.yres = renderer->physical_xres;
+  } else {
