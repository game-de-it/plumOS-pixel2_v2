+struct music_scan_root {
+  dev_t device;
+  ino_t inode;
+};
+
+static void scan_music_root(struct player_state *state, const char *path,
+                            struct music_scan_root *seen, size_t *seen_count,
+                            size_t seen_capacity) {
+  struct stat st;
+  size_t i;
+  int before = state->track_count;
+  if (stat(path, &st) != 0 || !S_ISDIR(st.st_mode)) {
+    fprintf(stderr, "scan root=%s tracks=0\n", path);
+    return;
+  }
+  for (i = 0; i < *seen_count; i++) {
+    if (seen[i].device == st.st_dev && seen[i].inode == st.st_ino) {
+      fprintf(stderr, "scan root=%s tracks=0 skipped=duplicate\n", path);
+      return;
+    }
+  }
+  if (*seen_count < seen_capacity) {
+    seen[*seen_count].device = st.st_dev;
+    seen[*seen_count].inode = st.st_ino;
+    (*seen_count)++;
+  }
+  scan_dir_recursive(state, path, 0);
+  fprintf(stderr, "scan root=%s tracks=%d\n", path,
+          state->track_count - before);
 }
 
