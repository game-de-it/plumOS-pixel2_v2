-void core_run_audio_callback(void)
+static void *core_audio_callback_thread_main(void *unused)
 {
-	if (audio_callback.callback)
-		audio_callback.callback();
+	(void)unused;
+	while (!__atomic_load_n(&audio_callback_thread_stop, __ATOMIC_ACQUIRE) &&
+	       !should_quit) {
+		retro_audio_callback_t callback = audio_callback.callback;
+		if (!callback)
+			break;
+		callback();
+		/* Avoid a busy loop when a callback temporarily produces no samples. */
+		usleep(1000);
+	}
+	return NULL;
 }
 
-static void core_set_audio_callback(const struct retro_audio_callback *next)
+void core_stop_audio_callback(void)
 {
+	if (audio_callback_thread_running) {
+		__atomic_store_n(&audio_callback_thread_stop, 1, __ATOMIC_RELEASE);
+		pthread_join(audio_callback_thread, NULL);
+		audio_callback_thread_running = false;
+		PA_INFO("Audio callback thread stopped\n");
+	}
 	if (audio_callback.set_state)
 		audio_callback.set_state(false);
+}
+
+int core_start_audio_callback(void)
+{
+	int rc;
+
+	if (!audio_callback.callback || audio_callback_thread_running)
+		return 0;
+	__atomic_store_n(&audio_callback_thread_stop, 0, __ATOMIC_RELEASE);
+	if (audio_callback.set_state)
+		audio_callback.set_state(true);
+	rc = pthread_create(&audio_callback_thread, NULL,
+	                    core_audio_callback_thread_main, NULL);
+	if (rc != 0) {
+		if (audio_callback.set_state)
+			audio_callback.set_state(false);
+		PA_ERROR("Unable to start audio callback thread: %s\n", strerror(rc));
+		return -1;
+	}
+	audio_callback_thread_running = true;
+	PA_INFO("Audio callback thread started\n");
+	return 0;
+}
+
+static void core_set_audio_callback(const struct retro_audio_callback *next)
+{
+	core_stop_audio_callback();
 	memset(&audio_callback, 0, sizeof(audio_callback));
 	if (next)
 		memcpy(&audio_callback, next, sizeof(audio_callback));
-	if (audio_callback.set_state)
-		audio_callback.set_state(true);
 }
 
