--- a/plat_sdl.c
+++ b/plat_sdl.c
@@ -378,0 +379,25 @@ static void plat_sound_finish(void)
+static int plat_sound_input_rate(void)
+{
+	const char *value = getenv("PLUMOS_PICOARCH_AUDIO_TARGET_FPS");
+	char *end = NULL;
+	double target_fps = 0.0;
+	double input_rate;
+
+	if (value && value[0]) {
+		target_fps = strtod(value, &end);
+		if (!end || *end)
+			target_fps = 0.0;
+	}
+	input_rate = sample_rate > 1.0 ? sample_rate : audio.out_sample_rate;
+	if (target_fps > 1.0 && frame_rate > 1.0)
+		input_rate *= target_fps / frame_rate;
+	if (input_rate < 8000.0)
+		input_rate = 8000.0;
+	else if (input_rate > 192000.0)
+		input_rate = 192000.0;
+	PA_INFO("Audio pacing: source=%f core_fps=%f target_fps=%f input=%f output=%d\n",
+	        sample_rate, frame_rate, target_fps, input_rate,
+	        audio.out_sample_rate);
+	return (int)(input_rate + 0.5);
+}
+
@@ -398 +422,0 @@ static int plat_sound_init(void)
-	audio.in_sample_rate = sample_rate;
@@ -399,0 +424 @@ static int plat_sound_init(void)
+	audio.in_sample_rate = plat_sound_input_rate();
@@ -539 +564 @@ int plat_reinit(void)
-	audio.in_sample_rate = sample_rate;
+	audio.in_sample_rate = plat_sound_input_rate();
