+static int64_t frame_deadline_ns;
+
+static int64_t monotonic_ns(void)
+{
+	struct timespec now;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+		return 0;
+	return (int64_t)now.tv_sec * INT64_C(1000000000) + now.tv_nsec;
+}
+
+static void pace_frame(void)
+{
+	struct timespec deadline;
+	int64_t interval_ns;
+	int64_t now_ns;
+	int rc;
+
+	if (!limit_frames || frame_rate <= 1.0) {
+		frame_deadline_ns = 0;
+		return;
+	}
+
+	interval_ns = (int64_t)(1000000000.0 / frame_rate + 0.5);
+	now_ns = monotonic_ns();
+	if (now_ns <= 0 || interval_ns <= 0)
+		return;
+
+	if (frame_deadline_ns == 0 ||
+	    now_ns - frame_deadline_ns > interval_ns * 4 ||
+	    frame_deadline_ns - now_ns > interval_ns * 4)
+		frame_deadline_ns = now_ns + interval_ns;
+	else
+		frame_deadline_ns += interval_ns;
+
+	if (frame_deadline_ns <= now_ns)
+		return;
+	deadline.tv_sec = frame_deadline_ns / INT64_C(1000000000);
+	deadline.tv_nsec = frame_deadline_ns % INT64_C(1000000000);
+	do {
+		rc = clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME,
+		                     &deadline, NULL);
+	} while (rc == EINTR);
+}
+
