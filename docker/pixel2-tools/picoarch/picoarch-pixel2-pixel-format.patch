 static SDL_Surface* clean_screen = NULL;
 static const void* framebuffer; // NOTE: we don't own this
+static uint16_t *converted_frame;
+static size_t converted_frame_pixels;
+static int rgb565_byteswap = -1;
+
+static const void *prepare_rgb565_frame(const void *data, unsigned width,
+                                        unsigned height, size_t pitch,
+                                        size_t *output_pitch)
+{
+	size_t pixel_count;
+	unsigned y;
+
+	if (!data || !width || !height || !output_pitch)
+		return NULL;
+	if (core_pixel_format == RETRO_PIXEL_FORMAT_RGB565 &&
+	    rgb565_byteswap < 0) {
+		const char *value = getenv("PLUMOS_PICOARCH_RGB565_BYTESWAP");
+		rgb565_byteswap = value && value[0] == '1' && value[1] == '\0';
+		PA_INFO("RGB565 byte swap: %s\n",
+		        rgb565_byteswap ? "enabled" : "disabled");
+	}
+	if (core_pixel_format == RETRO_PIXEL_FORMAT_RGB565 &&
+	    !rgb565_byteswap) {
+		*output_pitch = pitch;
+		return data;
+	}
+
+	pixel_count = (size_t)width * height;
+	if (pixel_count > converted_frame_pixels) {
+		uint16_t *new_frame = realloc(converted_frame,
+		                                  pixel_count * sizeof(*converted_frame));
+		if (!new_frame) {
+			PA_ERROR("Unable to allocate RGB565 conversion buffer\n");
+			return NULL;
+		}
+		converted_frame = new_frame;
+		converted_frame_pixels = pixel_count;
+	}
+
+	for (y = 0; y < height; y++) {
+		uint16_t *dst = converted_frame + (size_t)y * width;
+		unsigned x;
+
+		if (core_pixel_format == RETRO_PIXEL_FORMAT_RGB565) {
+			const uint16_t *src = (const uint16_t *)((const uint8_t *)data +
+			                                                (size_t)y * pitch);
+			for (x = 0; x < width; x++) {
+				uint16_t pixel = src[x];
+				dst[x] = (uint16_t)((pixel << 8) | (pixel >> 8));
+			}
+		} else if (core_pixel_format == RETRO_PIXEL_FORMAT_XRGB8888) {
+			const uint32_t *src = (const uint32_t *)((const uint8_t *)data +
+			                                                (size_t)y * pitch);
+			for (x = 0; x < width; x++) {
+				uint32_t pixel = src[x];
+				dst[x] = (uint16_t)(((pixel & 0x00f80000) >> 8) |
+				                    ((pixel & 0x0000fc00) >> 5) |
+				                    ((pixel & 0x000000f8) >> 3));
+			}
+		} else {
+			const uint16_t *src = (const uint16_t *)((const uint8_t *)data +
+			                                                (size_t)y * pitch);
+			for (x = 0; x < width; x++) {
+				uint16_t pixel = src[x];
+				uint16_t green = (pixel >> 5) & 0x1f;
+				dst[x] = (uint16_t)(((pixel & 0x7c00) << 1) |
+				                    (((green << 1) | (green >> 4)) << 5) |
+				                    (pixel & 0x001f));
+			}
+		}
+	}
+
+	*output_pitch = (size_t)width * sizeof(*converted_frame);
+	return converted_frame;
+}
